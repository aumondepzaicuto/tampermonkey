      color: #c8eeff;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      line-height: 1;
      flex: 1;
    }

    #__stpanel__ .panel-minimize {
      width: 18px;
      height: 18px;
      border: none;
      background: rgba(255,255,255,0.06);
      border-radius: 4px;
      color: #5599aa;
      font-size: 11px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      flex-shrink: 0;
      line-height: 1;
    }
    #__stpanel__ .panel-minimize:hover { background: rgba(255,255,255,0.14); color: #aadeee; }

    #__stpanel__ .panel-body {
      padding: 12px 14px 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.3s ease;
      overflow: hidden;
      max-height: 200px;
    }
    #__stpanel__ .panel-body.collapsed {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
    }

    /* Status indicator */
    #__stpanel__ .status-row {
      display: flex;
      align-items: center;
      gap: 7px;
    }
    #__stpanel__ .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #2a3a4a;
      box-shadow: none;
      transition: background 0.3s, box-shadow 0.3s;
      flex-shrink: 0;
    }
    #__stpanel__ .status-dot.on {
      background: #00ffaa;
      box-shadow: 0 0 8px #00ffaa, 0 0 16px rgba(0,255,170,0.4);
      animation: __pulse_dot__ 1.4s ease-in-out infinite;
    }
    @keyframes __pulse_dot__ {
      0%,100% { box-shadow: 0 0 6px #00ffaa, 0 0 12px rgba(0,255,170,0.3); }
      50%      { box-shadow: 0 0 12px #00ffaa, 0 0 24px rgba(0,255,170,0.6); }
    }
    #__stpanel__ .status-text {
      font-family: 'Share Tech Mono', monospace;
      font-size: 11px;
      color: #4a6a7a;
      letter-spacing: 0.5px;
      transition: color 0.3s;
    }
    #__stpanel__ .status-text.on { color: #00ddaa; }

    /* Toggle button */
    #__stpanel__ .toggle-btn {
      position: relative;
      width: 100%;
      padding: 10px 0;
      border: none;
      border-radius: 9px;
      cursor: pointer;
      font-family: 'Rajdhani', sans-serif;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #a0c8d8;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(100,200,255,0.12);
      transition: all 0.25s ease;
      overflow: hidden;
      outline: none;
    }

    #__stpanel__ .toggle-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(0,200,255,0.04), transparent);
      transform: translateX(-100%);
      transition: transform 0.6s ease;
    }
    #__stpanel__ .toggle-btn:hover::before { transform: translateX(100%); }

    #__stpanel__ .toggle-btn:hover {
      border-color: rgba(0,200,255,0.3);
      color: #c0e8f8;
      background: rgba(0,180,255,0.06);
      box-shadow: 0 0 16px rgba(0,180,255,0.1);
    }

    #__stpanel__ .toggle-btn.active {
      background: linear-gradient(135deg, rgba(0,255,140,0.12), rgba(0,180,255,0.08));
      border-color: rgba(0,255,140,0.35);
      color: #00ffaa;
      box-shadow:
        0 0 20px rgba(0,255,140,0.15),
        0 0 0 1px rgba(0,255,140,0.1) inset;
    }
    #__stpanel__ .toggle-btn.active:hover {
      background: linear-gradient(135deg, rgba(255,60,60,0.12), rgba(200,0,0,0.08));
      border-color: rgba(255,80,80,0.35);
      color: #ff6666;
      box-shadow: 0 0 20px rgba(255,80,80,0.15);
    }

    /* Log area */
    #__stpanel__ .log-box {
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 7px;
      padding: 7px 9px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 9.5px;
      color: #3a5a6a;
      min-height: 32px;
      max-height: 48px;
      overflow: hidden;
      line-height: 1.5;
      transition: color 0.3s;
    }
    #__stpanel__ .log-box .log-line {
      opacity: 0;
      transform: translateY(4px);
      animation: __logslide__ 0.3s forwards;
    }
    @keyframes __logslide__ {
      to { opacity: 1; transform: translateY(0); }
    }

    /* corner glow */
    #__stpanel__ .corner-glow {
      position: absolute;
      bottom: -30px;
      right: -30px;
      width: 80px;
      height: 80px;
      background: radial-gradient(circle, rgba(0,180,255,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
  `;
  document.head.appendChild(style);

  /* ─────────────────────────────────────────
     BUILD UI
  ───────────────────────────────────────── */
  const panel = document.createElement('div');
  panel.id = '__stpanel__';
  panel.innerHTML = `
    <div class="panel-inner" style="position:relative;">
      <div class="panel-header" id="__stp_drag__">
        <div class="panel-logo">⚡</div>
        <div class="panel-title">AutoRun</div>
        <button class="panel-minimize" id="__stp_min__">▲</button>
      </div>
      <div class="panel-body" id="__stp_body__">
        <div class="status-row">
          <div class="status-dot" id="__stp_dot__"></div>
          <div class="status-text" id="__stp_stxt__">STANDBY</div>
        </div>
        <button class="toggle-btn" id="__stp_btn__">▶ BẬT</button>
        <div class="log-box" id="__stp_log__">// chưa kích hoạt</div>
      </div>
      <div class="corner-glow"></div>
    </div>
  `;
  document.body.appendChild(panel);

  /* ─────────────────────────────────────────
     REFS
  ───────────────────────────────────────── */
  const btn    = document.getElementById('__stp_btn__');
  const dot    = document.getElementById('__stp_dot__');
  const stxt   = document.getElementById('__stp_stxt__');
  const logBox = document.getElementById('__stp_log__');
  const minBtn = document.getElementById('__stp_min__');
  const body   = document.getElementById('__stp_body__');

  /* ─────────────────────────────────────────
     LOG HELPER
  ───────────────────────────────────────── */
  function log(msg, color) {
    logBox.innerHTML = `<span class="log-line" style="color:${color||'#5a8a9a'}">${msg}</span>`;
  }

  /* ─────────────────────────────────────────
     MINIMIZE TOGGLE
  ───────────────────────────────────────── */
  let minimized = false;
  minBtn.addEventListener('click', () => {
    minimized = !minimized;
    body.classList.toggle('collapsed', minimized);
    minBtn.textContent = minimized ? '▼' : '▲';
  });

  /* ─────────────────────────────────────────
     DRAG
  ───────────────────────────────────────── */
  const dragHandle = document.getElementById('__stp_drag__');
  let isDragging = false, startY = 0, startTop = 0;

  dragHandle.addEventListener('mousedown', e => {
    isDragging = true;
    const rect = panel.getBoundingClientRect();
    startY = e.clientY;
    startTop = rect.top;
    panel.style.animation = 'none';
    panel.style.top = startTop + 'px';
    panel.style.transform = 'none';
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const dy = e.clientY - startY;
    panel.style.top = Math.max(10, Math.min(window.innerHeight - 100, startTop + dy)) + 'px';
  });
  document.addEventListener('mouseup', () => { isDragging = false; });

  /* ─────────────────────────────────────────
     SCRIPT STATE
  ───────────────────────────────────────── */
  let isOn = false;

  function setOn() {
    isOn = true;
    btn.textContent = '■ TẮT';
    btn.classList.add('active');
    dot.classList.add('on');
    stxt.classList.add('on');
    stxt.textContent = 'RUNNING';
    log('// script đang chạy...', '#00ddaa');
  }

  function setOff() {
    isOn = false;
    btn.textContent = '▶ BẬT';
    btn.classList.remove('active');
    dot.classList.remove('on');
    stxt.classList.remove('on');
    stxt.textContent = 'STANDBY';
    stopPopupObserver();
    log('// đã dừng', '#ff6666');
  }

  /* ─────────────────────────────────────────
     MAIN SCRIPT (chạy khi BẬT)
  ───────────────────────────────────────── */
  /* ─────────────────────────────────────────
     XOÁ POPUP #thankyou-popup
  ───────────────────────────────────────── */
  function removePopup() {
    const selectors = ['#thankyou-popup', '.thankyou-popup', '#thankyou-popup-content', '.thankyou-popup-content'];
    selectors.forEach(sel => {
      document.querySelectorAll(sel).forEach(el => el.remove());
    });
    // Khôi phục scroll body nếu bị khoá
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  }

  // Observer: tự động xoá nếu popup được inject sau
  let popupObserver = null;
  function startPopupObserver() {
    popupObserver = new MutationObserver(() => { removePopup(); });
    popupObserver.observe(document.body, { childList: true, subtree: true });
  }
  function stopPopupObserver() {
    if (popupObserver) { popupObserver.disconnect(); popupObserver = null; }
  }

  function runScript() {
    try {
      // ── Xoá popup ngay lập tức ──────────────────────────────────────
      removePopup();
      startPopupObserver();
      log('// popup đã bị xoá ✓', '#00ffaa');

      // ── script gốc của bạn ──────────────────────────────────────────
