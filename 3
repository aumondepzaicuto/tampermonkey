      log('// lỗi: ' + e.message, '#ff4444');
      setOff();
    }
  }

  /* ─────────────────────────────────────────
     BUTTON CLICK
  ───────────────────────────────────────── */
  btn.addEventListener('click', () => {
    if (!isOn) {
      setOn();
      runScript();
    } else {
      setOff();
    }
  });

})();
