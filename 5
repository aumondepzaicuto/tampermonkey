#dxout .c-hl{background:#fffbe6;border-left:3px solid #f59e0b !important;color:#78350f;}
#dxout .c-ul{background:#eff6ff;border-left:3px solid #3b82f6 !important;color:#1e3a8a;}
#dxout .c-bd{background:#f0fdf4;border-left:3px solid #22c55e !important;color:#14532d;font-weight:700;}
#dxout .bg{display:inline-block;font-size:10px;padding:1px 6px;border-radius:4px;margin-left:6px;font-weight:700;color:#fff;}
#dxout .bg-hl{background:#f59e0b;}#dxout .bg-ul{background:#3b82f6;}#dxout .bg-bd{background:#22c55e;}
#dxout .sum{margin-top:7px;padding:5px 10px;background:#f0fdf4;border-radius:6px;font-size:12px;color:#15803d;font-weight:700;border-left:3px solid #22c55e;}
