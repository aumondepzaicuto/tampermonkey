(function () {
'use strict';

/* ============================================================
   STATE
============================================================ */
let questions = [];
let panelVis  = true;
let selFile   = null;
let minimized = false;

/* ============================================================
   SYMBOL MAP (Symbol / Wingdings)
============================================================ */
const SYM_MAP = {
  0xF020:' ',0xF021:'!',0xF022:'\u2200',0xF024:'\u2203',0xF027:'\u220D',
  0xF028:'(',0xF029:')',0xF02A:'\u2217',0xF02B:'+',0xF02C:',',0xF02D:'\u2212',
  0xF02E:'.',0xF02F:'/',0xF030:'0',0xF031:'1',0xF032:'2',0xF033:'3',
  0xF034:'4',0xF035:'5',0xF036:'6',0xF037:'7',0xF038:'8',0xF039:'9',
  0xF03A:':',0xF03B:';',0xF03C:'<',0xF03D:'=',0xF03E:'>',0xF03F:'?',
  0xF040:'\u2245',0xF044:'\u0394',0xF046:'\u03A6',0xF047:'\u0393',0xF050:'\u03A0',
  0xF051:'\u0398',0xF053:'\u03A3',0xF057:'\u03A9',0xF061:'\u03B1',0xF062:'\u03B2',
  0xF063:'\u03C7',0xF064:'\u03B4',0xF065:'\u03B5',0xF066:'\u03C6',0xF067:'\u03B3',
  0xF068:'\u03B7',0xF06C:'\u03BB',0xF06D:'\u03BC',0xF06E:'\u03BD',0xF070:'\u03C0',
  0xF071:'\u03B8',0xF072:'\u03C1',0xF073:'\u03C3',0xF074:'\u03C4',0xF077:'\u03C9',
  0xF0A3:'\u2264',0xF0A5:'\u221E',0xF0AE:'\u2192',0xF0B0:'\u00B0',0xF0B1:'\u00B1',
  0xF0B3:'\u2265',0xF0B4:'\u00D7',0xF0B7:'\u00B7',0xF0B8:'\u00F7',0xF0B9:'\u2260',
  0xF0BB:'\u2248',0xF0C6:'\u21D2',0xF0C7:'\u21D4',0xF0D2:'\u222B',0xF0D4:'\u221A',
  0xF0D5:'\u220F',0xF0D6:'\u2202',0xF0E5:'\u2211',
};

function resolveSym(code, font) {
  if (SYM_MAP[code]) return SYM_MAP[code];
  if (code >= 0xF000 && code <= 0xF0FF) {
    const b = code - 0xF000;
    if (b > 31 && b < 127) return String.fromCharCode(b);
  }
  if (code > 31 && code < 0x10000) return String.fromCharCode(code);
  return '';
}

function decodeEntities(s) {
  if (!s) return '';
  return s
    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"').replace(/&apos;/g, "'")
    .replace(/&#x([0-9A-Fa-f]+);/g, (_, h) => resolveSym(parseInt(h, 16), ''))
    .replace(/&#(\d+);/g, (_, d) => { try { return String.fromCharCode(+d); } catch { return ''; } })
    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
}

function cleanPUA(s) {
  return s.replace(/[\uF000-\uF0FF]/g, c => resolveSym(c.charCodeAt(0), ''));
}

/* ============================================================
   FORMAT DETECTORS (chuan w:highlight / w:shd / w:u / w:b)
   -> dung cho file Word go tay thong thuong
============================================================ */
function isYellow(fill) {
  if (!fill) return false;
  const f = fill.toUpperCase().trim();
  return new Set(['FFED00','FACD5A','FFFF00','FFD700','FFC000','FFCC00',
    'F9C926','FBD95B','FFEC00','FDFD00','FDD835','FBBC04','F7CE45']).has(f);
}
function detHL(r) {
  if (/<w:highlight\b/i.test(r)) {
    if (/<w:highlight\s+w:val="none"/i.test(r)) return false;
    if (/<w:highlight\s+w:val="(?:yellow|darkYellow)"/i.test(r)) return true;
  }
  const m = r.match(/<w:shd[^>]+w:fill="([^"]+)"/i);
  if (m && isYellow(m[1])) return true;
  return false;
}
function detUL(r) {
  if (!/<w:u\b/i.test(r)) return false;
  if (/<w:u\s+w:val="none"/i.test(r)) return false;
  return /<w:u[\s/>]/i.test(r);
}
function detBold(r) {
  const x = r.replace(/<w:bCs[^>]*\/?>/gi, '');
  if (/<w:b\s*\/>/i.test(x)) return true;
  if (/<w:b\s+w:val="(?:0|false)"/i.test(x)) return false;
  if (/<w:b[\s>\/]/i.test(x)) return true;
  return false;
}

/* ============================================================
   VML PICT / FRAME SUPPORT
   File "PDF-converted" (mỗi đoạn = w:framePr toa do tuyet doi,
   khong dung w:highlight chuan) ma vung mau vang duoc gia lap
   bang 1 anh bitmap dan de (v:shape + v:imagedata), nam o mot
   paragraph hoan toan khac vi tri trong XML.
   Chien luoc: match theo (trang, toa do x/y gan nhat, roi tie-break
   bang khoang cach vi tri ky tu trong XML).
============================================================ */

const PT_TO_TWIP = 20;
const COORD_TOL = 70;        // dung sai toa do (twips) khi so khop cung trang
const YELLOW_RATIO_THRESHOLD = 0.30; // % pixel vang de coi la "dai highlight"
const HL_SHAPE_MAX_HEIGHT_PT = 80;   // dai highlight thuong thap (<= ~1 dong)

function extractPageBreakPositions(xml) {
  const positions = [];
  const rx = /<w:br[^>]+w:type="page"/g;
  let m;
  while ((m = rx.exec(xml)) !== null) positions.push(m.index);
  return positions;
}

function pageIndexForOffset(offset, pageBreaks) {
  // tra ve so trang (0-indexed) chua offset, dua tren so page-break truoc do
  let lo = 0, hi = pageBreaks.length;
  while (lo < hi) {
    const mid = (lo + hi) >> 1;
    if (pageBreaks[mid] <= offset) lo = mid + 1; else hi = mid;
  }
  return lo;
}

function extractFrameParas(xml, pageBreaks) {
  // tra ve danh sach {offset, x, y, page} cho moi paragraph co w:framePr
  const out = [];
  const pRx = /<w:p[ >][\s\S]*?<\/w:p>/g;
  let m;
  while ((m = pRx.exec(xml)) !== null) {
    const p = m[0];
    const fp = p.match(/<w:framePr\b[^>]*\/?>/);
    if (!fp) { out.push(null); continue; }
    const tag = fp[0];
    const xm = tag.match(/w:x="(-?\d+)"/);
    const ym = tag.match(/w:y="(-?\d+)"/);
    if (!xm || !ym) { out.push(null); continue; }
    out.push({
      offset: m.index,
      x: parseInt(xm[1], 10),
      y: parseInt(ym[1], 10),
      page: pageIndexForOffset(m.index, pageBreaks),
    });
  }
  return out;
}

function extractVmlShapes(xml, pageBreaks) {
  // tra ve danh sach {offset, x, y, w, h, rid, page} cho moi v:shape ben trong w:pict
  const out = [];
  const pictRx = /<w:pict>[\s\S]*?<\/w:pict>/g;
  let m;
  while ((m = pictRx.exec(xml)) !== null) {
    const block = m[0];
    const styleM = block.match(/<v:shape[^>]+style="([^"]+)"/);
    const ridM = block.match(/<v:imagedata[^>]+r:id="([^"]+)"/);
    if (!styleM || !ridM) continue;
    const style = styleM[1];
    const mlM = style.match(/margin-left:([\d.]+)pt/);
    const mtM = style.match(/margin-top:([\d.]+)pt/);
    const wM  = style.match(/width:([\d.]+)pt/);
    const hM  = style.match(/height:([\d.]+)pt/);
    if (!mlM || !mtM) continue;
    out.push({
      offset: m.index,
      x: Math.round(parseFloat(mlM[1]) * PT_TO_TWIP),
      y: Math.round(parseFloat(mtM[1]) * PT_TO_TWIP),
      wPt: wM ? parseFloat(wM[1]) : 0,
      hPt: hM ? parseFloat(hM[1]) : 0,
      rid: ridM[1],
      page: pageIndexForOffset(m.index, pageBreaks),
    });
  }
  return out;
}

// phan loai 1 anh: tra ve ti le pixel vang (0..1) bang cach ve len canvas tam
function yellowRatioFromDataUrl(dataUrl) {
  return new Promise((resolve) => {
    try {
      const img = new Image();
      img.onload = () => {
        try {
          const w = img.naturalWidth || img.width, h = img.naturalHeight || img.height;
          if (!w || !h) return resolve(0);
          const cv = document.createElement('canvas');
          const SCALE = 24; // ha do phan giai de tinh nhanh
          cv.width = Math.max(1, Math.min(SCALE, w));
          cv.height = Math.max(1, Math.min(SCALE, h));
          const ctx = cv.getContext('2d');
          ctx.drawImage(img, 0, 0, cv.width, cv.height);
          const data = ctx.getImageData(0, 0, cv.width, cv.height).data;
          let yellow = 0, total = 0;
          for (let i = 0; i < data.length; i += 4) {
            const r = data[i], g = data[i+1], b = data[i+2];
            total++;
            if (r > 180 && g > 180 && b < 120) yellow++;
          }
          resolve(total ? yellow / total : 0);
        } catch { resolve(0); }
      };
      img.onerror = () => resolve(0);
      img.src = dataUrl;
    } catch { resolve(0); }
  });
}

// tim frame-paragraph gan nhat (cung trang, trong dung sai toa do), tie-break theo khoang cach offset
function findClosestFrameIdx(shape, frameParas) {
  let best = -1, bestDist = Infinity;
  for (let i = 0; i < frameParas.length; i++) {
    const fp = frameParas[i];
    if (!fp || fp.page !== shape.page) continue;
    const dx = fp.x - shape.x, dy = fp.y - shape.y;
    if (Math.abs(dx) > COORD_TOL * 4 || Math.abs(dy) > COORD_TOL) continue;
    const coordDist = Math.sqrt(dx * dx + dy * dy);
    if (coordDist > COORD_TOL * 3) continue;
    const offsetDist = Math.abs(fp.offset - shape.offset);
    // diem so: uu tien toa do gan, sau do offset gan (offset chia ti le nho de khong lan at toa do)
    const score = coordDist * 1000 + Math.min(offsetDist, 2_000_000) / 1000;
    if (score < bestDist) { bestDist = score; best = i; }
  }
  return best;
}

// tim cau hoi / dap an "phia tren gan nhat theo y, cung trang" de gan anh minh hoa vao
function findAnchorForImage(shape, frameParas, paraMeta) {
  // paraMeta[i] = { qIdx, ansIdx } neu paragraph i la dau cua 1 cau hoi hoac 1 dap an, da duoc build truoc
  let best = -1, bestY = -Infinity;
  for (let i = 0; i < frameParas.length; i++) {
    const fp = frameParas[i];
    if (!fp || fp.page !== shape.page) continue;
    if (!paraMeta[i]) continue;
    if (fp.y <= shape.y + COORD_TOL && fp.y > bestY) { bestY = fp.y; best = i; }
  }
  return best;
}

/* ============================================================
   PARSE PARAGRAPH (text + format chuan, KHONG doi voi VML)
============================================================ */
function parsePara(xml, imgCache) {
  const res = { text: '', isHL: false, isUL: false, isBold: false, images: [], runs: [] };

  let pHL = false, pUL = false, pBold = false;
  const pPr = xml.match(/<w:pPr>([\s\S]*?)<\/w:pPr>/);
  if (pPr) {
    const rpr = pPr[1].match(/<w:rPr>([\s\S]*?)<\/w:rPr>/);
    if (rpr) { if (detHL(rpr[1])) pHL = true; if (detUL(rpr[1])) pUL = true; if (detBold(rpr[1])) pBold = true; }
    const sh = pPr[1].match(/<w:shd[^>]+w:fill="([^"]+)"/i);
    if (sh && isYellow(sh[1])) pHL = true;
  }

  const runRx = /<w:r[ >][\s\S]*?<\/w:r>/g;
  let rm;
  while ((rm = runRx.exec(xml)) !== null) {
    const run = rm[0];
    let rHL = pHL, rUL = pUL, rBold = pBold, font = '';
    const rPr = run.match(/<w:rPr>([\s\S]*?)<\/w:rPr>/);
    if (rPr) {
      if (detHL(rPr[1])) rHL = true;
      if (detUL(rPr[1])) rUL = true;
      if (detBold(rPr[1])) rBold = true;
      const fm = rPr[1].match(/w:ascii="([^"]+)"/i);
      if (fm) font = fm[1].toLowerCase();
    }
    let t = '';
    const tRx = /<w:t[^>]*>([\s\S]*?)<\/w:t>/g; let tm;
    while ((tm = tRx.exec(run)) !== null) t += tm[1];
    const sRx = /<w:sym[^>]+w:char="([^"]+)"(?:[^>]+w:font="([^"]*)")?[^>]*\/?>/g; let sm;
    while ((sm = sRx.exec(run)) !== null) t += resolveSym(parseInt(sm[1], 16), (sm[2] || font).toLowerCase());

    t = cleanPUA(decodeEntities(t));
    if (t) {
      res.runs.push({ text: t, isHL: rHL, isUL: rUL, isBold: rBold });
      res.text += t;
      if (rHL) res.isHL = true;
      if (rUL) res.isUL = true;
      if (rBold) res.isBold = true;
    }
  }
  res.text = res.text.replace(/\s+/g, ' ').trim();

  // anh DrawingML (chuan, hiem gap trong file PDF-converted nhung van ho tro)
  let im;
  const vRx = /<v:imagedata[^>]+r:id="([^"]+)"/g;
  while ((im = vRx.exec(xml)) !== null) if (imgCache[im[1]]) res.images.push({ src: imgCache[im[1]] });
  const bRx = /r:embed="([^"]+)"/g;
  while ((im = bRx.exec(xml)) !== null)
    if (imgCache[im[1]] && !res.images.find(x => x.src === imgCache[im[1]]))
      res.images.push({ src: imgCache[im[1]] });

  return res;
}

/* ============================================================
   PARSE DOCX (text-flow thuong, dung cho file Word go tay)
============================================================ */
function parseParasList(xml, imgCache) {
  const paras = [];
  const offsets = [];
  const pRx = /<w:p[ >][\s\S]*?<\/w:p>/g; let m;
  while ((m = pRx.exec(xml)) !== null) {
    paras.push(parsePara(m[0], imgCache));
    offsets.push(m.index);
  }
  return { paras, offsets };
}

const isQ = t => /^(C[aâ]u|CH)\s*\d+/i.test(t);
const LETTER_RE = /^\s*([a-dA-D])\s*[.):\-]\s*/;

function buildQuestionsFromParas(paras) {
  const qs = [];
  let i = 0;
  while (i < paras.length) {
    if (!isQ(paras[i].text)) { i++; continue; }
    const q = { qText: paras[i].text, qImages: [...paras[i].images], answers: [], _startIdx: i };
    i++;
    const body = [];
    const startBody = i;
    while (i < paras.length && !isQ(paras[i].text)) { body.push(paras[i]); i++; }
    buildAnswers(q, body, startBody);
    q._endIdx = i;
    qs.push(q);
  }
  return qs;
}

function buildAnswers(q, body, startBody) {
  const cnt = body.filter(p => LETTER_RE.test(p.text)).length;
  if (cnt >= 2) buildExplicit(q, body, startBody);
  else buildImplicit(q, body, startBody);
}

function buildExplicit(q, body, startBody) {
  const L = p => { const m = p.text.match(LETTER_RE); return m ? m[1].toUpperCase() : null; };
  let first = body.findIndex(p => L(p)); if (first < 0) first = 0;
  for (let i = 0; i < first; i++) { if (body[i].text) q.qText += ' ' + body[i].text; q.qImages.push(...body[i].images); }
  let cur = null;
  for (let i = first; i < body.length; i++) {
    const p = body[i], lt = L(p);
    if (lt) {
      cur = {
        letter: lt,
        text: p.text.replace(LETTER_RE, '').trim(),
        isHL: p.isHL || p.runs.some(r => r.isHL),
        isUL: p.isUL || p.runs.some(r => r.isUL),
        isBold: p.isBold || p.runs.some(r => r.isBold && r.text.trim()),
        images: [...p.images],
        _paraIdx: startBody + i,
      };
      q.answers.push(cur);
    } else if (cur) {
      if (p.text) cur.text += ' ' + p.text;
      if (p.isHL || p.runs.some(r => r.isHL)) cur.isHL = true;
      if (p.isUL || p.runs.some(r => r.isUL)) cur.isUL = true;
      if (p.isBold || p.runs.some(r => r.isBold && r.text.trim())) cur.isBold = true;
      cur.images.push(...p.images);
    } else { if (p.text) q.qText += ' ' + p.text; q.qImages.push(...p.images); }
  }
}

function buildImplicit(q, body, startBody) {
  const SKIP = /^(V[oớ]i|With|Note|Ghi ch[uú]|Bi[eế]t|Cho r[aằ]ng|H[ìi]nh|Figure)/i;
  const tp = body.filter(p => p.text.trim() || p.images.length);
  const cand = tp.filter(p => p.text.trim() ? !SKIP.test(p.text) : p.images.length > 0);
  tp.filter(p => !cand.includes(p)).forEach(p => { if (p.text) q.qText += ' ' + p.text; q.qImages.push(...p.images); });
  const L = ['A','B','C','D','E','F'];
  cand.forEach((p, i) => {
    const idxInBody = body.indexOf(p);
    q.answers.push({
      letter: L[i] || String(i + 1),
      text: p.text.trim(),
      isHL: p.isHL || p.runs.some(r => r.isHL),
      isUL: p.isUL || p.runs.some(r => r.isUL),
      isBold: p.isBold || p.runs.some(r => r.isBold && r.text.trim()),
      images: p.images,
      _paraIdx: startBody + idxInBody,
    });
  });
}

/* ============================================================
   FRAME-MODE: gan highlight (dai vang VML) + anh minh hoa
   vao dung cau hoi/dap an dua tren toa do trang.
============================================================ */
async function applyFrameModeOverlays(xml, questions, paras, paraOffsets, imgCache, ridYellowCache) {
  const pageBreaks = extractPageBreakPositions(xml);
  const frameParas = extractFrameParas(xml, pageBreaks);
  const shapes = extractVmlShapes(xml, pageBreaks);
  if (!shapes.length) return { hlCount: 0, imgCount: 0 };

  // map paragraph-index -> {qIdx, ansIdx} de biet paragraph nao la "anchor" cua cau hoi/dap an
  const paraMeta = new Array(paras.length).fill(null);
  questions.forEach((q, qi) => {
    if (typeof q._startIdx === 'number') paraMeta[q._startIdx] = { qIdx: qi, ansIdx: -1 };
    q.answers.forEach((a, ai) => { if (typeof a._paraIdx === 'number') paraMeta[a._paraIdx] = { qIdx: qi, ansIdx: ai }; });
  });

  let hlCount = 0, imgCount = 0;

  for (const shape of shapes) {
    const dataUrl = imgCache[shape.rid];
    if (!dataUrl) continue;

    let ratio = ridYellowCache.get(shape.rid);
    if (ratio === undefined) {
      ratio = await yellowRatioFromDataUrl(dataUrl);
      ridYellowCache.set(shape.rid, ratio);
    }

    const isHighlightStripe = ratio >= YELLOW_RATIO_THRESHOLD && shape.hPt <= HL_SHAPE_MAX_HEIGHT_PT;

    if (isHighlightStripe) {
      const idx = findClosestFrameIdx(shape, frameParas);
      if (idx < 0) continue;
      const meta = paraMeta[idx];
      if (!meta) continue;
      if (meta.ansIdx >= 0) {
        questions[meta.qIdx].answers[meta.ansIdx].isHL = true;
        hlCount++;
      } else {
        // highlight roi vao chinh phan dau cau hoi (hiem, nhung van xu ly)
        questions[meta.qIdx]._qHL = true;
      }
    } else {
      // anh minh hoa thuc su -> gan vao cau hoi hoac dap an gan nhat PHIA TREN (theo y)
      const idx = findAnchorForImage(shape, frameParas, paraMeta);
      if (idx < 0) continue;
      const meta = paraMeta[idx];
      if (!meta) continue;
      if (meta.ansIdx >= 0) {
        questions[meta.qIdx].answers[meta.ansIdx].images.push({ src: dataUrl });
      } else {
        questions[meta.qIdx].qImages.push({ src: dataUrl });
      }
      imgCount++;
    }
  }

  return { hlCount, imgCount };
}

