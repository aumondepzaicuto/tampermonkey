</style>`;
document.body.appendChild(panel);

const $ = id => panel.querySelector('#' + id);
const fi = $('dxfi'), pick = $('dxpick'), rdBtn = $('dxrd');
const qIn = $('dxq'), sBtn = $('dxs'), tabBtn = $('dxtab'), stEl = $('dxst');
const out = $('dxout'), hdr = $('dxh'), xBtn = $('dxx'), minBtn = $('dxmin'), lgEl = $('dxlg'), body = $('dxbody');

/* ---- drag ---- */
let drag = false, dX = 0, dY = 0;
hdr.addEventListener('mousedown', e => {
  if (e.target.tagName === 'BUTTON') return;
  drag = true; dX = e.clientX - panel.getBoundingClientRect().left; dY = e.clientY - panel.getBoundingClientRect().top; e.preventDefault();
});
document.addEventListener('mousemove', e => {
  if (!drag) return;
  panel.style.right = 'auto';
  panel.style.left = Math.max(0, Math.min(innerWidth - panel.offsetWidth, e.clientX - dX)) + 'px';
  panel.style.top = Math.max(0, Math.min(innerHeight - 40, e.clientY - dY)) + 'px';
});
document.addEventListener('mouseup', () => drag = false);

/* ---- controls ---- */
document.addEventListener('keydown', e => {
  if (e.code === 'ShiftLeft' && !e.repeat && e.target.tagName !== 'INPUT') {
    panelVis = !panelVis; panel.style.display = panelVis ? 'block' : 'none';
  }
});
xBtn.onclick = () => { panel.style.display = 'none'; panelVis = false; };
minBtn.onclick = () => { minimized = !minimized; body.style.display = minimized ? 'none' : 'block'; minBtn.textContent = minimized ? '+' : '_'; };

/* ---- FILE PICK ---- */
pick.onclick = () => fi.click();
fi.onchange = () => {
  const f = fi.files[0];
  if (!f) return;
  if (!/\.docx$/i.test(f.name)) { setSt('Chi ho tro file .docx!', '#dc2626'); return; }
  selFile = f;
  const nm = f.name.length > 40 ? f.name.slice(0, 37) + '...' : f.name;
  pick.textContent = nm;
  pick.style.color = '#1d4ed8';
  pick.style.borderStyle = 'solid';
  enBtn(rdBtn, '#1d4ed8', '#fff');
  setSt('Da chon file. Nhan "Doc File".', '#16a34a');
};

/* ---- READ ---- */
rdBtn.onclick = async () => {
  if (!selFile) { setSt('Chua chon file!', '#dc2626'); return; }
  setSt('Dang doc file...', '#d97706');
  out.innerHTML = ''; questions = [];
  rdBtn.disabled = true; rdBtn.textContent = '...';
  try {
    if (typeof JSZip === 'undefined') throw new Error('JSZip chua load. Reload trang.');
    const buf = await selFile.arrayBuffer();
    const zip = await JSZip.loadAsync(buf);

    const relsF = zip.file('word/_rels/document.xml.rels');
    const rels = {};
    if (relsF) {
      const rx = await relsF.async('string');
      for (const m of rx.matchAll(/Id="([^"]+)"[^>]+Target="([^"]+)"/g)) rels[m[1]] = m[2];
    }

    const imgCache = {};
    await Promise.all(Object.entries(rels).map(async ([rid, tgt]) => {
      if (!/\.(jpe?g|png|gif|webp|bmp)$/i.test(tgt)) return;
      for (const p of ['word/' + tgt, tgt.replace(/^\.?\//, ''), 'word/media/' + tgt.split('/').pop()]) {
        if (!zip.file(p)) continue;
        try {
          const b64 = await zip.file(p).async('base64');
          const ext = tgt.split('.').pop().toLowerCase();
          const mime = { jpg:'image/jpeg', jpeg:'image/jpeg', png:'image/png', gif:'image/gif', webp:'image/webp', bmp:'image/bmp' }[ext] || 'image/png';
          imgCache[rid] = `data:${mime};base64,${b64}`;
        } catch {}
        break;
      }
    }));

    const docF = zip.file('word/document.xml');
    if (!docF) throw new Error('Khong tim thay document.xml');
    const xml = await docF.async('string');

    setSt('Dang phan tich cau hoi...', '#d97706');
    const { paras, offsets } = parseParasList(xml, imgCache);
    questions = buildQuestionsFromParas(paras);

    // Frame-mode overlay: chi chay neu phat hien w:framePr + v:shape (file kieu PDF-converted)
    const hasFrameMode = /<w:framePr\b/.test(xml) && /<w:pict>/.test(xml);
    let ovStats = { hlCount: 0, imgCount: 0 };
    if (hasFrameMode) {
      setSt('Dang doi chieu vung boi vang & hinh anh (frame-mode)...', '#d97706');
      const ridYellowCache = new Map();
      ovStats = await applyFrameModeOverlays(xml, questions, paras, offsets, imgCache, ridYellowCache);
    }

    const cImg = questions.reduce((n, q) => n + q.qImages.length + q.answers.reduce((m, a) => m + a.images.length, 0), 0);
    setSt(`Da doc: ${questions.length} cau | ${Object.keys(imgCache).length} anh goc | ${ovStats.hlCount} dap an boi vang | ${cImg} anh hien thi`, '#16a34a');
    lgEl.style.display = 'flex';
    qIn.disabled = false; qIn.style.border = '1.5px solid #1d4ed8';
    enBtn(sBtn, '#16a34a', '#fff');
    enBtn(tabBtn, '#7c3aed', '#fff');
    preview();
  } catch (e) {
    setSt('Loi: ' + e.message, '#dc2626'); console.error('[dxa]', e);
  } finally {
    rdBtn.disabled = false; rdBtn.textContent = 'Doc File';
  }
};

/* ---- preview ---- */
function preview() {
  const s = questions.slice(0, 5);
  const c = questions.filter(q => q.answers.some(a => a.isHL || a.isUL || a.isBold)).length;
  out.innerHTML = `<div style="background:#f9fafb;border-radius:8px;padding:10px 12px;border:1.5px solid #e5e7eb;">
    <div style="font-size:10px;color:#9ca3af;margin-bottom:4px;font-weight:700;text-transform:uppercase;">Xem truoc (${questions.length} cau, ${c} co dap an):</div>
    ${s.map(q => `<div style="font-size:12px;color:#374151;padding:3px 0;border-bottom:1px solid #f3f4f6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(q.qText.slice(0, 80))}${q.answers.some(a => a.isHL || a.isUL || a.isBold) ? ' <span style="color:#16a34a;font-weight:700;">[co dap an]</span>' : ''}</div>`).join('')}
    <div style="font-size:11px;color:#9ca3af;margin-top:6px;">Nhap tu khoa va nhan Tim</div></div>`;
}

/* ---- SEARCH ---- */
function search() {
  const kw = qIn.value.trim();
  if (!kw) { setSt('Nhap tu khoa!', '#d97706'); return []; }
  if (!questions.length) { setSt('Chua doc file!', '#dc2626'); return []; }
  const norm = s => (s || '').toLowerCase().normalize('NFC').replace(/\s+/g, ' ').trim();
  const kn = norm(kw), kw2 = kn.split(/\s+/).filter(w => w.length >= 2);
  const score = txt => {
    const t = norm(txt);
    if (t.includes(kn)) return 100;
    if (kw2.length) { const r = kw2.filter(w => t.includes(w)).length / kw2.length; if (r >= 0.5) return Math.round(r * 90); }
    const p = kn.slice(0, Math.min(18, kn.length));
    if (p.length >= 4 && t.includes(p)) return 65;
    return 0;
  };
  return questions.map(q => ({ q, s: score(q.qText) })).filter(x => x.s > 0).sort((a, b) => b.s - a.s).slice(0, 15);
}

sBtn.onclick = () => {
  const res = search();
  if (!res || !res.length) {
    if (qIn.value.trim()) {
      setSt(`Khong tim thay "${qIn.value.trim()}"`, '#dc2626');
      out.innerHTML = `<div style="text-align:center;padding:24px;color:#dc2626;">Khong co ket qua<div style="font-size:11px;color:#6b7280;margin-top:6px;">Thu 4-8 tu dau cau</div></div>`;
    }
    return;
  }
  setSt(`Tim thay ${res.length} ket qua`, '#16a34a');
  out.innerHTML = res.map((x, i) => renderQ(x.q, i, x.s, qIn.value.trim())).join('');
  out.scrollTop = 0;
};
qIn.onkeydown = e => { if (e.key === 'Enter') sBtn.click(); };

/* ---- OPEN IN NEW TAB ---- */
tabBtn.onclick = () => {
  const res = qIn.value.trim() ? search() : questions.map((q) => ({ q, s: 0 }));
  if (!res || !res.length) { setSt('Khong co du lieu de mo', '#dc2626'); return; }
  const html = buildTabHtml(res, qIn.value.trim());
  const w = window.open('', '_blank');
  if (!w) { setSt('Trinh duyet chan popup. Cho phep popup roi thu lai.', '#dc2626'); return; }
  w.document.open(); w.document.write(html); w.document.close();
  setSt(`Da mo ${res.length} cau o tab moi`, '#7c3aed');
};

function buildTabHtml(res, kw) {
  const body = res.map((x, i) => renderQ(x.q, i, x.s, kw)).join('');
  return `<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8">
<title>Ket qua DOCX Reader (${res.length} cau)</title>
<style>
body{font-family:"Segoe UI",Tahoma,Arial,sans-serif;background:#f3f4f6;margin:0;padding:24px;color:#111827;}
.wrap{max-width:860px;margin:0 auto;}
h1{font-size:20px;color:#1e40af;}
.qb{background:#fff;border:1.5px solid #e5e7eb;border-left:4px solid #2563eb;border-radius:10px;padding:14px 18px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,.06);}
.qt{font-size:15px;line-height:1.8;margin-bottom:10px;}
.ar{display:flex;gap:8px;margin:4px 0;padding:7px 12px;border-radius:8px;font-size:15px;line-height:1.7;border-left:3px solid transparent;}
.al{font-weight:700;min-width:24px;}.ac{flex:1;}
.ar img,.iw img{max-width:100%;height:auto;border-radius:4px;border:1px solid #e5e7eb;margin:4px 0;}
.c-hl{background:#fffbe6;border-left:3px solid #f59e0b!important;color:#78350f;}
.c-ul{background:#eff6ff;border-left:3px solid #3b82f6!important;color:#1e3a8a;}
.c-bd{background:#f0fdf4;border-left:3px solid #22c55e!important;color:#14532d;font-weight:700;}
.bg{display:inline-block;font-size:11px;padding:2px 8px;border-radius:5px;margin-left:8px;font-weight:700;color:#fff;}
.bg-hl{background:#f59e0b;}.bg-ul{background:#3b82f6;}.bg-bd{background:#22c55e;}
.sum{margin-top:10px;padding:7px 12px;background:#f0fdf4;border-radius:8px;font-size:14px;color:#15803d;font-weight:700;border-left:3px solid #22c55e;}
mark{background:#fbbf24;color:#111827;border-radius:2px;padding:0 2px;}
</style></head><body><div class="wrap">
<h1>Ket qua: ${res.length} cau ${kw ? '("' + esc(kw) + '")' : ''}</h1>
${body}</div></body></html>`;
}

/* ---- RENDER ---- */
function renderQ(q, i, sc, kw) {
  const col = sc === 100 ? '#16a34a' : sc >= 75 ? '#d97706' : '#6b7280';
  const qImg = q.qImages.map(im => `<div class="iw"><img src="${im.src}" loading="lazy"></div>`).join('');
  const corr = q.answers.filter(a => a.isHL || a.isUL || a.isBold);
  const ans = q.answers.length ? q.answers.map(renderA).join('') : `<div style="color:#9ca3af;font-style:italic;padding:4px;">Khong phan tich duoc dap an</div>`;
  const sum = corr.length ? `<div class="sum">DAP AN DUNG: ${corr.map(a => a.letter).join(', ')}</div>` : '';
  return `<div class="qb">
    <div style="display:flex;justify-content:space-between;margin-bottom:6px;"><span style="font-size:10px;color:#9ca3af;font-weight:700;">#${i + 1}</span>${sc ? `<span style="font-size:10px;color:${col};background:${col}18;padding:1px 7px;border-radius:4px;font-weight:700;">${sc}%</span>` : ''}</div>
    <div class="qt">${hlKw(esc(q.qText), kw)}</div>${qImg}${ans}${sum}</div>`;
}
function renderA(a) {
  let c = '', b = '';
  if (a.isHL) { c = 'c-hl'; b = '<span class="bg bg-hl">BOI VANG - DUNG</span>'; }
  else if (a.isUL) { c = 'c-ul'; b = '<span class="bg bg-ul">GACH CHAN - DUNG</span>'; }
  else if (a.isBold) { c = 'c-bd'; b = '<span class="bg bg-bd">IN DAM - DUNG</span>'; }
  const img = a.images.map(im => `<div class="iw"><img src="${im.src}" loading="lazy"></div>`).join('');
  return `<div class="ar ${c}"><span class="al">${esc(a.letter)}.</span><div class="ac">${esc(a.text)}${b}${img}</div></div>`;
}

/* ---- helpers ---- */
function hlKw(html, kw) {
  if (!kw) return html;
  kw.split(/\s+/).filter(w => w.length >= 2).forEach(w => {
    try { html = html.replace(new RegExp('(' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'), '<mark>$1</mark>'); } catch {}
  });
  return html;
}
function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function setSt(m, c = '#6b7280') { stEl.textContent = m; stEl.style.color = c; }
function enBtn(b, bg, c) { b.disabled = false; b.style.background = bg; b.style.color = c; b.style.cursor = 'pointer'; }

})();
