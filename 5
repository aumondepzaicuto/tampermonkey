    <button id="dxrd" disabled style="padding:9px 14px;background:#e5e7eb;color:#9ca3af;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:not-allowed;white-space:nowrap;">Doc File</button>
  </div>
  <input type="file" id="dxfi" accept=".docx" style="display:none;">

  <div style="font-size:10px;color:#6b7280;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">TIM KIEM CAU HOI</div>
  <div style="display:flex;gap:8px;margin-bottom:8px;">
    <input id="dxq" type="text" placeholder="Nhap tu khoa cau hoi..." disabled style="flex:1;padding:9px 10px;background:#f9fafb;border:1.5px solid #d1d5db;border-radius:8px;font-size:13px;color:#111827;outline:none;font-family:inherit;">
    <button id="dxs" disabled style="padding:9px 16px;background:#e5e7eb;color:#9ca3af;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:not-allowed;">Tim</button>
    <button id="dxtab" disabled title="Mo tat ca trong tab moi" style="padding:9px 12px;background:#e5e7eb;color:#9ca3af;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:not-allowed;white-space:nowrap;">Tab moi</button>
  </div>

