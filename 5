  <div id="dxlg" style="display:none;gap:4px;flex-wrap:wrap;margin:4px 0;">
    <span style="font-size:10px;background:#fffbe6;color:#92400e;padding:2px 8px;border-radius:4px;font-weight:700;border-left:3px solid #f59e0b;">Boi vang = DUNG</span>
    <span style="font-size:10px;background:#eff6ff;color:#1e40af;padding:2px 8px;border-radius:4px;font-weight:700;border-left:3px solid #3b82f6;">Gach chan = DUNG</span>
    <span style="font-size:10px;background:#f0fdf4;color:#15803d;padding:2px 8px;border-radius:4px;font-weight:700;border-left:3px solid #22c55e;">In dam = DUNG</span>
  </div>
  <div id="dxout" style="max-height:440px;overflow-y:auto;margin-top:4px;"></div>
</div>
<style>
#dxout .qb{background:#fff;border:1.5px solid #e5e7eb;border-left:4px solid #2563eb;border-radius:8px;padding:10px 12px;margin-bottom:10px;}
#dxout .qt{font-size:13px;line-height:1.75;color:#111827;margin-bottom:7px;word-break:break-word;}
