                const entry = m[k], name = k.split('/').pop().substring(0, 22);
                const ek = k.replace(/"/g, '&quot;').replace(/'/g, "\\'");
                return `<div class="ocr-img-row-v42">
                    <div style="display:flex;justify-content:space-between;margin-bottom:2px">
                        <span style="color:#555;font-size:7.5px;font-family:'Share Tech Mono',monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:80%">${name}</span>
                        <span style="color:#333;font-size:7px;font-family:'Share Tech Mono',monospace">${entry.count || 1}x</span>
                    </div>
                    <input type="text" class="ocr-img-url-input-v42" value="${entry.url.replace(/"/g,'&quot;')}" placeholder="URL...">
                    <div class="ocr-img-btn-row-v42">
                        <button class="ocr-img-btn-v42" onclick="(function(){var r=this.closest('.ocr-img-row-v42');var i=r.querySelector('.ocr-img-url-input-v42');document.getElementById('ocr-url-box-v42').value=i.value;window._ocrUI.selectedImgKey='${ek}';}).call(this)">Dùng</button>
                        <button class="ocr-img-btn-v42" onclick="(function(){var r=this.closest('.ocr-img-row-v42');var i=r.querySelector('.ocr-img-url-input-v42');var mm=JSON.parse(localStorage.getItem('${IMG_MAP_KEY}')||'{}');if(mm['${ek}']){mm['${ek}'].url=i.value.trim();mm['${ek}'].lastSeen=Date.now();localStorage.setItem('${IMG_MAP_KEY}',JSON.stringify(mm));}}).call(this)">Lưu</button>
                        <button class="ocr-img-btn-del-v42 ocr-img-btn-v42" onclick="(function(){var mm=JSON.parse(localStorage.getItem('${IMG_MAP_KEY}')||'{}');delete mm['${ek}'];localStorage.setItem('${IMG_MAP_KEY}',JSON.stringify(mm));if(window._ocrUI.selectedImgKey==='${ek}')window._ocrUI.selectedImgKey=null;this.closest('.ocr-img-row-v42').remove();}).call(this)">X</button>
                    </div></div>`;
            }).join('') + `<button class="ocr-clr-btn-v42" onclick="localStorage.removeItem('${IMG_MAP_KEY}');window._ocrUI.selectedImgKey=null;document.getElementById('ocr-imglist-v42').innerHTML='<div style=color:#555;font-size:9px;text-align:center;padding:6px>Đã xóa</div>'">XÓA TẤT CẢ</button>`;
        }

        shell.querySelector('#ocr-btn-ocr-v42').onclick = async () => {
            imgListBox.style.display = 'none';
            shell.querySelector('#ocr-cand-box-v42').style.display = 'none';
            cacheBadge.style.display = 'none';
            setStatus('🔄 Bắt đầu AI Scan...', '');
            await runAIScan(setStatus, urlBox);
        };

        shell.querySelector('#ocr-btn-open-v42').onclick = () => {
            let url = urlBox.value.trim();
            if (!url) { setStatus('Nhập URL trước!', 'err'); return; }
            if (!url.startsWith('http')) url = 'https://' + url;
            let saved = false;
            if (window._ocrUI.selectedImgKey) {
                const mm = getImgMap(), key = window._ocrUI.selectedImgKey;
                if (mm[key] && mm[key].url !== url) { mm[key].url = url; mm[key].lastSeen = Date.now(); saveImgMap(mm); if (imgListBox.style.display === 'block') renderImgList(); saved = true; }
            } else if (window._ocrUI.lastScannedImgKey && window._ocrUI.lastScannedImgSrc) {
                const mm = getImgMap(), key = window._ocrUI.lastScannedImgKey;
                if (!mm[key] || mm[key].url !== url) { saveImgURL(window._ocrUI.lastScannedImgSrc, url, 1); window._ocrUI.selectedImgKey = key; saved = true; }
            }
            setStatus(saved ? 'Saved & opened!' : 'Opened!', 'ok');
            addURL(url);
            window.open('https://www.google.com/url?q=' + encodeURIComponent(url), TAB_NAME);
            autoBar.style.display = 'block'; autoBar.textContent = 'Chờ code từ tab phụ...';
        };

        shell.querySelector('#ocr-btn-export-v42').onclick = () => { try { exportData(); setStatus('Đã xuất file', 'ok'); } catch(e) { setStatus('Lỗi: '+e.message, 'err'); } };
        shell.querySelector('#ocr-btn-import-v42').onclick = () => { importFile.value=''; importFile.click(); };
        importFile.onchange = () => {
            const file = importFile.files[0]; if (!file) return;
            setStatus('Đang nhập...', '');
            importData(file, (msg, type) => { setStatus(msg, type); if(imgListBox.style.display==='block') renderImgList(); });
        };

        startCodeListener(setStatus, autoBar);
        startCaptchaWatcher(setStatus, autoBar);
        startCountdownWatcher();

        setTimeout(async () => {
            const ui = window._ocrUI; if (!ui) return;
            for (const img of document.images) {
                const cached = lookupImgURL(img.src);
                if (cached) {
                    ui.urlBox.value = cached;
                    ui.selectedImgKey = normKey(img.src);
                    ui.lastScannedImgKey = normKey(img.src);
                    ui.lastScannedImgSrc = img.src;
                    cacheBadge.style.display = 'block';
                    window.open('https://www.google.com/url?q=' + encodeURIComponent(cached), TAB_NAME);
                    return;
                }
            }
            await runAIScan(setStatus, ui.urlBox);
        }, 2500);
    }

    // ─── CODE LISTENER ────────────────────────────────────────────────────
    function startCodeListener(setStatus, autoBar) {
        localStorage.removeItem(CODE_KEY);
        window.addEventListener('storage', async e => {
            if (e.key !== CODE_KEY || !e.newValue) return;
            const code = e.newValue; localStorage.removeItem(CODE_KEY);
            if (autoBar) { autoBar.style.display='block'; autoBar.textContent=`Code: ${code}`; }
            if (setStatus) setStatus(`Code: ${code}`, 'ok');
            await autoFillCode(code, setStatus, autoBar);
        });
        window.addEventListener('message', e => {
            if (!e.data || e.data.type !== 'OCR_CODE' || !e.data.code) return;
            const code = e.data.code;
            localStorage.setItem(CODE_KEY, code);
            window.dispatchEvent(new StorageEvent('storage', {key:CODE_KEY, newValue:code, storageArea:localStorage}));
        });
    }

    async function autoFillCode(code, setStatus, autoBar) {
        const log = (msg, type) => { if(setStatus)setStatus(msg,type||'ok'); if(autoBar)autoBar.textContent=msg; };
        log('Đang điền mã...');
        const inp = findCodeInput();
        if (!inp) { log('Không tìm thấy ô mã', 'err'); return; }
        const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        setter.call(inp, code);
        ['input','change'].forEach(ev => inp.dispatchEvent(new Event(ev, {bubbles:true})));
        inp.focus(); log(`Đã điền: ${code}`);
        await sleep(1500); log('Click Xác Nhận...');
        const btn1 = findConfirmBtn();
        if (btn1) { simClick(btn1); log('Click OK'); } else log('Không thấy nút xác nhận', 'err');
        await sleep(1200);
        const captchaEl = document.querySelector('iframe[src*="hcaptcha"],iframe[src*="recaptcha"],iframe[src*="challenges.cloudflare.com"],.h-captcha,.g-recaptcha,.cf-turnstile');
        if (!captchaEl) {
            await sleep(2500);
            const errEl = document.querySelector('.link-alert-error,.alert-error,[class*="error"]');
            if (errEl && errEl.offsetParent !== null) {
                const t = (errEl.innerText||errEl.textContent||'').toLowerCase();
                if (t.includes('khong dung')||t.includes('sai')||t.includes('invalid')||t.includes('incorrect')) { log('Mã sai! Kiểm tra lại', 'err'); return; }
            }
            log('Chờ nút Tiếp Tục...');
            const sub = await waitForElement('#submit-button', 15000);
            if (sub) { await sleep(400); simClick(sub); log('Hoàn tất!', 'ok'); if(autoBar)autoBar.style.display='none'; }
            else log('Không thấy #submit-button', 'err');
        } else log('Chờ giải captcha...');
    }

    function waitForElement(selector, timeout=10000) {
        return new Promise(resolve => {
            const check = () => { const el=document.querySelector(selector); if(el&&el.offsetParent!==null) resolve(el); };
            check();
            const obs = new MutationObserver(check);
            obs.observe(document.body, {childList:true, subtree:true, attributes:true});
            setTimeout(() => { obs.disconnect(); resolve(null); }, timeout);
        });
    }
    function findCodeInput() {
        const cands = [...document.querySelectorAll('input[type="text"],input:not([type])')];
        for (const i of cands) { if(i.id==='ocr-url-box-v42')continue; if(i.offsetParent===null)continue; return i; }
        return document.querySelector('input[name="code"]') ||
               document.querySelector('input[placeholder*="ma" i]') ||
               document.querySelector('input[placeholder*="code" i]') || null;
    }
    function findConfirmBtn() {
        const all = [...document.querySelectorAll('button')].filter(b => b.offsetParent!==null && !b.disabled && b.id!=='submit-button');
        const confirm = all.find(b => { const t=(b.innerText||b.textContent||'').toLowerCase().trim(); return t.includes('xac nhan')||t.includes('confirm')||t.includes('submit'); });
        if (confirm) return confirm;
        return all.find(b => b.type==='submit') || all.find(b => b.classList.contains('link-primary-button')) || null;
    }
    function simClick(el) {
        if (!el) return;
        el.scrollIntoView({behavior:'smooth', block:'center'}); el.focus();
        ['pointerdown','mousedown','pointerup','mouseup'].forEach(ev =>
            el.dispatchEvent(new (ev.startsWith('pointer')?PointerEvent:MouseEvent)(ev, {bubbles:true, cancelable:true})));
        el.click();
    }
    function showToast(msg) {
        // Xóa toast cũ nếu có
        document.querySelectorAll('.__ocr_toast__').forEach(t => t.remove());
        const t = document.createElement('div');
        t.__ocr = true;
        t.className = '__ocr_toast__';
        t.textContent = msg;
        t.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#0d0d1a,#12121f);border:1px solid rgba(0,229,255,.3);color:#00e5ff;font-family:"Share Tech Mono",monospace;font-size:12px;padding:12px 24px;border-radius:12px;z-index:9999999;box-shadow:0 4px 32px rgba(0,0,0,.6);white-space:pre-line;text-align:center;line-height:1.7;backdrop-filter:blur(8px);';
        document.body.appendChild(t);
        setTimeout(() => { t.style.transition='opacity .4s'; t.style.opacity='0'; setTimeout(() => t.remove(), 400); }, 3000);
    }

    // ─── [FIX] BALLOON BUTTON FINDER - mạnh hơn, thêm fallback ──────────
    function findBalloonBtn() {
        // Cách 1: Tìm qua querySelectorAll các phần tử clickable chứa img balloon.svg
        const clickables = document.querySelectorAll("button, a, [role='button'], [onclick], [data-click='true'], div, span");
        for (const el of clickables) {
            for (const img of el.querySelectorAll('img')) {
                const src = img.src || img.getAttribute('src') || '';
                if (src.includes('balloon.svg') || src.includes('balloon')) {
                    // Trả về phần tử button/a cha gần nhất
                    let node = img;
                    while (node && node !== document.body) {
                        if (node.tagName === 'BUTTON' || node.tagName === 'A') return node;
                        node = node.parentElement;
                    }
                    return img.closest('button') || img.closest('a') || img.parentElement || img;
                }
            }
            // Kiểm tra background image
            try {
                const bg = window.getComputedStyle(el).backgroundImage || '';
                if (bg.includes('balloon.svg') || bg.includes('balloon')) return el;
            } catch(_) {}
        }
        // Cách 2: Tìm trực tiếp img[src*="balloon"]
        const balloonImg = document.querySelector('img[src*="balloon.svg"], img[src*="balloon"]');
        if (balloonImg) {
            let node = balloonImg.parentElement;
            while (node && node !== document.body) {
                if (node.tagName === 'BUTTON' || node.tagName === 'A' ||
                    node.getAttribute('role') === 'button' ||
                    node.onclick || node.getAttribute('data-click') === 'true') return node;
                node = node.parentElement;
            }
            return balloonImg.parentElement || balloonImg;
        }
        return null;
    }

    function isPinkBtn11(el) {
        if (!el || el.offsetParent===null) return false;
        const text = (el.innerText||el.textContent||''); if (!text.includes('(1/1)')) return false;
        const style = window.getComputedStyle(el); const bg = style.backgroundColor;
        if (bg.includes('244, 63, 143')||bg.includes('244,63,143')) return true;
        const rgb = bg.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
        if (rgb) { const r=parseInt(rgb[1]),g=parseInt(rgb[2]),b=parseInt(rgb[3]); if(r>200&&g<110&&b>70) return true; }
        return false;
    }

    // ─── CLICK ON TARGET SITE ─────────────────────────────────────────────
    async function clickOnTargetSite() {
        // [FIX] Clear window.name ĐÂY - sau khi đã chạy vào flow, không phải ở top-level
        // Điều này ngăn các navigation sau này re-trigger flow
        window.name = '';

        preventThrottling();

        const getPinkBtn11 = () => {
            for (const btn of document.querySelectorAll('button')) { if (isPinkBtn11(btn)) return btn; }
            return null;
        };
        const getCountdownEl = () => {
            const el = document.querySelector('[data-click="true"][data-time]');
            if (el) { const v = parseInt(el.getAttribute('data-time')); if (v > 0 && v < 600) return {el, sec: v}; }
            for (const e of document.querySelectorAll('[data-time]')) {
                const v = parseInt(e.getAttribute('data-time')); if (v > 0 && v < 600) return {el: e, sec: v};
            }
            return null;
        };

        showToast('Trang tải, chờ 4s...');
        await workerSleep(4000);

        // Tìm balloon button với retry
        let b1 = null;
        for (let i = 0; i < 20; i++) {
            b1 = findBalloonBtn();
            if (b1) { console.log('[BALLOON] Tìm thấy sau', i, 'lần thử:', b1); break; }
            await workerSleep(1000);
        }
        if (!b1) { showToast('Không tìm thấy nút balloon!\nKiểm tra trang có balloon.svg không.'); return; }
        showToast('Tìm thấy balloon, click...');
        simClick(b1);

        let b2 = null;
        for (let i = 0; i < 15; i++) {
            await workerSleep(1000);
            b2 = getPinkBtn11();
            if (b2) break;
        }
        if (!b2) { showToast('Nút (1/1) không tìm thấy!'); return; }
        await workerSleep(1500);
        simClick(b2);

        let countdownSec = 0;
        showToast('Đang đọc countdown...');
        for (let attempt = 0; attempt < 60; attempt++) {
            await workerSleep(500);
            const found = getCountdownEl();
            if (found) { countdownSec = found.sec; break; }
        }
        if (!countdownSec) { showToast('Không đọc được data-time!'); return; }

        const endTime = Date.now() + countdownSec * 1000;
        try {
            localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
            if (window.opener && !window.opener.closed) window.opener.localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
        } catch (_) {}

        showToast(`Đếm ngược: ${countdownSec}s`);
        await workerSleep(countdownSec * 1000, remMs => { showToast(`${Math.ceil(remMs / 1000)}s`); });
        showToast('Xong countdown - click nút hồng...');

        let clickedBtn = null, clickCount = 0;
        for (let attempt = 0; attempt < 20; attempt++) {
            const btn = getPinkBtn11();
            if (btn) {
                simClick(btn); clickedBtn = btn; clickCount++;
                if (clickCount === 1) {
                    await workerSleep(600);
                    const btn2 = getPinkBtn11();
                    if (btn2) { simClick(btn2); clickCount++; }
                }
                break;
            }
            await workerSleep(800);
        }

        if (!clickedBtn) { showToast('Không tìm thấy nút hồng (1/1) sau countdown'); return; }
        showToast('Chờ thêm 4s lấy code...');
        await workerSleep(4000);

        let code = null;
        for (let attempt=0; attempt<20; attempt++) {
            await workerSleep(300);
            const divs = document.querySelectorAll('div,span,button,p');
            for (const el of divs) {
                if (el.offsetParent===null) continue;
                const text = (el.textContent||'').trim();
                if (!/^[A-Z0-9]{4,12}$/.test(text)) continue;
                const style = window.getComputedStyle(el), bg = style.backgroundColor;
                let isPink = bg.includes('244, 63, 143') || bg.includes('244,63,143');
                const rgbM = bg.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
                if (rgbM) { const r=parseInt(rgbM[1]),g=parseInt(rgbM[2]),b=parseInt(rgbM[3]); if(r>200&&g<120&&b>70) isPink=true; }
                if (isPink) { code=text; break; }
                const fg = style.color;
                if (fg==='rgb(255, 255, 255)'||fg.includes('255, 255, 255')) {
                    const bgRGB = bg.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
                    if (bgRGB) { const r=parseInt(bgRGB[1]),g=parseInt(bgRGB[2]),b=parseInt(bgRGB[3]); if(r<100&&g<100&&b<100){code=text;break;} }
                }
            }
            if (code) break;
            if (!code && attempt>10) {
                for (const el of document.querySelectorAll('div,span,button,p')) {
                    if (el.offsetParent===null) continue;
                    const text=(el.textContent||'').trim();
                    if (/^[A-Z0-9]{4,12}$/.test(text)){code=text;break;}
                }
            }
        }

        try { localStorage.removeItem(COUNTDOWN_KEY); if(window.opener&&!window.opener.closed) window.opener.localStorage.removeItem(COUNTDOWN_KEY); } catch(_) {}
        if (!code) { showToast('Không tìm thấy code!'); return; }
        if (!/^[A-Z0-9]{4,12}$/.test(code)) { showToast('Code không hợp lệ: '+code); return; }

        try { GM_setClipboard(code); }
        catch { try { await navigator.clipboard.writeText(code); }
        catch { const ta=Object.assign(document.createElement('textarea'),{value:code}); ta.style.cssText='position:fixed;opacity:0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); } }

        if (window.opener && !window.opener.closed) {
            try {
                window.opener.localStorage.setItem(CODE_KEY, code);
                window.opener.dispatchEvent(new window.opener.StorageEvent('storage', {key:CODE_KEY,newValue:code,storageArea:window.opener.localStorage}));
            } catch { window.opener.postMessage({type:'OCR_CODE',code},'*'); }
        } else { localStorage.setItem(CODE_KEY, code); }

        showToast(`CODE: ${code}\nĐã copy & gửi về tab gốc.\nĐóng sau 3s...`);
        await workerSleep(3000);
        window.close();
    }

    // ─── ENTRY POINT ──────────────────────────────────────────────────────
    if (isOnTaplayma) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', createUI);
        else createUI();
    } else if (isOpenedByScript) {
        preventThrottling();
        const runFlow = () => setTimeout(clickOnTargetSite, 3000);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', runFlow);
        else runFlow();
    }

})();
