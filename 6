(function () {
    'use strict';

    // ─── CONFIG ───────────────────────────────────────────────────────────
    const API_KEY         = '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';
    const TARGET_SELECTOR = 'img[data-v-f897f214]';

    const TAB_NAME      = 'ocr_target_v42';
    const IMG_MAP_KEY   = 'ocr_img_map_v42';
    const COUNTDOWN_KEY = 'ocr_countdown_end_v42';
    const CODE_KEY      = 'ocr_pending_code_v42';

    // ─── [FIX] REAL FREE VISION MODELS từ OpenRouter ─────────────────────
    const HARDCODED_FREE_VISION_MODELS = [
        'meta-llama/llama-3.2-11b-vision-instruct:free',
        'qwen/qwen2-vl-7b-instruct:free',
        'google/gemini-flash-1.5:free',
        'google/gemini-2.0-flash-exp:free',
        'moondream/moondream2:free',
        'microsoft/phi-3.5-mini-128k-instruct:free',
    ];

    // ─── [FIX] isForceRunTab: KHÔNG clear window.name ở đây ──────────────
    // window.name phải còn để trang đích nhận ra sau khi google redirect
    // Chỉ clear bên trong clickOnTargetSite() khi đã chạy xong
    const isForceRunTab = (window.name === TAB_NAME);
    if (isForceRunTab) {
        _installForceRun(window);
    }

    // ─── FORCE-RUN ────────────────────────────────────────────────────────
    function _installForceRun(win) {
        try {
            Object.defineProperty(win.document, 'hidden',          { get: () => false,     configurable: true });
            Object.defineProperty(win.document, 'visibilityState', { get: () => 'visible', configurable: true });
            win.document.addEventListener('visibilitychange', e => { e.stopImmediatePropagation(); e.preventDefault(); }, true);
        } catch (_) {}
        const _keepRaf = () => win.requestAnimationFrame(_keepRaf);
        win.requestAnimationFrame(_keepRaf);
        const WORKER_CODE = `var timers={};self.onmessage=function(e){var m=e.data;if(m.cmd==='ST'){var tid=setTimeout(function(){delete timers[m.mid];self.postMessage({mid:m.mid,type:'ST'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='SI'){var tid=setInterval(function(){self.postMessage({mid:m.mid,type:'SI'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='CLR'){if(timers[m.mid]){clearTimeout(timers[m.mid]);clearInterval(timers[m.mid]);delete timers[m.mid];}}};`;
        let _timerWorker = null;
        try { const blob = new Blob([WORKER_CODE], { type: 'application/javascript' }); _timerWorker = new Worker(URL.createObjectURL(blob)); } catch (_) {}
        if (_timerWorker) {
            const _cbMap = new Map(); let _mid = 1;
            _timerWorker.onmessage = function(e) {
                const { mid, type } = e.data; const entry = _cbMap.get(mid); if (!entry) return;
                try { if (typeof entry.fn === 'function') entry.fn(...(entry.args || [])); else { try { eval(entry.fn); } catch(_){} } } catch(_) {}
                if (type === 'ST') _cbMap.delete(mid);
            };
            const _origST = win.setTimeout.bind(win), _origSI = win.setInterval.bind(win), _origCST = win.clearTimeout.bind(win);
            win.setTimeout  = function(fn, delay, ...args) { delay=+delay||0; if(delay<300)return _origST(fn,delay,...args); const mid=_mid++;_cbMap.set(mid,{fn,args});_timerWorker.postMessage({cmd:'ST',mid,delay});return -(mid+900000); };
            win.setInterval = function(fn, delay, ...args) { delay=+delay||4;  if(delay<300)return _origSI(fn,delay,...args); const mid=_mid++;_cbMap.set(mid,{fn,args,repeat:true});_timerWorker.postMessage({cmd:'SI',mid,delay});return -(mid+900000); };
            const _clearShared = id => { if(typeof id==='number'&&id<-900000){const mid=-(id+900000);_cbMap.delete(mid);_timerWorker.postMessage({cmd:'CLR',mid});}else{_origCST(id);}};
            win.clearTimeout = _clearShared; win.clearInterval = _clearShared;
        }
        try {
            const AC = win.AudioContext || win.webkitAudioContext;
            if (AC) { const ac=new AC(),buf=ac.createBuffer(1,1,22050),src=ac.createBufferSource(),g=ac.createGain();g.gain.value=0.00001;src.buffer=buf;src.loop=true;src.connect(g);g.connect(_ac.destination);src.start(0);setInterval(()=>{if(ac.state==='suspended')ac.resume();},1000); }
        } catch(_) {}
    }

    // ─── GOOGLE REDIRECT ──────────────────────────────────────────────────
    const host = location.hostname;
    if (host.includes('google.com') && location.pathname === '/url') {
        const real = new URLSearchParams(location.search).get('q');
        if (real) location.href = real;
        return;
    }

    const isOnTaplayma = host.includes('taplayma.com');

    // ─── [FIX] isOpenedByScript: dùng lại logic gốc đơn giản ─────────────
    // KHÔNG dùng cross-origin hostname check (luôn throw exception → return false)
    // window.opener && !window.opener.closed là đủ để biết tab do script mở
    const isOpenedByScript = isForceRunTab || (() => {
        try { return !isOnTaplayma && !!window.opener && !window.opener.closed; }
        catch(e) { return false; }
    })();

    if (!isOnTaplayma && !isOpenedByScript) return;

    // ─── HELPERS ──────────────────────────────────────────────────────────
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    function workerSleep(ms, onTick) {
        return new Promise(resolve => {
            const code = `var start=Date.now(),dur=${ms};var iv=setInterval(function(){var el=Date.now()-start,rem=Math.max(0,dur-el);self.postMessage({elapsed:el,remaining:rem});if(el>=dur){clearInterval(iv);self.postMessage({done:true});}},200);`;
            const w = new Worker(URL.createObjectURL(new Blob([code], { type: 'application/javascript' })));
            w.onmessage = e => { if (e.data.done) { w.terminate(); resolve(); } else if (onTick) onTick(e.data.remaining); };
        });
    }

    // ─── AUDIO THROTTLE PREVENTION ────────────────────────────────────────
    let _ac = null;
    function preventThrottling() {
        const tryStart = () => {
            try {
                const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
                if (!_ac) { _ac=new AC();const buf=_ac.createBuffer(1,1,22050),src=_ac.createBufferSource(),g=_ac.createGain();g.gain.value=0.00001;src.buffer=buf;src.loop=true;src.connect(g);g.connect(_ac.destination);src.start(0); }
                if (_ac.state === 'suspended') _ac.resume();
            } catch(_) {}
        };
        tryStart();
        ['click','touchstart','keydown'].forEach(ev => document.addEventListener(ev, tryStart, {passive:true}));
        setInterval(() => { if (_ac && _ac.state==='suspended') _ac.resume(); }, 2000);
    }

    // ─── STORAGE ──────────────────────────────────────────────────────────
    const getList  = () => { try { return JSON.parse(localStorage.getItem('url_list') || '[]'); } catch { return []; } };
    const saveList = l  => localStorage.setItem('url_list', JSON.stringify(l));
    function addURL(url) { const l=getList(); if(!l.includes(url)){l.unshift(url);saveList(l);} }

    function getImgMap()   { try { return JSON.parse(localStorage.getItem(IMG_MAP_KEY)||'{}'); } catch { return {}; } }
    function saveImgMap(m) { localStorage.setItem(IMG_MAP_KEY, JSON.stringify(m)); }
    function normKey(src) {
        if (!src) return '';
        try { const u=new URL(src); return (u.origin+u.pathname).toLowerCase(); }
        catch { return src.toLowerCase().replace(/\?.*$/,''); }
    }
    function saveImgURL(imgSrc, url, votes) {
        if (!imgSrc||!url) return;
        const m=getImgMap(), k=normKey(imgSrc); if(!k) return;
        const prev=m[k]||{count:0};
        m[k]={url,votes:votes||1,lastSeen:Date.now(),count:(prev.count||0)+1};
        saveImgMap(m);
    }
    function lookupImgURL(imgSrc) {
        if (!imgSrc) return null;
        const m=getImgMap(), k=normKey(imgSrc);
        return m[k] ? m[k].url : null;
    }

    // ─── EXPORT / IMPORT ──────────────────────────────────────────────────
    function exportData() {
        const payload = {version:'v43.1',exported_at:new Date().toISOString(),url_list:getList(),ocr_img_map:getImgMap()};
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)], {type:'application/json'}));
        a.download = `taplayma_backup_${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(a.href);
    }

    function importData(file, onDone) {
        const r = new FileReader();
        r.onload = e => {
            try {
                const data = JSON.parse(e.target.result);
                let au = 0, ai = 0;
                if(Array.isArray(data.url_list)) {
                    const cur = getList();
                    const merged = [...new Set([...data.url_list,...cur])];
                    saveList(merged);
                    au = data.url_list.filter(u => !cur.includes(u)).length;
                }
                if(data.ocr_img_map && typeof data.ocr_img_map === 'object') {
                    const cur = getImgMap();
                    for(const [k, v] of Object.entries(data.ocr_img_map)) {
                        if(!cur[k] || (v.lastSeen || 0) > (cur[k].lastSeen || 0)) { cur[k] = v; ai++; }
                    }
                    saveImgMap(cur);
                }
                onDone(`+${au} URL, +${ai} ảnh`,'ok');
            } catch(err) { onDone('File lỗi: ' + err.message,'err'); }
        };
        r.readAsText(file);
    }

    // ─── DOM URL SCAN ─────────────────────────────────────────────────────
    const TLD_LIST = ['com','net','org','io','vn','co','app','link','site','me','tv','gg','bet','win','club','live','online','xyz','info','pro','cc','us','uk','id','sg','ph','th','my','top','fun','store','shop','game','nl','de','fr','jp','ru','au','ca','br','in','es','it','pl','se','no','dk','fi','be','at','ch','gr','pt','tr','mx','ar','cl','pe','nz','biz','mobi','asia'];
    const TLD_PAT  = TLD_LIST.join('|');

    function cleanURL(u) {
        if (!u) return '';
        u = u.trim();
        u = u.replace(/[.,;:!?)>"''«»\]`]+$/g, '').trim();
        if (!/^https?:\/\//i.test(u)) u = 'https://' + u;
        u = u.replace(/\.{2,}/g, '.').replace(/\/+$/, '');
        return u;
    }

    function isValidURL(u) {
        if (!u || u.length < 10) return false;
        if (!/^https?:\/\//i.test(u)) return false;
        if (!/https?:\/\/[a-zA-Z0-9\-]{2,}\.[a-zA-Z]{2,}/i.test(u)) return false;
        if (/\.\.\.|localhost|127\.|192\.168\./.test(u)) return false;
        const domain = u.replace(/^https?:\/\//i,'').split('/')[0];
        const parts = domain.split('.');
        if (parts.length < 2 || parts[0].length < 2) return false;
        if (/[^a-zA-Z0-9\-\.]/.test(domain)) return false;
        return TLD_LIST.includes(parts[parts.length - 1].toLowerCase());
    }

    function scanPageMetaURLs() {
        const found = new Set();
        const add = u => { const c = cleanURL(u); if(isValidURL(c) && !c.includes('taplayma') && !c.includes('google.com')) found.add(c); };
        const canonical = document.querySelector('link[rel="canonical"]'); if(canonical?.href) add(canonical.href);
        const ogUrl = document.querySelector('meta[property="og:url"]');   if(ogUrl?.content)  add(ogUrl.content);
        const twUrl = document.querySelector('meta[name="twitter:url"]');  if(twUrl?.content)  add(twUrl.content);
        return [...found];
    }

    function quickScanDOMForURL() {
        const found = new Set();
        for (const u of scanPageMetaURLs()) found.add(u);
        const TLD_RE = new RegExp(`https?:\\/\\/[^\\s<>"']{4,}|www\\.[a-zA-Z0-9\\-]{2,60}\\.(?:${TLD_PAT})(?:\\/[^\\s<>"']*)?`, 'gi');
        for (const el of document.querySelectorAll('cite,a,span,div,p,small,[class*="url"],[class*="link"]')) {
            if (el.offsetParent === null) continue;
            const t = (el.innerText || el.textContent || '').trim();
            if (t.length < 4 || t.length > 300) continue;
            for (const m of t.matchAll(TLD_RE)) {
                const u = cleanURL(m[0].startsWith('http') ? m[0] : 'https://' + m[0]);
                if (isValidURL(u)) found.add(u);
            }
        }
        for (const a of document.querySelectorAll('a[href]')){
            const href = a.href || '';
            if (isValidURL(href) && !href.includes('taplayma') && !href.includes('google.com/url')) found.add(href);
        }
        return [...found];
    }

    function fuzzyMatch(rawUrl) {
        if (!rawUrl) return {url:rawUrl, matched:false, score:0};
        const list = getList(); if(!list.length) return {url:rawUrl, matched:false, score:0};
        const norm = u => u.toLowerCase().replace(/^https?:\/\/(www\.)?/, '').replace(/\/+$/, '');
        const nr = norm(rawUrl);
        for (const s of list) if (norm(s) === nr) return {url:s, matched:true, score:1};
        let best = null, bScore = 0;
        for (const s of list) {
            const ns = norm(s);
            if (ns.includes(nr) || nr.includes(ns)) {
                const sc = Math.min(nr.length, ns.length) / Math.max(nr.length, ns.length);
                if (sc >= 0.65 && sc > bScore) { bScore = sc; best = s; }
            }
        }
        if (best) return {url:best, matched:true, score:bScore};
        return {url:rawUrl, matched:false, score:0};
    }

    function showCandidates(urls) {
        const cb = document.getElementById('ocr-cand-box-v42'); if (!cb) return;
        if (!urls || urls.length <= 1) { cb.style.display = 'none'; return; }
        cb.style.display = 'block';
        cb.innerHTML = urls.slice(0, 6).map(u => `<div class="ocr-cand-v42" title="${u}" onclick="document.getElementById('ocr-url-box-v42').value='${u.replace(/'/g,"\\'")}'">  ${u}</div>`).join('');
    }

    // ─── URL EXTRACTOR TỪ RESPONSE AI ────────────────────────────────────
    function extractURLFromAIText(rawText) {
        if (!rawText) return '';
        let text = rawText.trim();
        const fullUrlRe = /https?:\/\/[a-zA-Z0-9\-._~:/?#[\]@!$&'()*+,;=%]+/gi;
        const fullMatches = text.match(fullUrlRe);
        if (fullMatches) { for (const m of fullMatches) { const c = cleanURL(m); if (isValidURL(c)) return c; } }
        const wwwRe = new RegExp(`www\\.([a-zA-Z0-9\\-]{2,60}\\.(?:${TLD_PAT})(?:\\/[^\\s]*)?)`, 'gi');
        const wwwMatches = text.match(wwwRe);
        if (wwwMatches) { const c = cleanURL(wwwMatches[0]); if (isValidURL(c)) return c; }
        const domainRe = new RegExp(`\\b([a-zA-Z0-9][a-zA-Z0-9\\-]{1,59}\\.(?:${TLD_PAT}))(?:[/\\s"'\`]|$)`, 'gi');
        let dm; const domCandidates = [];
        while ((dm = domainRe.exec(text)) !== null) { const c = cleanURL(dm[1]); if (isValidURL(c)) domCandidates.push(c); }
        if (domCandidates.length > 0) { domCandidates.sort((a, b) => b.length - a.length); return domCandidates[0]; }
        if (text.length < 80 && !text.includes(' ') && text.includes('.')) { const c = cleanURL(text.replace(/^["'`]|["'`]$/g, '')); if (isValidURL(c)) return c; }
        const words = text.split(/[\s\n,;"'`()\[\]]+/);
        for (const w of words) { if (w.includes('.') && w.length > 4) { const c = cleanURL(w); if (isValidURL(c)) return c; } }
        return text;
    }

    // ─── TARGET IMAGE FINDER ──────────────────────────────────────────────
    function findTargetImage() {
        for (const img of document.querySelectorAll(TARGET_SELECTOR)) {
            if (img.src && img.src.startsWith('http') && !img.src.includes('muabit') && !img.src.includes('zpi.cx') && (img.naturalWidth === 0 || img.naturalWidth > 10))
                return img;
        }
        return null;
    }

    function fetchBase64(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method:'GET', url, responseType:'blob', timeout:25000,
                onload: res => {
                    if (res.status < 200 || res.status >= 300) { reject(new Error('HTTP '+res.status)); return; }
                    const reader = new FileReader();
                    reader.onloadend = () => { const dataUrl = reader.result; resolve({base64:dataUrl.split(',')[1], mime:(res.response.type||'image/jpeg').split(';')[0]}); };
                    reader.onerror = () => reject(new Error('FileReader lỗi'));
                    reader.readAsDataURL(res.response);
                },
                onerror:   () => reject(new Error('Không tải được ảnh')),
                ontimeout: () => reject(new Error('Timeout tải ảnh'))
            });
        });
    }

    // ─── [FIX] GET VISION MODELS - lọc đúng, không loại Gemini ──────────
    async function getVisionModels(setStatus) {
        let dynamicModels = [];
        try {
            setStatus('📋 Fetch model list từ OpenRouter...', '#9b59b6');
            dynamicModels = await new Promise((resolve, reject) => {
                GM_xmlhttpRequest({
                    method:'GET',
                    url:'https://openrouter.ai/api/v1/models',
                    headers:{'Authorization':`Bearer ${API_KEY}`, 'Content-Type':'application/json'},
                    timeout:10000,
                    onload: res => {
                        try {
                            const all = JSON.parse(res.responseText).data || [];
                            const models = all.filter(m => {
                                // Chỉ free
                                const isFree = m.id.endsWith(':free') ||
                                    (m.pricing && (m.pricing.prompt === '0' || m.pricing.prompt === 0) &&
                                     (m.pricing.completion === '0' || m.pricing.completion === 0));
                                // Loại CLIP / embed / text-to-image / music - không phải chat vision
                                const notClip = !/clip|embed|text-to-image|t2i|diffusion|stable-diffusion|dall-e|lyria|music|audio/i.test(m.id);
                                // Có image input
                                const inputMods = m.architecture?.input_modalities || [];
                                const hasImageInput = inputMods.includes('image');
                                const hasVisionName = /vision|vl|flash|pixtral|qwen.*vl|llama.*vision|phi.*vision|phi.*multimodal|kimi-vl|ui-tars|moondream|bakllava|llava|minicpm.*v|internvl|gemini/i.test(m.id);
                                return isFree && notClip && (hasImageInput || hasVisionName);
                            }).map(m => m.id);
                            resolve(models);
                        } catch(e) { reject(e); }
                    },
                    onerror:   () => reject(new Error('Network error')),
                    ontimeout: () => reject(new Error('Timeout'))
                });
            });
            console.log('[AI URL] Dynamic models:', dynamicModels.length, dynamicModels);
        } catch(err) {
            console.warn('[AI URL] Không fetch được model list:', err.message);
        }
        // Hardcoded trước (ưu tiên), dynamic bổ sung, không trùng
        const seen = new Set(HARDCODED_FREE_VISION_MODELS);
        const extra = dynamicModels.filter(m => !seen.has(m));
        const merged = [...HARDCODED_FREE_VISION_MODELS, ...extra];
        setStatus(`📋 ${merged.length} model (${extra.length} dynamic + ${HARDCODED_FREE_VISION_MODELS.length} hardcode)`, '#9b59b6');
        return merged;
    }

    // ─── GỌI AI MODEL ─────────────────────────────────────────────────────
    function callAIModel(base64, mime, model) {
        const PROMPT = `Look at this image carefully. Find any website URL, domain name, or web address shown in the image.
Output ONLY the domain or URL with no explanation, no punctuation, no quotes.
Examples of good output: hitclub.si | www.abc88.com | https://xyz.net
If no URL found, output: NONE`;
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method:'POST',
                url:'https://openrouter.ai/api/v1/chat/completions',
                headers:{
                    'Content-Type':'application/json',
                    'Authorization':`Bearer ${API_KEY}`,
                    'HTTP-Referer':'https://tampermonkey.net',
                    'X-Title':'AI URL Scanner v43'
                },
                data: JSON.stringify({
                    model,
                    messages:[{role:'user',content:[
                        {type:'image_url',image_url:{url:`data:${mime};base64,${base64}`,detail:'high'}},
                        {type:'text',text:PROMPT}
                    ]}],
                    max_tokens: 120,
                    temperature: 0,
                    top_p: 1
                }),
                timeout: 45000,
                onload: res => {
                    let data;
                    try { data = JSON.parse(res.responseText); }
                    catch(e) { reject(new Error('JSON parse lỗi: '+res.responseText.substring(0,100))); return; }
                    if (data.error) {
                        const errMsg = typeof data.error === 'object' ? (data.error.message || JSON.stringify(data.error)) : String(data.error);
                        if (errMsg.includes('rate') || errMsg.includes('429') || errMsg.includes('quota')) reject(new Error('RATE_LIMIT: ' + errMsg));
                        else reject(new Error(errMsg));
                        return;
                    }
                    if (res.status < 200 || res.status >= 300) { reject(new Error('HTTP ' + res.status)); return; }
                    const text = data?.choices?.[0]?.message?.content?.trim();
                    if (!text || text.toUpperCase() === 'NONE' || text.length < 2) { reject(new Error('Phản hồi rỗng hoặc NONE')); return; }
                    const extracted = extractURLFromAIText(text);
                    const usedModel = data?.model || model;
                    console.log(`[AI URL][${model.split('/').pop()}] Raw: "${text}" → Extracted: "${extracted}"`);
                    if (!extracted || extracted.length < 4) { reject(new Error('Không extract được URL từ: ' + text.substring(0, 60))); return; }
                    resolve({text: extracted, rawText: text, usedModel});
                },
                onerror:   () => reject(new Error('Mất kết nối')),
                ontimeout: () => reject(new Error('Timeout 45s'))
            });
        });
    }

    async function tryAIModels(base64, mime, models, setStatus) {
        const errors = [];
        for (let i = 0; i < models.length; i++) {
            const model = models[i];
            const shortName = model.split('/').pop().replace(':free','');
            setStatus(`🤖 [${i+1}/${models.length}] ${shortName}`, '#3498db');
            try {
                const result = await callAIModel(base64, mime, model);
                if (result.text && result.text.length > 3 && !result.text.includes('NONE')) return result;
                errors.push(`${shortName}: kết quả không hợp lệ "${result.text}"`);
            } catch(err) {
                const errMsg = err.message || String(err);
                errors.push(`${shortName}: ${errMsg}`);
                console.warn(`[AI URL][SKIP] ${model}: ${errMsg}`);
                if (i < models.length - 1) {
                    setStatus(`⏩ Skip ${shortName} → thử tiếp...`, '#f39c12');
                    await sleep(errMsg.includes('RATE_LIMIT') ? 200 : 300);
                }
            }
        }
        throw new Error(`Đã thử ${models.length} model.\nLỗi cuối: ${errors.slice(-3).join(' | ')}`);
    }

    // ─── XÓA QUẢNG CÁO ───────────────────────────────────────────────────
    function removeAds() {
        try {
            document.querySelectorAll('div[data-v-f897f214].mb-6.text-center').forEach(div => { if (div.querySelector('a[href*="muabit.com"]')) div.remove(); });
            document.querySelectorAll('a[href*="muabit.com"], a[href*="zpi.cx"]').forEach(a => {
                let node = a;
