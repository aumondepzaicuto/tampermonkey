    // ─── MAIN AI SCAN ─────────────────────────────────────────────────────
    async function runAIScan(setStatus, urlBox) {
        if (window._ocrUI) { window._ocrUI.lastScannedImgKey = null; window._ocrUI.lastScannedImgSrc = null; }
        setStatus('🧹 Xóa quảng cáo...', '#f1c40f');
        removeAds();
        await sleep(400);

        const metaURLs = scanPageMetaURLs();
        if (metaURLs.length) {
            urlBox.value = metaURLs[0];
            setStatus('✅ Meta/OG: ' + metaURLs[0], 'ok');
            window.open('https://www.google.com/url?q=' + encodeURIComponent(metaURLs[0]), TAB_NAME);
            showCandidates(metaURLs); return;
        }

        const domURLs = quickScanDOMForURL().filter(u => !u.includes('taplayma') && !u.includes('google.com/url'));
        if (domURLs.length) {
            const m = fuzzyMatch(domURLs[0]);
            urlBox.value = m.url || domURLs[0];
            setStatus('✅ DOM: ' + domURLs.length + ' URL tìm thấy', 'ok');
            window.open('https://www.google.com/url?q=' + encodeURIComponent(m.url || domURLs[0]), TAB_NAME);
            showCandidates(domURLs); return;
        }

        for (const img of document.images) {
            const cached = lookupImgURL(img.src);
            if (cached) {
                const m = fuzzyMatch(cached);
                urlBox.value = m.url || cached;
                if (window._ocrUI) {
                    window._ocrUI.selectedImgKey = normKey(img.src);
                    window._ocrUI.lastScannedImgKey = normKey(img.src);
                    window._ocrUI.lastScannedImgSrc = img.src;
                }
                setStatus('✅ Cache hit!', 'ok');
                window.open('https://www.google.com/url?q=' + encodeURIComponent(m.url || cached), TAB_NAME);
                return;
            }
        }

        setStatus('🔍 Tìm ảnh target...', '#f1c40f');
        await sleep(1000);
        const img = findTargetImage();
        if (!img) { setStatus('❌ Không tìm thấy ảnh target. Thử AI Scan lại!', '#e74c3c'); return; }
        const imgSrc = img.src;
        if (window._ocrUI) { window._ocrUI.lastScannedImgSrc = imgSrc; window._ocrUI.lastScannedImgKey = normKey(imgSrc); }
        console.log('[AI URL] Ảnh target:', imgSrc);

        setStatus('📥 Tải ảnh...', '#f1c40f');
        let imgData;
        try {
            imgData = await fetchBase64(imgSrc);
            setStatus(`📥 Ảnh OK (${imgData.mime})`, '#f1c40f');
        } catch(err) { setStatus('❌ Lỗi tải ảnh: ' + err.message, '#e74c3c'); return; }

        let models;
        try {
            models = await getVisionModels(setStatus);
            await sleep(200);
        } catch(err) {
            models = [...HARDCODED_FREE_VISION_MODELS];
            setStatus(`⚠️ Dùng ${models.length} model hardcode...`, '#f39c12');
        }

        try {
            const { text, rawText, usedModel } = await tryAIModels(imgData.base64, imgData.mime, models, setStatus);
            const isValid = isValidURL(text.startsWith('http') ? text : 'https://'+text);
            let finalURL = isValid ? cleanURL(text) : text;
            const matched = fuzzyMatch(finalURL);
            if (matched.matched) finalURL = matched.url;
            urlBox.value = finalURL;
            if (imgSrc) { saveImgURL(imgSrc, finalURL, 1); if (window._ocrUI) window._ocrUI.selectedImgKey = normKey(imgSrc); }
            const modelShort = usedModel.split('/').pop().replace(':free','');
            const matchInfo = matched.matched ? `Matched ${Math.round(matched.score*100)}%` : `Model: ${modelShort}`;
            setStatus(`${isValid?'✅':'⚠️'} ${matchInfo} → ${finalURL}`, 'ok');
            window.open('https://www.google.com/url?q=' + encodeURIComponent(finalURL), TAB_NAME);
            console.log('[AI URL] Result:', {finalURL, rawText, usedModel, isValid, matched});
        } catch(err) {
            setStatus('❌ AI lỗi: ' + err.message, '#e74c3c');
            console.error('[AI URL] Scan thất bại:', err);
        }
    }

    // ─── COUNTDOWN WATCHER ────────────────────────────────────────────────
    function startCountdownWatcher() {
        let overlayEl = null;
        const getOrCreate = () => {
            if (overlayEl && document.body.contains(overlayEl)) return overlayEl;
            overlayEl = document.createElement('div');
            overlayEl.id = 'ocr-countdown-v42';
            overlayEl.style.cssText = 'position:fixed;bottom:16px;right:16px;background:linear-gradient(135deg,#0d0d12,#13131c);border:1px solid rgba(255,45,120,.4);border-radius:12px;padding:10px 20px;font-family:"Orbitron",monospace;font-size:24px;font-weight:900;color:#ff2d78;z-index:9999998;box-shadow:0 0 30px rgba(255,45,120,.25),inset 0 1px 0 rgba(255,45,120,.1);text-align:center;min-width:100px;display:none;text-shadow:0 0 15px rgba(255,45,120,.8);letter-spacing:2px;';
            document.body.appendChild(overlayEl);
            return overlayEl;
        };
        const tick = () => {
            const endStr = localStorage.getItem(COUNTDOWN_KEY);
            const ov = getOrCreate();
            if (!endStr) { ov.style.display = 'none'; setTimeout(tick, 500); return; }
            const remaining = Math.ceil((parseInt(endStr) - Date.now()) / 1000);
            if (remaining <= 0) { localStorage.removeItem(COUNTDOWN_KEY); ov.style.display = 'none'; setTimeout(tick, 500); return; }
            ov.style.display = 'block'; ov.textContent = remaining + 's';
            setTimeout(tick, 300);
        };
        tick();
    }

    // ─── CAPTCHA WATCHER ──────────────────────────────────────────────────
    function startCaptchaWatcher(setStatus, autoBar) {
        let watching = false, solved = false, solvedTimer = null;
        const log = (msg, type) => { if (setStatus) setStatus(msg, type||'ok'); if (autoBar) autoBar.textContent = msg; };
        const PRESENT_SEL = ['iframe[src*="hcaptcha.com"]','.h-captcha','iframe[src*="recaptcha"]','.g-recaptcha','iframe[src*="challenges.cloudflare.com"]','.cf-turnstile'].join(',');
        function isSolved() {
            for (const s of ['textarea[id^="h-captcha-response"]','textarea[name="h-captcha-response"]','textarea[id^="g-recaptcha-response"]','textarea[name="g-recaptcha-response"]']) {
                const el = document.querySelector(s); if (el && el.value && el.value.length > 10) return true;
            }
            for (const s of ['input[name="cf-turnstile-response"]','input[name="cf_turnstile_response"]']) {
                const el = document.querySelector(s); if (el && el.value && el.value.length > 10) return true;
            }
            return false;
        }
        async function onSolved() {
            if (solved) return; solved = true; log('Captcha solved!');
            await sleep(700); const btn1 = findConfirmBtn();
            if (btn1) { simClick(btn1); log('Click OK'); } else log('Không thấy nút xác nhận', 'err');
            await sleep(900); const sub = await waitForElement('#submit-button', 15000);
            if (sub) { await sleep(400); simClick(sub); log('Hoàn tất!', 'ok'); if (autoBar) autoBar.style.display = 'none'; }
            else log('Không thấy #submit-button', 'err');
        }
        function startWatching() {
            if (watching) return; watching = true; solved = false; log('Chờ giải captcha...');
            const iv = setInterval(() => {
                if (isSolved()) { clearInterval(iv); watching = false; if (solvedTimer) clearTimeout(solvedTimer); solvedTimer = setTimeout(() => onSolved(), 300); }
            }, 600);
            setTimeout(() => { clearInterval(iv); watching = false; }, 300000);
        }
        const obs = new MutationObserver(() => {
            const has = !!document.querySelector(PRESENT_SEL);
            if (has) startWatching();
            else if (!has && watching) { watching = false; solved = false; if (solvedTimer) { clearTimeout(solvedTimer); solvedTimer = null; } }
        });
        obs.observe(document.body, {childList:true, subtree:true, attributes:true});
        if (document.querySelector(PRESENT_SEL)) startWatching();
    }

