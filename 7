            else log('btn-xac-nhan not found', 'err');
            if (autoBar) setTimeout(() => { autoBar.style.display = 'none'; }, 4000);
        }
        const obs = new MutationObserver(() => {
            const hasCaptcha = !!document.querySelector('iframe[src*="recaptcha"],iframe[src*="hcaptcha"],.g-recaptcha,.h-captcha');
            if (hasCaptcha && !watching) {
                watching = true; solved = false; log('Waiting for captcha solve...');
                const iv = setInterval(() => {
                    if (isSolved()) {
                        clearInterval(iv); watching = false;
                        if (solvedTimer) clearTimeout(solvedTimer);
                        solvedTimer = setTimeout(() => onSolved(), 500);
                    }
                }, 400);
                setTimeout(() => { clearInterval(iv); watching = false; }, 300000);
            }
        });
        if (document.body) obs.observe(document.body, { childList:true, subtree:true, attributes:true });
        else document.addEventListener('DOMContentLoaded', () => obs.observe(document.body, { childList:true, subtree:true, attributes:true }));
    }

