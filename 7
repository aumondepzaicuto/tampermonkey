        for (const sp of allSpans) {
            const style = sp.getAttribute('style') || '';

            // Kiểm tra 6 thuộc tính bắt buộc trên span NGOÀI
            // (thay đổi list này nếu trang đích cập nhật style)
            const hasBorderRadius = style.includes('border-radius');
            const hasPadding      = style.includes('padding');
            const hasCursor       = style.includes('cursor: pointer') || style.includes('cursor:pointer');
            const hasInlineBlock  = style.includes('display: inline-block') || style.includes('display:inline-block');
            const hasFontWeight   = style.includes('font-weight: 700') || style.includes('font-weight:700');
            const hasLineHeight   = style.includes('line-height');

            // Cần đủ cả 6 điều kiện để tránh nhầm với nút khác
            if (!(hasBorderRadius && hasPadding && hasCursor && hasInlineBlock && hasFontWeight && hasLineHeight)) continue;

            // Kiểm tra span CON: phải có display:inline-block + vertical-align:middle + color:#fff
            const innerSpan = sp.querySelector('span');
            if (!innerSpan) continue;
            const innerStyle = innerSpan.getAttribute('style') || '';
            const innerOk = (innerStyle.includes('inline-block') || innerStyle.includes('inline')) &&
                            (innerStyle.includes('color:#fff') || innerStyle.includes('color: #fff'));
            if (!innerOk) continue;

            // Text phải là "LẤY MÃ" (chính xác, tránh "LẤY MÃ SAU XX")
            const innerText = (innerSpan.textContent || '').trim();
            if (innerText !== 'LẤY MÃ') continue;

            // Bỏ qua nếu đang disabled/countdown (text span ngoài có "SAU")
            const outerText = (sp.textContent || '').trim();
            if (/SAU\s*\d/i.test(outerText)) continue;

            console.log('[LAYMA v2.5] Found by inline-style fingerprint, bg:', window.getComputedStyle(sp).backgroundColor);
            return sp;
        }

        // ── Phương pháp 3: #R2MO5wyug container fallback ────────────────
        const container = document.querySelector('#R2MO5wyug');
        if (container) {
            console.log('[LAYMA v2.5] Fallback: using #R2MO5wyug container');
            return container;
        }

        console.warn('[LAYMA v2.5] LAY MA button NOT FOUND by any method');
        return null;
    }

    // Kiểm tra nút đã active (màu xanh) hay chưa
    function isLayMaBtnActive(btn) {
        if (!btn) return false;
        const bg = window.getComputedStyle(btn).backgroundColor;
        return bg.includes('11, 244, 5') || bg.includes('11,244,5') ||
               bg.includes('0, 255, 0')  || bg.includes('0,255,0');
    }

    // Chờ nút chuyển sang xanh (active) tối đa maxWaitMs ms
    async function waitForLayMaBtnActive(maxWaitMs) {
        maxWaitMs = maxWaitMs || 90000;
        const start = Date.now();
        let firstCountdown = true;
        while (Date.now() - start < maxWaitMs) {
            await workerSleep(500);
            const btn = findLayMaBtn();
            if (!btn) continue;
            if (isLayMaBtnActive(btn)) {
                console.log('[LAYMA v2.5] Button is now ACTIVE (green)!');
                return btn;
            }
            // Lần đầu thấy countdown -> ghi vào localStorage để overlay hiện
            if (firstCountdown) {
                const ctrVal = getCounterValue();
                if (ctrVal > 0) {
                    firstCountdown = false;
                    const endTime = Date.now() + ctrVal*1000;
                    try {
                        localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
                        if (window.opener && !window.opener.closed)
                            window.opener.localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
                    } catch(_) {}
                }
            }
            const elapsed = Date.now() - start;
            if (elapsed % 5000 < 600) {
                const ctrVal = getCounterValue();
                showToast('⏳ Chờ nút active... ' + (ctrVal > 0 ? ctrVal+'s' : Math.round((maxWaitMs-elapsed)/1000)+'s còn lại'));
            }
        }
        return null;
    }

    function readCountdownFromBtn() {
        for (const el of document.querySelectorAll('span, div, button')) {
            const text = (el.innerText||el.textContent||'').trim();
            const m = text.match(/(?:lấy mã sau|lay ma sau|Lấy mã sau)\s*(\d+)/i);
            if (m) return parseInt(m[1]);
        }
        const ctr = document.querySelector('#counter');
        if (ctr) { const v = parseInt((ctr.textContent||'').trim()); if (v > 0) return v; }
        return 0;
    }
    function getMessageBoxText() {
        const msg = document.querySelector('#message');
        if (!msg) return '';
        let text = '';
        for (const node of msg.childNodes) { if (node.nodeType===Node.TEXT_NODE) text += node.textContent; }
        return text.trim();
    }
    function getCounterValue() {
        const ctr = document.querySelector('#counter');
        if (!ctr) return -1;
        return parseInt((ctr.textContent||'').trim()) || 0;
    }
    function isChallengeOverlayVisible() {
        const msg = document.querySelector('#message');
        if (!msg) return false;
        let parent = msg.parentElement;
        while (parent && parent !== document.body) {
            const computed = window.getComputedStyle(parent);
            if (computed.position === 'fixed') {
                if (computed.display==='none'||computed.visibility==='hidden') return false;
                const rect = parent.getBoundingClientRect();
                if (rect.width > 0 && rect.height > 0) return true;
                return false;
            }
            parent = parent.parentElement;
        }
        return isElementVisible(msg);
    }
    function isHcaptchaModalVisible() {
        const modal = document.querySelector('#hcaptcha-modal-content');
        if (!modal) return false;
        return isElementVisible(modal);
    }
    function isHcaptchaSolved() {
        for (const s of ['textarea[name="h-captcha-response"]','textarea[id^="h-captcha-response"]',
            'textarea[name="g-recaptcha-response"]','textarea[id^="g-recaptcha-response"]']) {
            const el = document.querySelector(s); if (el && el.value && el.value.length > 10) return true;
        }
        return false;
    }
    function findModalConfirmBtn() {
        const modal = document.querySelector('#hcaptcha-modal-content');
        if (modal) {
            for (const b of modal.querySelectorAll('button')) {
                const bg = window.getComputedStyle(b).backgroundColor;
                if (bg.includes('11, 244, 5')||bg.includes('11,244,5')) return b;
            }
            const firstBtn = modal.querySelector('button'); if (firstBtn) return firstBtn;
        }
        const xBtn = document.querySelector('#xacthucButton');
        if (xBtn && isElementVisible(xBtn)) return xBtn;
        return null;
    }
    function extractCodeFromMessage() {
        const msg = document.querySelector('#message'); if (!msg) return null;
        let text = '';
        for (const node of msg.childNodes) { if (node.nodeType===Node.TEXT_NODE) text += node.textContent; }
        text = text.trim();
        const m = text.match(/(?:mã code|ma code|code)[:\s]+([A-Za-z0-9]{4,20})/i);
        if (m) return m[1].trim();
        const words = text.split(/[\s:]+/);
        for (let i = words.length-1; i >= 0; i--) {
            const w = words[i].trim();
            if (/^[A-Za-z0-9]{4,12}$/.test(w) && !/^(code|mã|ma|và|lấy|lay|vào|vao)$/i.test(w)) return w;
        }
        return null;
    }
    function showToast(msg) {
        document.querySelectorAll('.__layma_toast__').forEach(t => t.remove());
        const t = document.createElement('div');
        t.className = '__layma_toast__';
        t.textContent = msg;
        t.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#0d1a0d,#0f2211);border:1px solid rgba(11,244,5,.35);color:#0bf405;font-family:"Share Tech Mono",monospace;font-size:12px;padding:12px 24px;border-radius:12px;z-index:99999999;box-shadow:0 4px 32px rgba(0,0,0,.6);white-space:pre-line;text-align:center;line-height:1.7;backdrop-filter:blur(8px);max-width:400px;pointer-events:none;';
        document.body.appendChild(t);
        setTimeout(() => { t.style.transition = 'opacity .4s'; t.style.opacity = '0'; setTimeout(() => t.remove(), 400); }, 3500);
    }
    function simulateTapScreen() {
        const messageOverlay = document.querySelector('#message');
        let overlayRect = null;
        if (messageOverlay) {
            let p = messageOverlay;
            while (p && p !== document.body) {
                const s = window.getComputedStyle(p);
                if (s.position==='fixed') { overlayRect = p.getBoundingClientRect(); break; }
                p = p.parentElement;
            }
        }
        const points = [];
        const W = window.innerWidth, H = window.innerHeight;
        for (let x = 0.15; x <= 0.85; x += 0.35) {
            for (let y = 0.1; y <= 0.9; y += 0.2) { points.push({ x:W*x, y:H*y }); }
        }
        let clicked = false;
        for (const pt of points) {
            if (overlayRect && pt.x>=overlayRect.left && pt.x<=overlayRect.right && pt.y>=overlayRect.top && pt.y<=overlayRect.bottom) continue;
            const target = document.elementFromPoint(pt.x, pt.y); if (!target) continue;
            if (target.closest('#message')||target.closest('#hcaptcha-modal-content')) continue;
            if (target.id==='counter'||target.id==='xacthucButton') continue;
            ['pointerdown','mousedown','pointerup','mouseup','click'].forEach(ev => {
                try {
                    const Ctor = ev.startsWith('pointer') ? PointerEvent : MouseEvent;
                    target.dispatchEvent(new Ctor(ev, { bubbles:true, cancelable:true, view:window, clientX:pt.x, clientY:pt.y }));
                } catch(_) {}
            });
            try {
                const touch = new Touch({ identifier:Date.now(), target, clientX:pt.x, clientY:pt.y });
                target.dispatchEvent(new TouchEvent('touchstart', { bubbles:true, cancelable:true, touches:[touch], changedTouches:[touch] }));
                target.dispatchEvent(new TouchEvent('touchend', { bubbles:true, cancelable:true, touches:[], changedTouches:[touch] }));
            } catch(_) {}
            clicked = true; break;
        }
        if (!clicked) {
            try { document.body.dispatchEvent(new MouseEvent('click', { bubbles:true, cancelable:true, clientX:50, clientY:50 })); } catch(_) {}
            try { document.body.click(); } catch(_) {}
        }
    }
    function simulateScrollUp() {
        window.scrollTo({ top:0, behavior:'smooth' });
        for (let i = 0; i < 5; i++) {
            setTimeout(() => {
                window.dispatchEvent(new Event('scroll', { bubbles:true }));
                try { window.dispatchEvent(new WheelEvent('wheel', { deltaY:-800, bubbles:true })); } catch(_) {}
            }, i*100);
        }
    }
    function simulateScrollDown() {
        const scrollHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        window.scrollTo({ top:scrollHeight, behavior:'smooth' });
        for (let i = 0; i < 5; i++) {
            setTimeout(() => {
                window.dispatchEvent(new Event('scroll', { bubbles:true }));
                try { window.dispatchEvent(new WheelEvent('wheel', { deltaY:800, bubbles:true })); } catch(_) {}
            }, i*100);
        }
    }
    function clickAnyPostElement() {
        const selectors = ['article','.post','.entry','[class*="post"]','[class*="article"]','.card','.blog-post'];
        for (const sel of selectors) {
            for (const el of document.querySelectorAll(sel)) {
                if (!isElementVisible(el)) continue;
                if (el.closest('#message')||el.closest('#hcaptcha-modal-content')) continue;
                if (window.getComputedStyle(el).position==='fixed') continue;
                simClick(el); return true;
            }
        }
        for (const a of document.querySelectorAll('a[href]')) {
            if (!isElementVisible(a)) continue;
            const href = a.href||'';
            if (href.includes('layma.net')||href.includes('facebook.com')) continue;
            if (a.closest('#message')||a.closest('#hcaptcha-modal-content')) continue;
            if (window.getComputedStyle(a).position==='fixed') continue;
            simClick(a); return true;
        }
        document.body.click(); return false;
    }
    function waitForElement(selector, timeout) {
        return new Promise(resolve => {
            const check = () => { const el = document.querySelector(selector); if (el && isElementVisible(el)) resolve(el); };
            check();
            const obs = new MutationObserver(check);
            if (document.body) obs.observe(document.body, { childList:true, subtree:true, attributes:true });
            setTimeout(() => { obs.disconnect(); resolve(null); }, timeout||10000);
        });
    }

    // ─── CHALLENGE HANDLER ────────────────────────────────────────────────
    let _lastChallengeType = '';
    let _lastChallengeTime = 0;
    async function handleChallengeMessage(msgText, ctrVal) {
        const now = Date.now();
        const textLower = msgText.toLowerCase();
        if (textLower.includes('chạm vào màn hình')||textLower.includes('cham vao man hinh')||textLower.includes('chạm vào')||textLower.includes('tap')) {
            if (_lastChallengeType==='tap' && now-_lastChallengeTime < 2000) return;
            _lastChallengeType = 'tap'; _lastChallengeTime = now;
            showToast('🖐 Challenge: Tap screen...'); await workerSleep(300); simulateTapScreen(); await workerSleep(1000); return;
        }
        if (textLower.includes('cuộn lên')||textLower.includes('cuon len')||textLower.includes('scroll up')) {
            if (_lastChallengeType==='scrollUp' && now-_lastChallengeTime < 2000) return;
            _lastChallengeType = 'scrollUp'; _lastChallengeTime = now;
            showToast('⬆ Challenge: Scroll UP...'); simulateScrollUp(); await workerSleep(1500); return;
        }
        if (textLower.includes('cuộn xuống')||textLower.includes('cuon xuong')||textLower.includes('scroll down')) {
            if (_lastChallengeType==='scrollDown' && now-_lastChallengeTime < 2000) return;
            _lastChallengeType = 'scrollDown'; _lastChallengeTime = now;
            showToast('⬇ Challenge: Scroll DOWN...'); simulateScrollDown(); await workerSleep(1500); return;
        }
        if (textLower.includes('nhấn bài viết')||textLower.includes('nhan bai viet')||textLower.includes('bài viết bất kỳ')||textLower.includes('bai viet bat ky')) {
            if (_lastChallengeType==='clickPost' && now-_lastChallengeTime < 4000) return;
            _lastChallengeType = 'clickPost'; _lastChallengeTime = now;
            showToast('📄 Challenge: Click post -> reload...');
            clickAnyPostElement(); await workerSleep(1000);
            sessionStorage.setItem('layma_reload_flow','1'); location.reload(); return;
        }
    }

    // ─── POST-COUNTDOWN HANDLER ───────────────────────────────────────────
    async function handlePostCountdown() {
        showToast('⏱ Countdown done, checking state...');
        await workerSleep(1500);
        for (let attempt = 0; attempt < 180; attempt++) {
            await workerSleep(400);
            const code = extractCodeFromMessage();
            if (code && getCounterValue() <= 0) { showToast('✅ CODE FOUND: ' + code); await _sendCodeBack(code); return; }
            if (isHcaptchaModalVisible()) {
                showToast('🔒 hCaptcha modal detected! Waiting...');
                for (let cap = 0; cap < 600; cap++) {
                    await workerSleep(500);
                    if (isHcaptchaSolved()) {
                        showToast('✅ hCaptcha solved! Clicking confirm...');
                        await workerSleep(800);
                        const confirmBtn = findModalConfirmBtn();
                        if (confirmBtn) { simClick(confirmBtn); showToast('Clicked confirm'); }
                        await workerSleep(3000);
                        const xBtn = document.querySelector('#xacthucButton');
                        if (xBtn && isElementVisible(xBtn)) { simClick(xBtn); await workerSleep(2500); }
                        for (let retry = 0; retry < 10; retry++) {
                            await workerSleep(500);
                            const codeAfterCap = extractCodeFromMessage();
                            if (codeAfterCap) { showToast('✅ CODE: ' + codeAfterCap); await _sendCodeBack(codeAfterCap); return; }
                        }
                        break;
                    }
                }
                continue;
            }
            if (isChallengeOverlayVisible()) {
                const msgText = getMessageBoxText();
                const ctrVal  = getCounterValue();
                const codeInMsg = extractCodeFromMessage();
                if (codeInMsg && ctrVal <= 0) { showToast('✅ CODE: ' + codeInMsg); await _sendCodeBack(codeInMsg); return; }
                showToast((ctrVal >= 0 ? ctrVal+'s' : '') + ' | ' + msgText.substring(0,50));
                await handleChallengeMessage(msgText, ctrVal);
            }
            const xBtn = document.querySelector('#xacthucButton');
            if (xBtn && isElementVisible(xBtn)) {
                showToast('Clicking Xac Thuc button...');
                simClick(xBtn); await workerSleep(3000);
                const c2 = extractCodeFromMessage();
                if (c2) { showToast('✅ CODE: ' + c2); await _sendCodeBack(c2); return; }
            }
            if (getCounterValue() <= 0) {
                const fullText = (document.body.innerText||document.body.textContent||'');
                const codeMatch = fullText.match(/(?:mã code|ma code|code)[:\s]+([A-Za-z0-9]{4,20})/i);
                if (codeMatch) { showToast('✅ CODE (page scan): ' + codeMatch[1]); await _sendCodeBack(codeMatch[1]); return; }
            }
        }
        showToast('❌ Could not auto-get code. Check manually.');
    }

    // ─── COUNTDOWN LOOP ───────────────────────────────────────────────────
    async function runCountdownLoop(countdownSec) {
        _lastChallengeType = '';
        const startMs = Date.now(), totalMs = countdownSec*1000;
        while (Date.now()-startMs < totalMs+10000) {
            await workerSleep(350);
            if (isHcaptchaModalVisible()) {
                showToast('🔒 hCaptcha during countdown!');
                for (let cap = 0; cap < 600; cap++) {
                    await workerSleep(500);
                    if (isHcaptchaSolved()) {
                        showToast('✅ hCaptcha solved!'); await workerSleep(700);
                        const confirmBtn = findModalConfirmBtn(); if (confirmBtn) simClick(confirmBtn);
                        await workerSleep(2500); break;
                    }
                }
                continue;
            }
            if (isChallengeOverlayVisible()) {
                const msgText = getMessageBoxText();
                const ctrVal  = getCounterValue();
                const ec = extractCodeFromMessage();
                if (ec && ctrVal <= 0) { showToast('✅ CODE: ' + ec); await _sendCodeBack(ec); return; }
                showToast((ctrVal >= 0 ? ctrVal+'s' : '') + ' | ' + msgText.substring(0,50));
                await handleChallengeMessage(msgText, ctrVal);
            } else {
                if (Date.now()-startMs >= totalMs) break;
                const remaining = Math.ceil((totalMs-(Date.now()-startMs))/1000);
                if (remaining % 10 === 0 || remaining <= 5) showToast('⏳ ' + remaining + 's...');
            }
            const xBtn = document.querySelector('#xacthucButton');
            if (xBtn && isElementVisible(xBtn)) {
                showToast('Clicking Xac Thuc...');
                simClick(xBtn); await workerSleep(3000);
                const c2 = extractCodeFromMessage();
                if (c2) { showToast('✅ CODE: ' + c2); await _sendCodeBack(c2); return; }
            }
        }
        try {
            localStorage.removeItem(COUNTDOWN_KEY);
            if (window.opener && !window.opener.closed) window.opener.localStorage.removeItem(COUNTDOWN_KEY);
        } catch(_) {}
        await handlePostCountdown();
    }

    // ─── RELOAD FLOW ──────────────────────────────────────────────────────
    async function handleReloadedTargetSite() {
        preventThrottling();
        showToast('🔄 Page reloaded — re-entering flow...');
        await waitForPageLoad();
        showToast('✅ Page loaded, scrolling down...');
        await workerSleep(2000);
        await scrollToBottom();
        await workerSleep(1500);

        // Tìm nút (bất kể màu)
        let layMaBtn = null;
        for (let i = 0; i < 30; i++) {
            layMaBtn = findLayMaBtn();
            if (layMaBtn) break;
            if (i===10) { simulateScrollDown(); await workerSleep(800); }
            if (i===20) { simulateScrollUp(); await workerSleep(800); simulateScrollDown(); }
            await workerSleep(600);
        }
        if (!layMaBtn) { showToast('❌ Cannot find LAY MA after reload!'); await handlePostCountdown(); return; }

        // Chờ nút active nếu cần
        if (!isLayMaBtnActive(layMaBtn)) {
            showToast('🔴 Nút đỏ, chờ active...');
            const activeBtn = await waitForLayMaBtnActive(120000);
            layMaBtn = activeBtn || findLayMaBtn() || layMaBtn;
        }

        layMaBtn.scrollIntoView({ behavior:'smooth', block:'center' });
        await workerSleep(800);
        showToast('Found LAY MA (reload), clicking...');
        simClick(layMaBtn);
        await workerSleep(2000);

        let countdownSec = 0;
        for (let i = 0; i < 30; i++) {
            await workerSleep(500);
            countdownSec = readCountdownFromBtn();
            if (countdownSec > 0) break;
            const ctrVal = getCounterValue();
            if (ctrVal > 0) { countdownSec = ctrVal; break; }
        }
        if (countdownSec <= 2) { showToast('Countdown done, checking...'); await handlePostCountdown(); return; }

        const endTime = Date.now() + countdownSec*1000;
        try {
            localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
            if (window.opener && !window.opener.closed) window.opener.localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
        } catch(_) {}
        showToast('⏳ Countdown: ' + countdownSec + 's (reload)');
        await runCountdownLoop(countdownSec);
    }

    // ─── MAIN FLOW ON TARGET SITE ─────────────────────────────────────────
    async function clickOnTargetSite() {
        window.name = '';
        preventThrottling();
        showToast('🚀 Tab opened. Waiting for page load...');

        await waitForPageLoad();
        showToast('✅ Page loaded! Waiting 3s...');
