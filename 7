    const isFBRedirect =
        (host === 'l.facebook.com' || host === 'www.facebook.com') &&
        (path.includes('/l.php') || path.includes('/flx/warn'));

    if (isFBRedirect) {
        const handleFBRedirect = () => {
            function findTruyCapBtn() {
                const allSpans = document.querySelectorAll('span');
                for (const sp of allSpans) {
                    const t = (sp.innerText || sp.textContent || '').trim();
                    if (t === 'Truy cập vào liên kết' || t.includes('Truy cập vào liên kết')) {
                        let el = sp;
                        for (let i = 0; i < 8; i++) {
                            el = el.parentElement;
                            if (!el) break;
                            if (el.getAttribute('role') === 'button' || el.tagName === 'BUTTON' || el.tagName === 'A') return el;
                            if (el.classList && (el.classList.contains('x1ja2u2z') || el.classList.contains('x1e0frkt'))) return el;
                        }
                        return sp.closest('[role="button"]') || sp.closest('[role="none"]') || sp.parentElement || sp;
                    }
                }
                for (const div of document.querySelectorAll('[role="none"], [role="button"]')) {
                    const t = (div.innerText || div.textContent || '').trim();
                    if (t.includes('Truy cập vào liên kết') || t.includes('Follow Link') || t.includes('Continue')) return div;
                }
                for (const div of document.querySelectorAll('div.x1ja2u2z, div.x1e0frkt')) {
                    const t = (div.innerText || div.textContent || '').trim();
                    if (t.includes('Truy cập') || t.includes('liên kết') || t.includes('Follow') || t.includes('Continue')) return div;
                }
                for (const a of document.querySelectorAll('a[href]')) {
                    const href = a.href || '';
                    const t = (a.innerText || a.textContent || '').trim();
                    if ((t.includes('Truy cập') || t.includes('Continue') || t.includes('Follow')) && !href.includes('facebook.com')) return a;
                }
                return null;
            }
            function extractRealURL() {
                const params = new URLSearchParams(location.search);
                let real = params.get('u') || params.get('q');
                if (real) { try { return decodeURIComponent(real); } catch { return real; } }
                for (const a of document.querySelectorAll('a[href]')) {
                    const href = a.href || '';
                    if (href && !href.includes('facebook.com') && href.startsWith('http')) return href;
                }
                const metaRefresh = document.querySelector('meta[http-equiv="refresh"]');
                if (metaRefresh) {
                    const content = metaRefresh.getAttribute('content') || '';
                    const m = content.match(/url=(.+)/i);
                    if (m) return m[1].trim();
                }
                return null;
            }
            let attempts = 0;
            const tryClick = () => {
                attempts++;
                const btn = findTruyCapBtn();
                if (btn) {
                    const rect = btn.getBoundingClientRect();
                    const cx = rect.left + rect.width / 2;
                    const cy = rect.top + rect.height / 2;
                    ['pointerdown','mousedown','pointerup','mouseup','click'].forEach(ev => {
                        try {
                            const Ctor = ev.startsWith('pointer') ? PointerEvent : MouseEvent;
                            btn.dispatchEvent(new Ctor(ev, { bubbles:true, cancelable:true, view:window, clientX:cx, clientY:cy }));
                        } catch(_) {}
                    });
                    try { btn.click(); } catch(_) {}
                    if (btn.tagName === 'A' && btn.href && !btn.href.includes('facebook.com')) {
                        setTimeout(() => { if (location.hostname === host) location.href = btn.href; }, 1000);
                    }
                    setTimeout(() => {
                        if (location.hostname === host) {
                            const real = extractRealURL();
                            if (real) { try { location.replace(real); } catch(e) { location.href = real; } }
                        }
                    }, 2500);
                    return;
                }
                if (attempts < 25) setTimeout(tryClick, 300);
                else {
                    const real = extractRealURL();
                    if (real) { try { location.replace(real); } catch(e) { location.href = real; } }
                }
            };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(tryClick, 200));
            else setTimeout(tryClick, 200);
        };
        handleFBRedirect();
        return;
    }

    const isOnLayma    = host.includes('layma.net');
    const isForceRunTab = (window.name === TAB_NAME);
    if (isForceRunTab) _installForceRun(window);

    // ─── FORCE-RUN (anti-throttle) ────────────────────────────────────────
    function _installForceRun(win) {
        try {
            Object.defineProperty(win.document, 'hidden', { get: () => false, configurable: true });
            Object.defineProperty(win.document, 'visibilityState', { get: () => 'visible', configurable: true });
            win.document.addEventListener('visibilitychange', e => { e.stopImmediatePropagation(); e.preventDefault(); }, true);
        } catch(_) {}
        const _keepRaf = () => win.requestAnimationFrame(_keepRaf);
        win.requestAnimationFrame(_keepRaf);

        const WORKER_CODE = `var timers={};self.onmessage=function(e){var m=e.data;if(m.cmd==='ST'){var tid=setTimeout(function(){delete timers[m.mid];self.postMessage({mid:m.mid,type:'ST'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='SI'){var tid=setInterval(function(){self.postMessage({mid:m.mid,type:'SI'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='CLR'){if(timers[m.mid]){clearTimeout(timers[m.mid]);clearInterval(timers[m.mid]);delete timers[m.mid];}}};`;
        let _timerWorker = null;
        try { const blob = new Blob([WORKER_CODE], { type: 'application/javascript' }); _timerWorker = new Worker(URL.createObjectURL(blob)); } catch(_) {}
        if (_timerWorker) {
            const _cbMap = new Map(); let _mid = 1;
            _timerWorker.onmessage = function(e) {
                const { mid, type } = e.data;
                const entry = _cbMap.get(mid); if (!entry) return;
                try { if (typeof entry.fn === 'function') entry.fn(...(entry.args||[])); else { try { eval(entry.fn); } catch(_) {} } } catch(_) {}
                if (type === 'ST') _cbMap.delete(mid);
            };
            const _origST = win.setTimeout.bind(win), _origSI = win.setInterval.bind(win), _origCST = win.clearTimeout.bind(win);
            win.setTimeout = function(fn, delay, ...args) {
                delay = +delay || 0;
                if (delay < 300) return _origST(fn, delay, ...args);
                const mid = _mid++; _cbMap.set(mid, { fn, args });
                _timerWorker.postMessage({ cmd:'ST', mid, delay });
                return -(mid + 900000);
            };
            win.setInterval = function(fn, delay, ...args) {
                delay = +delay || 4;
                if (delay < 300) return _origSI(fn, delay, ...args);
                const mid = _mid++; _cbMap.set(mid, { fn, args, repeat:true });
                _timerWorker.postMessage({ cmd:'SI', mid, delay });
                return -(mid + 900000);
            };
            const _clearShared = id => {
                if (typeof id === 'number' && id < -900000) {
                    const mid = -(id+900000); _cbMap.delete(mid); _timerWorker.postMessage({ cmd:'CLR', mid });
                } else { _origCST(id); }
            };
            win.clearTimeout = _clearShared;
            win.clearInterval = _clearShared;
        }
        try {
            const AC = win.AudioContext || win.webkitAudioContext;
            if (AC) {
                const ac = new AC(), buf = ac.createBuffer(1,1,22050), src = ac.createBufferSource(), g = ac.createGain();
                g.gain.value = 0.00001; src.buffer = buf; src.loop = true;
                src.connect(g); g.connect(ac.destination); src.start(0);
                setInterval(() => { if (ac.state === 'suspended') ac.resume(); }, 1000);
            }
        } catch(_) {}
    }

    const isOpenedByScript = isForceRunTab || (() => {
        try { return !isOnLayma && !!window.opener && !window.opener.closed; } catch(e) { return false; }
    })();

    if (!isOnLayma && !isOpenedByScript) return;

    // ─── HELPERS ──────────────────────────────────────────────────────────
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    function workerSleep(ms, onTick) {
        return new Promise(resolve => {
            let resolved = false;
            const done = () => { if (!resolved) { resolved = true; resolve(); } };
            const fallbackId = setTimeout(done, ms + 200);
            try {
                const code = `var start=Date.now(),dur=${ms};var iv=setInterval(function(){var el=Date.now()-start,rem=Math.max(0,dur-el);self.postMessage({elapsed:el,remaining:rem});if(el>=dur){clearInterval(iv);self.postMessage({done:true});}},200);`;
                const w = new Worker(URL.createObjectURL(new Blob([code], { type:'application/javascript' })));
                w.onmessage = e => {
                    if (e.data.done) { w.terminate(); clearTimeout(fallbackId); done(); }
                    else if (onTick) onTick(e.data.remaining);
                };
                w.onerror = () => { w.terminate(); };
            } catch(_) {}
        });
    }

    let _ac = null;
    function preventThrottling() {
        const tryStart = () => {
            try {
                const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
                if (!_ac) {
                    _ac = new AC();
                    const buf = _ac.createBuffer(1,1,22050), src = _ac.createBufferSource(), g = _ac.createGain();
                    g.gain.value = 0.00001; src.buffer = buf; src.loop = true;
                    src.connect(g); g.connect(_ac.destination); src.start(0);
                }
                if (_ac.state === 'suspended') _ac.resume();
            } catch(_) {}
        };
        tryStart();
        ['click','touchstart','keydown'].forEach(ev => document.addEventListener(ev, tryStart, { passive:true }));
        setInterval(() => { if (_ac && _ac.state === 'suspended') _ac.resume(); }, 2000);
    }

    // ─── STORAGE ──────────────────────────────────────────────────────────
    const getList  = () => { try { return JSON.parse(localStorage.getItem('layma_url_list') || '[]'); } catch { return []; } };
    const saveList = l => localStorage.setItem('layma_url_list', JSON.stringify(l));
    function addURL(url) { const l = getList(); if (!l.includes(url)) { l.unshift(url); saveList(l); } }

    function getImgMap()   { try { return JSON.parse(localStorage.getItem(IMG_MAP_KEY) || '{}'); } catch { return {}; } }
    function saveImgMap(m) { localStorage.setItem(IMG_MAP_KEY, JSON.stringify(m)); }
    function normKey(src) {
        if (!src) return '';
        try { const u = new URL(src); return (u.origin + u.pathname).toLowerCase(); }
        catch { return src.toLowerCase().replace(/\?.*$/, ''); }
    }
    function saveImgURL(imgSrc, url, votes) {
        if (!imgSrc || !url) return;
        const m = getImgMap(), k = normKey(imgSrc); if (!k) return;
        const prev = m[k] || { count:0 };
        m[k] = { url, votes: votes||1, lastSeen: Date.now(), count: (prev.count||0)+1 };
        saveImgMap(m);
    }
    function lookupImgURL(imgSrc) {
        if (!imgSrc) return null;
        const m = getImgMap(), k = normKey(imgSrc);
        return m[k] ? m[k].url : null;
    }

    // ─── BTN IMPORT STORAGE ───────────────────────────────────────────────
    // Lưu fingerprint nút theo hostname, dùng khi script không tự tìm được
    function getBtnImportMap() { try { return JSON.parse(localStorage.getItem(BTN_IMPORT_KEY) || '{}'); } catch { return {}; } }
    function saveBtnImportMap(m) { localStorage.setItem(BTN_IMPORT_KEY, JSON.stringify(m)); }

    // Lưu fingerprint nút cho hostname hiện tại
    function saveBtnFingerprint(hostname, fingerprint) {
        const m = getBtnImportMap();
        m[hostname] = { fingerprint, savedAt: Date.now() };
        saveBtnImportMap(m);
    }

    // Lấy fingerprint đã lưu cho hostname hiện tại
    function loadBtnFingerprint(hostname) {
        const m = getBtnImportMap();
        return m[hostname] ? m[hostname].fingerprint : null;
    }

    // ─── BTN FINGERPRINT PARSER ───────────────────────────────────────────
    // Parse HTML paste từ F12 -> trích xuất fingerprint (inline style của span ngoài + text span trong)
    function parseBtnHTML(htmlStr) {
        try {
            const div = document.createElement('div');
            div.innerHTML = htmlStr.trim();
            // Tìm span ngoài: có cursor:pointer, display:inline-block, border-radius, padding
            const spans = div.querySelectorAll('span');
            for (const sp of spans) {
                const style = sp.getAttribute('style') || '';
                const hasCursor      = style.includes('cursor: pointer') || style.includes('cursor:pointer');
                const hasInlineBlock = style.includes('display: inline-block') || style.includes('display:inline-block');
                const hasBorderRadius= style.includes('border-radius');
                const hasPadding     = style.includes('padding');
                if (!(hasCursor && hasInlineBlock && hasBorderRadius && hasPadding)) continue;

                // Lấy text từ span con (nếu có) hoặc span chính
                const innerSpan = sp.querySelector('span');
                const btnText = (innerSpan ? innerSpan.textContent : sp.textContent || '').trim();

                // Trích xuất background-color từ style inline
                const bgMatch = style.match(/background(?:-color)?:\s*([^;]+)/i);
                const bgColor = bgMatch ? bgMatch[1].trim() : '';

                // Trích xuất font-size
                const fsMatch = style.match(/font-size:\s*([^;]+)/i);
                const fontSize = fsMatch ? fsMatch[1].trim() : '';

                // Trích xuất font-weight
                const fwMatch = style.match(/font-weight:\s*([^;]+)/i);
                const fontWeight = fwMatch ? fwMatch[1].trim() : '';

                // Trích xuất border-radius
                const brMatch = style.match(/border-radius:\s*([^;]+)/i);
                const borderRadius = brMatch ? brMatch[1].trim() : '';

                // Trích xuất inner span style (nếu có)
                const innerStyle = innerSpan ? (innerSpan.getAttribute('style') || '') : '';

                return {
                    outerStyle: style,          // toàn bộ style của span ngoài
                    innerStyle,                 // style của span trong
                    btnText,                    // text của nút
                    bgColor,                    // màu nền
                    fontSize,                   // font-size
                    fontWeight,                 // font-weight
                    borderRadius,               // border-radius
                    hasInnerSpan: !!innerSpan,  // có span lồng không
                };
            }
            return null;
        } catch(e) {
            console.error('[LAYMA] parseBtnHTML error:', e);
            return null;
        }
    }

    // ─── BTN FINDER BẰNG FINGERPRINT ─────────────────────────────────────
    // Tìm nút theo fingerprint đã lưu từ import thủ công
    function findBtnByFingerprint(fingerprint) {
        if (!fingerprint) return null;
        const allSpans = document.querySelectorAll('span');
        for (const sp of allSpans) {
            const style = sp.getAttribute('style') || '';

            // So khớp các thuộc tính key từ fingerprint
            if (fingerprint.bgColor) {
                // Normalize để so sánh (bỏ spaces thừa)
                const normBg = (color) => color.replace(/\s+/g,'').toLowerCase();
                // Lấy màu thực tế từ style attribute và computed style
                const styleBg = style.match(/background(?:-color)?:\s*([^;]+)/i);
                const attrBg = styleBg ? normBg(styleBg[1]) : '';
                const compBg = normBg(window.getComputedStyle(sp).backgroundColor || '');
                const fpBg   = normBg(fingerprint.bgColor);
                if (attrBg !== fpBg && !compBg.includes(fpBg.replace('rgb(','').replace(')','').trim())) {
                    // Thử so sánh loosely (rgb values)
                    const extractRGB = s => s.match(/\d+/g) || [];
                    const fpRGB   = extractRGB(fpBg).join(',');
                    const attrRGB = extractRGB(attrBg).join(',');
                    const compRGB = extractRGB(compBg).join(',');
                    if (fpRGB && attrRGB !== fpRGB && compRGB !== fpRGB) continue;
                }
            }
            if (fingerprint.fontSize && !style.includes(fingerprint.fontSize)) continue;
            if (fingerprint.fontWeight && !style.includes(fingerprint.fontWeight)) continue;
            if (fingerprint.borderRadius && !style.includes(fingerprint.borderRadius)) continue;

            // Kiểm tra text
            const innerSpan = sp.querySelector('span');
            const actualText = (innerSpan ? innerSpan.textContent : sp.textContent || '').trim();
            if (fingerprint.btnText && actualText !== fingerprint.btnText) continue;

            console.log('[LAYMA v2.5] Found btn by saved fingerprint:', actualText);
            return sp;
        }
        return null;
    }

    // ─── EXPORT / IMPORT ──────────────────────────────────────────────────
    function exportData() {
        const payload = { version:'layma-v2.5', exported_at: new Date().toISOString(), url_list: getList(), img_map: getImgMap(), btn_import: getBtnImportMap() };
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type:'application/json' }));
        a.download = 'layma_backup_' + Date.now() + '.json';
        a.click(); URL.revokeObjectURL(a.href);
    }
    function importData(file, onDone) {
        const r = new FileReader();
        r.onload = e => {
            try {
                const data = JSON.parse(e.target.result);
                let au = 0, ai = 0, ab = 0;
                if (Array.isArray(data.url_list)) {
                    const cur = getList();
                    const merged = [...new Set([...data.url_list, ...cur])];
                    saveList(merged);
                    au = data.url_list.filter(u => !cur.includes(u)).length;
                }
                const imgKey = data.img_map || data.ocr_img_map;
                if (imgKey && typeof imgKey === 'object') {
                    const cur = getImgMap();
                    for (const [k, v] of Object.entries(imgKey)) {
                        if (!cur[k] || (v.lastSeen||0) > (cur[k].lastSeen||0)) { cur[k] = v; ai++; }
                    }
                    saveImgMap(cur);
                }
                if (data.btn_import && typeof data.btn_import === 'object') {
                    const cur = getBtnImportMap();
                    for (const [k, v] of Object.entries(data.btn_import)) {
                        if (!cur[k] || (v.savedAt||0) > (cur[k].savedAt||0)) { cur[k] = v; ab++; }
                    }
                    saveBtnImportMap(cur);
                }
                onDone('+' + au + ' URL, +' + ai + ' imgs, +' + ab + ' btns', 'ok');
            } catch(err) { onDone('File error: ' + err.message, 'err'); }
        };
        r.readAsText(file);
    }

    // ─── TLD / URL UTILS ──────────────────────────────────────────────────
    const TLD_LIST = ['com','net','org','io','vn','co','app','link','site','me','tv','gg','bet','win','club','live','online','xyz','info','pro','cc','us','uk','id','sg','ph','th','my','top','fun','store','shop','game','nl','de','fr','jp','ru','au','ca','br','in','es','it','pl','se','no','dk','fi','be','at','ch','gr','pt','tr','mx','ar','cl','pe','nz','biz','mobi','asia','si','ro'];
    const TLD_PAT  = TLD_LIST.join('|');

    function cleanURL(u) {
        if (!u) return '';
        u = u.trim().replace(/[.,;:!?)>"''«»\]`]+$/g,'').trim();
        if (!/^https?:\/\//i.test(u)) u = 'https://' + u;
        return u.replace(/\.{2,}/g,'.').replace(/\/+$/,'');
    }
    function isValidURL(u) {
        if (!u || u.length < 10) return false;
        if (!/^https?:\/\//i.test(u)) return false;
        if (!/https?:\/\/[a-zA-Z0-9\-]{2,}\.[a-zA-Z]{2,}/i.test(u)) return false;
        if (/\.\.\.|localhost|127\.|192\.168\./.test(u)) return false;
        const domain = u.replace(/^https?:\/\//i,'').split('/')[0];
        const parts  = domain.split('.');
        if (parts.length < 2 || parts[0].length < 2) return false;
        if (/[^a-zA-Z0-9\-\.]/.test(domain)) return false;
        return TLD_LIST.includes(parts[parts.length-1].toLowerCase());
    }
    function scanPageMetaURLs() {
        const found = new Set();
        const add = u => { const c = cleanURL(u); if (isValidURL(c) && !c.includes('layma.net') && !c.includes('facebook.com')) found.add(c); };
        const canonical = document.querySelector('link[rel="canonical"]'); if (canonical?.href) add(canonical.href);
        const ogUrl = document.querySelector('meta[property="og:url"]'); if (ogUrl?.content) add(ogUrl.content);
        const twUrl = document.querySelector('meta[name="twitter:url"]'); if (twUrl?.content) add(twUrl.content);
        return [...found];
    }
    function quickScanDOMForURL() {
        const found = new Set();
        for (const u of scanPageMetaURLs()) found.add(u);
        const TLD_RE = new RegExp(`https?:\\/\\/[^\\s<>"']{4,}|www\\.[a-zA-Z0-9\\-]{2,60}\\.(?:${TLD_PAT})(?:\\/[^\\s<>"']*)?`, 'gi');
        for (const el of document.querySelectorAll('cite,a,span,div,p,small,[class*="url"],[class*="link"]')) {
            if (el.offsetParent === null) continue;
            const t = (el.innerText || el.textContent || '').trim();
            if (t.length < 4 || t.length > 300) continue;
            for (const m of t.matchAll(TLD_RE)) {
                const u = cleanURL(m[0].startsWith('http') ? m[0] : 'https://'+m[0]);
                if (isValidURL(u)) found.add(u);
            }
        }
        for (const a of document.querySelectorAll('a[href]')) {
            const href = a.href || '';
            if (isValidURL(href) && !href.includes('layma.net') && !href.includes('facebook.com')) found.add(href);
        }
        return [...found];
    }
    function fuzzyMatch(rawUrl) {
        if (!rawUrl) return { url:rawUrl, matched:false, score:0 };
        const list = getList(); if (!list.length) return { url:rawUrl, matched:false, score:0 };
        const norm = u => u.toLowerCase().replace(/^https?:\/\/(www\.)?/,'').replace(/\/+$/,'');
        const nr = norm(rawUrl);
        for (const s of list) if (norm(s) === nr) return { url:s, matched:true, score:1 };
        let best = null, bScore = 0;
        for (const s of list) {
            const ns = norm(s);
            if (ns.includes(nr) || nr.includes(ns)) {
                const sc = Math.min(nr.length, ns.length) / Math.max(nr.length, ns.length);
                if (sc >= 0.65 && sc > bScore) { bScore = sc; best = s; }
            }
        }
        if (best) return { url:best, matched:true, score:bScore };
        return { url:rawUrl, matched:false, score:0 };
    }
