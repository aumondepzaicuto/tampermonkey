        shell.querySelector('#layma-close-v2').onclick = () => shell.remove();

        let drag = false, ox = 0, oy = 0;
        const hdr = shell.querySelector('#layma-hdr-v2');
        hdr.onmousedown = e => { drag=true; ox=e.clientX-shell.offsetLeft; oy=e.clientY-shell.offsetTop; };
        hdr.addEventListener('touchstart', e => { const t=e.touches[0]; drag=true; ox=t.clientX-shell.offsetLeft; oy=t.clientY-shell.offsetTop; }, { passive:true });
        document.addEventListener('mouseup', () => drag=false);
        document.addEventListener('touchend', () => drag=false);
        document.addEventListener('mousemove', e => { if(!drag) return; shell.style.left=(e.clientX-ox)+'px'; shell.style.top=(e.clientY-oy)+'px'; shell.style.right='auto'; });
        document.addEventListener('touchmove', e => { if(!drag) return; const t=e.touches[0]; shell.style.left=(t.clientX-ox)+'px'; shell.style.top=(t.clientY-oy)+'px'; shell.style.right='auto'; }, { passive:true });

        shell.querySelector('#layma-btn-imgs-v2').onclick = () => {
            const visible = imgList.style.display === 'block';
            imgList.style.display = visible ? 'none' : 'block';
            if (!visible) renderImgList();
        };
        function renderImgList() {
            const m = getImgMap(), keys = Object.keys(m);
            if (!keys.length) { imgList.innerHTML = '<div style="color:#444;font-size:9px;text-align:center;padding:6px;font-family:Share Tech Mono,monospace">No images yet</div>'; return; }
            keys.sort((a,b) => (m[b].lastSeen||0)-(m[a].lastSeen||0));
            imgList.innerHTML = '';
            keys.forEach(k => {
                const entry = m[k], name = k.split('/').pop().substring(0,22);
                const row = document.createElement('div'); row.className = 'layma-img-row-v2';
                const meta = document.createElement('div');
                meta.style.cssText = 'display:flex;justify-content:space-between;margin-bottom:2px';
                meta.innerHTML = `<span style="color:#444;font-size:7.5px;font-family:Share Tech Mono,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:80%">${name}</span><span style="color:#333;font-size:7px;font-family:Share Tech Mono,monospace">${entry.count||1}x</span>`;
                row.appendChild(meta);
                const inp = document.createElement('input'); inp.type='text'; inp.className='layma-img-url-v2'; inp.value=entry.url||''; inp.placeholder='URL...';
                row.appendChild(inp);
                const bRow = document.createElement('div'); bRow.className='layma-img-btn-row-v2';
                const bUse=document.createElement('button'); bUse.className='layma-img-btn-v2'; bUse.textContent='Use';
                const bSave=document.createElement('button'); bSave.className='layma-img-btn-v2'; bSave.textContent='Save';
                const bDel=document.createElement('button'); bDel.className='layma-img-btn-del-v2 layma-img-btn-v2'; bDel.textContent='X';
                bUse.onclick = () => { urlBox.value=inp.value; window._laymaUI.selectedImgKey=k; };
                bSave.onclick = () => { const mm=getImgMap(); if(mm[k]) { mm[k].url=inp.value.trim(); mm[k].lastSeen=Date.now(); saveImgMap(mm); } };
                bDel.onclick = () => { const mm=getImgMap(); delete mm[k]; saveImgMap(mm); if(window._laymaUI.selectedImgKey===k) window._laymaUI.selectedImgKey=null; row.remove(); };
                bRow.append(bUse,bSave,bDel); row.appendChild(bRow); imgList.appendChild(row);
            });
            const clr=document.createElement('button'); clr.className='layma-clr-btn-v2'; clr.textContent='DELETE ALL';
            clr.onclick = () => { saveImgMap({}); window._laymaUI.selectedImgKey=null; imgList.innerHTML='<div style="color:#444;font-size:9px;text-align:center;padding:6px">Deleted all</div>'; };
            imgList.appendChild(clr);
        }

        shell.querySelector('#layma-btn-scan-v2').onclick = async () => {
            imgList.style.display='none'; shell.querySelector('#layma-cand-v2').style.display='none'; cacheBadge.style.display='none';
            setStatus('Starting AI Scan...',''); await runAIScan(setStatus, urlBox);
        };

        shell.querySelector('#layma-btn-open-v2').onclick = () => {
            let url = urlBox.value.trim();
            if (!url) { setStatus('Enter URL first!','err'); return; }
            if (!url.startsWith('http')) url = 'https://'+url;
            let saved = false;
            if (window._laymaUI.selectedImgKey) {
                const mm=getImgMap(), key=window._laymaUI.selectedImgKey;
                if (mm[key] && mm[key].url !== url) { mm[key].url=url; mm[key].lastSeen=Date.now(); saveImgMap(mm); if(imgList.style.display==='block') renderImgList(); saved=true; }
            } else if (window._laymaUI.lastScannedImgKey && window._laymaUI.lastScannedImgSrc) {
                const mm=getImgMap(), key=window._laymaUI.lastScannedImgKey;
                if (!mm[key] || mm[key].url !== url) { saveImgURL(window._laymaUI.lastScannedImgSrc, url, 1); window._laymaUI.selectedImgKey=key; saved=true; }
            }
            setStatus(saved ? 'Saved & opening...' : 'Opening...','ok');
            addURL(url); openViaFacebook(url);
            autoBar.style.display='block'; autoBar.textContent='Waiting for code from target tab...';
        };

        shell.querySelector('#layma-btn-export-v2').onclick = () => { try { exportData(); setStatus('Exported!','ok'); } catch(e) { setStatus('Export error: '+e.message,'err'); } };
        shell.querySelector('#layma-btn-import-v2').onclick = () => { importFile.value=''; importFile.click(); };
        importFile.onchange = () => {
            const file=importFile.files[0]; if(!file) return;
            setStatus('Importing...','');
            importData(file, (msg, type) => { setStatus(msg,type); if(imgList.style.display==='block') renderImgList(); });
        };

        startCodeListener(setStatus, autoBar);
        startLaymaCaptchaWatcher(setStatus, autoBar);
        startCountdownWatcher();

        setTimeout(async () => {
            const ui = window._laymaUI; if (!ui) return;
            for (const img of document.images) {
                const cached = lookupImgURL(img.src);
                if (cached) {
                    ui.urlBox.value=cached; ui.selectedImgKey=normKey(img.src);
                    ui.lastScannedImgKey=normKey(img.src); ui.lastScannedImgSrc=img.src;
                    cacheBadge.style.display='block'; setStatus('Cache hit: '+cached,'ok');
                    openViaFacebook(cached); autoBar.style.display='block';
                    autoBar.textContent='Waiting for code from target tab...'; return;
                }
            }
            await runAIScan(setStatus, ui.urlBox);
        }, 2500);
    }

    // ─── ENTRY POINT ──────────────────────────────────────────────────────
    if (isOnLayma) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', createUI);
        else createUI();

    } else if (isOpenedByScript) {
        preventThrottling();
        // Mini menu chỉ hiện ở trang đích (không phải layma.net)
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', createMiniMenu);
        else createMiniMenu();

        const runFlow = () => {
            const isReload = sessionStorage.getItem('layma_reload_flow');
            if (isReload) {
                sessionStorage.removeItem('layma_reload_flow');
                waitForPageLoad().then(() => { setTimeout(handleReloadedTargetSite, 1500); });
            } else {
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', () => { clickOnTargetSite(); });
                } else {
                    clickOnTargetSite();
                }
            }
        };
        runFlow();
    }

})();
