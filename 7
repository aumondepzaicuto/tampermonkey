        if (!layMaBtn) { showToast('❌ LAY MA button not found. Aborting.'); return; }

        // Nếu nút chưa active -> chờ
        if (!isLayMaBtnActive(layMaBtn)) {
            showToast('🔴 Nút đang đỏ. Chờ chuyển xanh...');
            const activeBtn = await waitForLayMaBtnActive(120000);
