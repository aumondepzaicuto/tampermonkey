            const ctrVal = getCounterValue();
            if (ctrVal > 0) { countdownSec = ctrVal; break; }
            if (isChallengeOverlayVisible() && getCounterValue() === 0) {
                const code = extractCodeFromMessage();
                if (code) { showToast('✅ CODE (immediate): ' + code); await _sendCodeBack(code); return; }
            }
        }
        if (!countdownSec || countdownSec <= 0) { showToast('⚠ Cannot read countdown! Trying post-countdown...'); await handlePostCountdown(); return; }

        const endTime = Date.now() + countdownSec*1000;
        try {
            localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
            if (window.opener && !window.opener.closed) window.opener.localStorage.setItem(COUNTDOWN_KEY, endTime.toString());
        } catch(_) {}
        showToast('⏳ Countdown: ' + countdownSec + 's — watching...');
        await runCountdownLoop(countdownSec);
    }

    // ─── SEND CODE BACK ───────────────────────────────────────────────────
    async function _sendCodeBack(code) {
        try { GM_setClipboard(code); } catch { try { await navigator.clipboard.writeText(code); } catch(_) {} }
        if (window.opener && !window.opener.closed) {
            try {
                window.opener.localStorage.setItem(CODE_KEY, code);
                window.opener.dispatchEvent(new window.opener.StorageEvent('storage', { key:CODE_KEY, newValue:code, storageArea:window.opener.localStorage }));
            } catch {
                try { window.opener.postMessage({ type:'LAYMA_CODE', code }, '*'); } catch(_) {}
            }
        } else { localStorage.setItem(CODE_KEY, code); }
        showToast('✅ CODE: ' + code + '\nCopied! Sending to layma tab...\nClosing in 3s...');
        await workerSleep(3000);
        try { window.close(); } catch(_) {}
    }

