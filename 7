    function fetchBase64(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method:'GET', url, responseType:'blob', timeout:25000,
                onload: res => {
                    if (res.status < 200 || res.status >= 300) { reject(new Error('HTTP ' + res.status)); return; }
                    const reader = new FileReader();
                    reader.onloadend = () => resolve({ base64: reader.result.split(',')[1], mime: (res.response.type||'image/jpeg').split(';')[0] });
                    reader.onerror = () => reject(new Error('FileReader error'));
                    reader.readAsDataURL(res.response);
                },
                onerror: () => reject(new Error('Cannot load image')),
                ontimeout: () => reject(new Error('Timeout loading image'))
            });
        });
    }

