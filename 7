    function startLaymaCaptchaWatcher(setStatus, autoBar) {
        let watching = false, solved = false, solvedTimer = null;
        const log = (msg, type) => { if (setStatus) setStatus(msg, type||'ok'); if (autoBar) autoBar.textContent = msg; };
        function isSolved() {
            for (const s of ['textarea[id^="h-captcha-response"]','textarea[name="h-captcha-response"]']) {
                const el = document.querySelector(s); if (el && el.value && el.value.length > 10) return true;
            }
            for (const s of ['textarea[id^="g-recaptcha-response"]','textarea[name="g-recaptcha-response"]']) {
                const el = document.querySelector(s); if (el && el.value && el.value.length > 10) return true;
            }
            const anchor = document.querySelector('#recaptcha-anchor');
            if (anchor && anchor.getAttribute('aria-checked') === 'true') return true;
            return false;
        }
        async function onSolved() {
            if (solved) return; solved = true;
            log('Captcha solved! Clicking Xac Nhan...');
            await sleep(800);
            const btn = document.querySelector('#btn-xac-nhan') ||
                [...document.querySelectorAll('button')].find(b =>
                    (b.textContent||'').trim().toLowerCase().includes('xác nhận') ||
                    (b.textContent||'').trim().toLowerCase().includes('xac nhan'));
