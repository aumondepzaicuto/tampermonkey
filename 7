    function callAIModel(base64, mime, model) {
        const PROMPT = `Look at this image carefully. Find any website URL, domain name, or web address shown in the image.
Output ONLY the domain or URL with no explanation, no punctuation, no quotes.
Examples of good output: hitclub.si | www.abc88.com | https://xyz.net
If no URL found, output: NONE`;
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method:'POST', url:'https://openrouter.ai/api/v1/chat/completions',
                headers:{
                    'Content-Type':'application/json',
                    'Authorization':`Bearer ${API_KEY}`,
                    'HTTP-Referer':'https://tampermonkey.net',
                    'X-Title':'Layma AI Scanner v2.5'
                },
                data: JSON.stringify({
                    model,
                    messages:[{ role:'user', content:[
                        { type:'image_url', image_url:{ url:`data:${mime};base64,${base64}`, detail:'high' } },
                        { type:'text', text:PROMPT }
                    ]}],
                    max_tokens:120, temperature:0, top_p:1
                }),
                timeout:45000,
                onload: res => {
                    let data;
                    try { data = JSON.parse(res.responseText); } catch(e) { reject(new Error('JSON parse error')); return; }
                    if (data.error) {
                        const msg = typeof data.error==='object' ? (data.error.message||JSON.stringify(data.error)) : String(data.error);
                        reject(new Error((msg.includes('rate')||msg.includes('429')||msg.includes('quota') ? 'RATE_LIMIT: ':'') + msg));
                        return;
                    }
                    if (res.status < 200 || res.status >= 300) { reject(new Error('HTTP ' + res.status)); return; }
                    const text = data?.choices?.[0]?.message?.content?.trim();
                    if (!text || text.toUpperCase() === 'NONE' || text.length < 2) { reject(new Error('Empty/NONE response')); return; }
                    const extracted = extractURLFromAIText(text);
                    if (!extracted || extracted.length < 4) { reject(new Error('Cannot extract URL from: ' + text.substring(0,60))); return; }
                    resolve({ text:extracted, rawText:text, usedModel:data?.model||model });
                },
                onerror:  () => reject(new Error('Connection lost')),
                ontimeout:() => reject(new Error('Timeout 45s'))
            });
        });
    }
    async function tryAIModels(base64, mime, models, setStatus) {
        const errors = [];
        for (let i = 0; i < models.length; i++) {
            const model = models[i];
            const shortName = model.split('/').pop().replace(':free','');
            setStatus(`[${i+1}/${models.length}] ${shortName}`, '#3498db');
            try {
                const result = await callAIModel(base64, mime, model);
                if (result.text && result.text.length > 3 && !result.text.includes('NONE')) return result;
                errors.push(`${shortName}: bad result "${result.text}"`);
            } catch(err) {
                const errMsg = err.message || String(err);
                errors.push(`${shortName}: ${errMsg}`);
                if (i < models.length-1) {
                    setStatus(`Skip ${shortName} -> next...`, '#f39c12');
                    await sleep(errMsg.includes('RATE_LIMIT') ? 200 : 300);
                }
            }
        }
        throw new Error(`Tried ${models.length} models. Last: ${errors.slice(-3).join(' | ')}`);
    }

