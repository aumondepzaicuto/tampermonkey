    function simClick(el) {
        if (!el) return;
        try { el.scrollIntoView({ behavior:'smooth', block:'nearest' }); } catch(_) {}
        el.focus && el.focus();
        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width/2 || 100;
        const cy = rect.top  + rect.height/2 || 100;
        ['pointerdown','mousedown','pointerup','mouseup','click'].forEach(ev => {
            try {
                const Ctor = ev.startsWith('pointer') ? PointerEvent : MouseEvent;
                el.dispatchEvent(new Ctor(ev, { bubbles:true, cancelable:true, view:window, clientX:cx, clientY:cy }));
            } catch(_) {}
        });
        try {
            const container = el.closest('#R2MO5wyug');
            if (container) container.dispatchEvent(new MouseEvent('click', { bubbles:true, cancelable:true, view:window, clientX:cx, clientY:cy }));
        } catch(_) {}
        try { el.click(); } catch(_) {}
    }

    function isElementVisible(el) {
        if (!el) return false;
        const style = window.getComputedStyle(el);
        if (style.display==='none'||style.visibility==='hidden'||style.opacity==='0') return false;
        const rect = el.getBoundingClientRect();
        if (rect.width===0 && rect.height===0) return false;
        let parent = el.parentElement;
        while (parent && parent !== document.body) {
            const ps = window.getComputedStyle(parent);
            if (ps.display==='none') return false;
            parent = parent.parentElement;
        }
        return true;
    }

