    // ─── CODE LISTENER (tab chính) ────────────────────────────────────────
    function startCodeListener(setStatus, autoBar) {
        localStorage.removeItem(CODE_KEY);
        if (typeof GM_addValueChangeListener === 'function') {
            GM_addValueChangeListener(CODE_KEY, (name, oldValue, newValue) => {
                if (!newValue) return;
                localStorage.removeItem(CODE_KEY);
                if(autoBar){autoBar.style.display='block';autoBar.textContent=`Code: ${newValue}`;}
                if(setStatus)setStatus(`Code: ${newValue}`,'ok');
                autoFillCode(newValue,setStatus,autoBar);
            });
        }
        window.addEventListener('storage', async e=>{
            if(e.key!==CODE_KEY||!e.newValue)return;
            const code=e.newValue;localStorage.removeItem(CODE_KEY);
            if(autoBar){autoBar.style.display='block';autoBar.textContent=`Code: ${code}`;}
            if(setStatus)setStatus(`Code: ${code}`,'ok');
            await autoFillCode(code,setStatus,autoBar);
        });
        window.addEventListener('message',e=>{
            if(!e.data||e.data.type!=='OCR_CODE'||!e.data.code)return;
            const code=e.data.code;
            localStorage.setItem(CODE_KEY,code);
            window.dispatchEvent(new StorageEvent('storage',{key:CODE_KEY,newValue:code,storageArea:localStorage}));
        });
    }

    // ─── AUTO FILL CODE (tab chính) ──────────────────────────────────────
    async function autoFillCode(code, setStatus, autoBar) {
        const log=(msg,type)=>{if(setStatus)setStatus(msg,type||'ok');if(autoBar)autoBar.textContent=msg;};
        log('Đang điền mã...');

        const inp = document.querySelector('input[name="password"]') ||
                document.querySelector('input[name="code"][data-v-9b370738]') ||
                    document.querySelector('input[name="code"]');
        if(!inp){log('Không tìm thấy ô mã','err');return;}

        const setter=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;
        setter.call(inp,code);
        ['input','change','keyup'].forEach(ev=>inp.dispatchEvent(new Event(ev,{bubbles:true})));
        inp.focus(); log(`Đã điền: ${code}`);

        await sleep(800);
        log('Click Xác Nhận...');

        const confirmBtn = findNhapmaConfirmBtn();
        if(confirmBtn){simClick(confirmBtn);log('Click Xác Nhận');}
        else{log('Không thấy nút Xác Nhận','err');}

        await sleep(1200);

        // Kiểm tra captcha
        const captchaEl=document.querySelector('iframe[src*="hcaptcha"],iframe[src*="recaptcha"],iframe[src*="challenges.cloudflare.com"],.h-captcha,.g-recaptcha,.cf-turnstile');
        if(!captchaEl){
            await sleep(2500);
            const errEl=document.querySelector('.alert-error,[class*="error"],[class*="invalid"]');
            if(errEl&&errEl.offsetParent!==null){
                const t=(errEl.innerText||errEl.textContent||'').toLowerCase();
                if(t.includes('không đúng')||t.includes('sai')||t.includes('invalid')||t.includes('incorrect')){log('Mã sai!','err');return;}
            }
            log('Chờ nút Tiếp Tục...');
            // [SỬA] Tìm nút "Xác Nhận Và Tiếp Tục" enabled (sau khi không có captcha)
            const xacNhanBtn = await waitForEnabledSubmitBtn(15000);
            if(xacNhanBtn){await sleep(400);simClick(xacNhanBtn);log('Hoàn tất!','ok');if(autoBar)autoBar.style.display='none';}
            else log('Không thấy nút Tiếp Tục','err');
        } else {
            log('Chờ giải captcha...');
        }
    }

    // [MỚI] Chờ nút submit enabled (không disabled)
    function waitForEnabledSubmitBtn(timeout=15000) {
        return new Promise(resolve=>{
            const find=()=>{
                // Tìm "Xác Nhận Và Tiếp Tục" enabled
                const btns=[...document.querySelectorAll('button[type="submit"]')].filter(b=>!b.disabled&&b.offsetParent!==null);
                const xacNhan=btns.find(b=>{const t=(b.innerText||b.textContent||'').trim();return t.includes('Xác Nhận')||t.includes('Tiếp Tục');});
                return xacNhan||btns[0]||null;
            };
            const el=find(); if(el){resolve(el);return;}
            const obs=new MutationObserver(()=>{const el=find();if(el){obs.disconnect();resolve(el);}});
            obs.observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['disabled']});
            setTimeout(()=>{obs.disconnect();resolve(null);},timeout);
        });
    }

    function findNhapmaConfirmBtn() {
        // [SỬA] Tìm button "Xác Nhận Và Tiếp Tục" hoặc "Xác Nhận" không disabled
        const allBtns=[...document.querySelectorAll('button[type="submit"]')].filter(b=>b.offsetParent!==null&&!b.disabled);
        const xacNhanTiepTuc=allBtns.find(b=>{const t=(b.innerText||b.textContent||'').trim();return t.includes('Xác Nhận Và Tiếp Tục');});
        if(xacNhanTiepTuc)return xacNhanTiepTuc;
        const xacNhan=allBtns.find(b=>{const t=(b.innerText||b.textContent||'').trim();return t.includes('Xác Nhận')||t.includes('xac nhan');});
        if(xacNhan)return xacNhan;
        return allBtns[0]||null;
    }

    function waitForElement(selector, timeout=10000) {
        return new Promise(resolve=>{
            const check=()=>{const el=document.querySelector(selector);if(el&&el.offsetParent!==null){resolve(el);}};
            check();
            const obs=new MutationObserver(check);
            obs.observe(document.body,{childList:true,subtree:true,attributes:true});
            setTimeout(()=>{obs.disconnect();resolve(null);},timeout);
        });
    }

