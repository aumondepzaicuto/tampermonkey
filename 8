// ==UserScript==
// @name         link 4m
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  v1 - Auto OCR + auto flow cho nhapma.com. AI Vision quét URL, tự động điền mã, xử lý captcha.
// @match        https://nhapma.com/*
// @match        https://www.google.com/url*
// @match        *://*/*
// @grant        GM_setClipboard
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @grant        unsafeWindow
// @grant        GM_setValue
// @grant        GM_addValueChangeListener
// @run-at       document-start
// @connect      openrouter.ai
// @connect      *
// ==/UserScript==

(function () {
    'use strict';

    // ─── CONFIG ───────────────────────────────────────────────────────────
    const API_KEY         = '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';
    const TARGET_SELECTOR = 'p.text-center[style*="padding-bottom:30px"] img[src*="https://img.link4m.net/uploads/advertiser/worigin/"]';

    const TAB_NAME       = 'nhapma_target_v1';
    const IMG_MAP_KEY    = 'nhapma_img_map_v1';
    const COUNTDOWN_KEY  = 'nhapma_countdown_end_v1';
    const CODE_KEY       = 'nhapma_pending_code_v1';
    const TARGET_STATE_KEY = 'nhapma_target_click_state_v1';

    // ─── DANH SÁCH MODEL FREE VISION ─────────────────────────────────────
    const HARDCODED_FREE_VISION_MODELS = [
        
        'meta-llama/llama-4-scout:free',
        'meta-llama/llama-4-maverick:free',
        'meta-llama/llama-3.2-11b-vision-instruct:free',
        'meta-llama/llama-3.2-90b-vision-instruct:free',
        'qwen/qwen2.5-vl-72b-instruct:free',
        'qwen/qwen2.5-vl-7b-instruct:free',
        'qwen/qwen-vl-plus:free',
        'mistralai/pixtral-12b:free',
        'microsoft/phi-3.5-vision-instruct:free',
        'microsoft/phi-4-multimodal-instruct:free',
        'openai/gpt-4o-mini:free',
        'anthropic/claude-3-haiku:free',
        'bytedance-research/ui-tars-7b:free',
        'moonshotai/kimi-vl-a3b-thinking:free',
    ];

    const isForceRunTab = (window.name || '') === TAB_NAME;
    if (isForceRunTab) _installForceRun(window);

    // ─── FORCE-RUN (chống throttle tab nền) ──────────────────────────────
    function _installForceRun(win) {
        try {
            Object.defineProperty(win.document, 'hidden',          { get: () => false,     configurable: true });
            Object.defineProperty(win.document, 'visibilityState', { get: () => 'visible', configurable: true });
            win.document.addEventListener('visibilitychange', e => { e.stopImmediatePropagation(); e.preventDefault(); }, true);
        } catch (_) {}
        const _keepRaf = () => win.requestAnimationFrame(_keepRaf);
        win.requestAnimationFrame(_keepRaf);
        const WORKER_CODE = `var timers={};self.onmessage=function(e){var m=e.data;if(m.cmd==='ST'){var tid=setTimeout(function(){delete timers[m.mid];self.postMessage({mid:m.mid,type:'ST'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='SI'){var tid=setInterval(function(){self.postMessage({mid:m.mid,type:'SI'});},m.delay);timers[m.mid]=tid;}else if(m.cmd==='CLR'){if(timers[m.mid]){clearTimeout(timers[m.mid]);clearInterval(timers[m.mid]);delete timers[m.mid];}}};`;
        let _timerWorker = null;
        try { const blob = new Blob([WORKER_CODE], { type: 'application/javascript' }); _timerWorker = new Worker(URL.createObjectURL(blob)); } catch (_) {}
        if (_timerWorker) {
            const _cbMap = new Map(); let _mid = 1;
            _timerWorker.onmessage = function(e) {
                const { mid, type } = e.data; const entry = _cbMap.get(mid); if (!entry) return;
                try { if (typeof entry.fn === 'function') entry.fn(...(entry.args || [])); else { try { eval(entry.fn); } catch(_){} } } catch(_) {}
                if (type === 'ST') _cbMap.delete(mid);
            };
            const _origST = win.setTimeout.bind(win), _origSI = win.setInterval.bind(win), _origCST = win.clearTimeout.bind(win);
            win.setTimeout  = function(fn, delay, ...args) { delay=+delay||0; if(delay<300)return _origST(fn,delay,...args); const mid=_mid++;_cbMap.set(mid,{fn,args});_timerWorker.postMessage({cmd:'ST',mid,delay});return -(mid+900000); };
            win.setInterval = function(fn, delay, ...args) { delay=+delay||4; if(delay<300)return _origSI(fn,delay,...args); const mid=_mid++;_cbMap.set(mid,{fn,args,repeat:true});_timerWorker.postMessage({cmd:'SI',mid,delay});return -(mid+900000); };
            const _clearShared = id => { if(typeof id==='number'&&id<-900000){const mid=-(id+900000);_cbMap.delete(mid);_timerWorker.postMessage({cmd:'CLR',mid});}else{_origCST(id);}};
            win.clearTimeout = _clearShared; win.clearInterval = _clearShared;
        }
        try {
            const AC = win.AudioContext || win.webkitAudioContext;
            if (AC) { const ac=new AC(),buf=ac.createBuffer(1,1,22050),src=ac.createBufferSource(),g=ac.createGain();g.gain.value=0.00001;src.buffer=buf;src.loop=true;src.connect(g);g.connect(ac.destination);src.start(0);setInterval(()=>{if(ac.state==='suspended')ac.resume();},1000); }
        } catch(_) {}
    }

    // ─── GOOGLE REDIRECT ──────────────────────────────────────────────────
    const host = location.hostname;
    if (host.includes('google.com') && location.pathname === '/url') {
        const real = new URLSearchParams(location.search).get('q');
        if (real) {
            window.name = TAB_NAME;
            location.replace(real);
        }
        return;
    }

    const isOnNhapma     = host.includes('nhapma.com');
    const isOnLink4m     = /^(www\.)?link4m\.(?:net|org)$/i.test(host) && location.pathname.startsWith('/go/');
    const isGoogleRedirectTarget = /(?:^|\.)google\.com\/url/i.test(document.referrer || '');
    const isOpenedByScript = isForceRunTab || isGoogleRedirectTarget || (() => { try { return !isOnNhapma && window.opener && !window.opener.closed; } catch(e) { return false; } })();
    const isTargetPage = !isOnNhapma && !isOnLink4m && !host.includes('google.com');

    // ─── HELPERS ──────────────────────────────────────────────────────────
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    function workerSleep(ms, onTick) {
        return new Promise(resolve => {
            const code = `var start=Date.now(),dur=${ms};var iv=setInterval(function(){var el=Date.now()-start,rem=Math.max(0,dur-el);self.postMessage({elapsed:el,remaining:rem});if(el>=dur){clearInterval(iv);self.postMessage({done:true});}},200);`;
            const w = new Worker(URL.createObjectURL(new Blob([code], { type: 'application/javascript' })));
            w.onmessage = e => { if (e.data.done) { w.terminate(); resolve(); } else if (onTick) onTick(e.data.remaining); };
        });
    }

    let _ac = null;
    function preventThrottling() {
        const tryStart = () => {
            try {
                const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
                if (!_ac) { _ac=new AC();const buf=_ac.createBuffer(1,1,22050),src=_ac.createBufferSource(),g=_ac.createGain();g.gain.value=0.00001;src.buffer=buf;src.loop=true;src.connect(g);g.connect(_ac.destination);src.start(0); }
                if (_ac.state === 'suspended') _ac.resume();
            } catch(_) {}
        };
        tryStart();
        ['click','touchstart','keydown'].forEach(ev => document.addEventListener(ev, tryStart, {passive:true}));
        setInterval(() => { if (_ac && _ac.state==='suspended') _ac.resume(); }, 2000);
    }

    // ─── STORAGE ──────────────────────────────────────────────────────────
    const getList  = () => { try { return JSON.parse(localStorage.getItem('url_list') || '[]'); } catch { return []; } };
    const saveList = l  => localStorage.setItem('url_list', JSON.stringify(l));
    function addURL(url) { const l=getList(); if(!l.includes(url)){l.unshift(url);saveList(l);} }

    function getImgMap()   { try { return JSON.parse(localStorage.getItem(IMG_MAP_KEY)||'{}'); } catch { return {}; } }
    function saveImgMap(m) { localStorage.setItem(IMG_MAP_KEY, JSON.stringify(m)); }
    function normKey(src) {
        if (!src) return '';
        try { const u=new URL(src); return (u.origin+u.pathname).toLowerCase(); }
        catch { return src.toLowerCase().replace(/\?.*$/,''); }
    }
    function saveImgURL(imgSrc, url, votes) {
        if (!imgSrc||!url) return;
        const m=getImgMap(), k=normKey(imgSrc); if(!k) return;
        const prev=m[k]||{count:0};
        m[k]={url,votes:votes||1,lastSeen:Date.now(),count:(prev.count||0)+1};
        saveImgMap(m);
    }
    function lookupImgURL(imgSrc) {
        if (!imgSrc) return null;
        const m=getImgMap(), k=normKey(imgSrc);
        return m[k] ? m[k].url : null;
    }

    // ─── EXPORT / IMPORT ──────────────────────────────────────────────────
    function exportData() {
        const payload = {version:'nhapma_v1',exported_at:new Date().toISOString(),url_list:getList(),ocr_img_map:getImgMap()};
        const a=document.createElement('a');
        a.href=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));
        a.download=`nhapma_backup_${Date.now()}.json`; a.click(); URL.revokeObjectURL(a.href);
    }
    function importData(file, onDone) {
        const r=new FileReader();
        r.onload=e=>{
            try {
                const data=JSON.parse(e.target.result); let au=0,ai=0;
                if(Array.isArray(data.url_list)){const cur=getList(),merged=[...new Set([...data.url_list,...cur])];saveList(merged);au=data.url_list.filter(u=>!cur.includes(u)).length;}
                if(data.ocr_img_map&&typeof data.ocr_img_map==='object'){const cur=getImgMap();for(const[k,v]of Object.entries(data.ocr_img_map)){if(!cur[k]||(v.lastSeen||0)>(cur[k].lastSeen||0)){cur[k]=v;ai++;}}saveImgMap(cur);}
                onDone(`+${au} URL, +${ai} ảnh`,'ok');
            } catch(err){onDone('File lỗi: '+err.message,'err');}
        };
        r.readAsText(file);
    }

    // ─── DOM URL SCAN ─────────────────────────────────────────────────────
    const TLD_LIST = ['com','net','org','io','vn','co','app','link','site','me','tv','gg','bet','win','club','live','online','xyz','info','pro','cc','us','uk','id','sg','ph','th','my','top','fun','store','shop','game','nl','de','fr','jp','ru','au','ca','br','in','es','it','pl','se','no','dk','fi','be','at','ch','gr','pt','tr','mx','ar','cl','pe','nz','biz','mobi','asia'];
    const TLD_PAT  = TLD_LIST.join('|');

    function cleanURL(u) {
        if (!u) return '';
        u = u.trim();
        u = u.replace(/[.,;:!?)>"''«»\]`]+$/g, '').trim();
        if (!/^https?:\/\//i.test(u)) u = 'https://' + u;
        u = u.replace(/\.{2,}/g, '.').replace(/\/+$/, '');
        return u;
    }

    function isValidURL(u) {
        if (!u||u.length<10) return false;
        if (!/^https?:\/\//i.test(u)) return false;
        if (!/https?:\/\/[a-zA-Z0-9\-]{2,}\.[a-zA-Z]{2,}/i.test(u)) return false;
        if (/\.\.\.|localhost|127\.|192\.168\./.test(u)) return false;
        const domain=u.replace(/^https?:\/\//i,'').split('/')[0];
        const parts=domain.split('.');
        if (parts.length<2||parts[0].length<2) return false;
        if (/[^a-zA-Z0-9\-\.]/.test(domain)) return false;
        return TLD_LIST.includes(parts[parts.length-1].toLowerCase());
    }

    function scanPageMetaURLs() {
        const found=new Set();
        const add=u=>{const c=cleanURL(u);if(isValidURL(c)&&!c.includes('nhapma')&&!c.includes('google.com'))found.add(c);};
        const canonical=document.querySelector('link[rel="canonical"]'); if(canonical?.href) add(canonical.href);
        const ogUrl=document.querySelector('meta[property="og:url"]');   if(ogUrl?.content)  add(ogUrl.content);
        const twUrl=document.querySelector('meta[name="twitter:url"]');  if(twUrl?.content)  add(twUrl.content);
        return [...found];
    }
    function quickScanDOMForURL() {
        const found=new Set();
        for (const u of scanPageMetaURLs()) found.add(u);
        const TLD_RE=new RegExp(`https?:\\/\\/[^\\s<>"']{4,}|www\\.[a-zA-Z0-9\\-]{2,60}\\.(?:${TLD_PAT})(?:\\/[^\\s<>"']*)?`,'gi');
        for (const el of document.querySelectorAll('cite,a,span,div,p,small,[class*="url"],[class*="link"]')) {
            if (el.offsetParent===null) continue;
            const t=(el.innerText||el.textContent||'').trim();
            if (t.length<4||t.length>300) continue;
            for (const m of t.matchAll(TLD_RE)){const u=cleanURL(m[0].startsWith('http')?m[0]:'https://'+m[0]);if(isValidURL(u))found.add(u);}
        }
        for (const a of document.querySelectorAll('a[href]')){const href=a.href||'';if(isValidURL(href)&&!href.includes('nhapma')&&!href.includes('google.com/url'))found.add(href);}
        return [...found];
    }
    function fuzzyMatch(rawUrl) {
        if (!rawUrl) return {url:rawUrl,matched:false,score:0};
        const list=getList(); if(!list.length) return {url:rawUrl,matched:false,score:0};
        const norm=u=>u.toLowerCase().replace(/^https?:\/\/(www\.)?/,'').replace(/\/+$/,'');
        const nr=norm(rawUrl);
        for (const s of list) if(norm(s)===nr) return {url:s,matched:true,score:1};
        let best=null,bScore=0;
        for (const s of list){const ns=norm(s);if(ns.includes(nr)||nr.includes(ns)){const sc=Math.min(nr.length,ns.length)/Math.max(nr.length,ns.length);if(sc>=0.65&&sc>bScore){bScore=sc;best=s;}}}
        if (best) return {url:best,matched:true,score:bScore};
        return {url:rawUrl,matched:false,score:0};
    }
    function showCandidates(urls) {
        const cb=document.getElementById('ocr-cand-box-nm'); if(!cb) return;
        if (!urls||urls.length<=1){cb.style.display='none';return;}
        cb.style.display='block';
        cb.innerHTML=urls.slice(0,6).map(u=>`<div class="ocr-cand-nm" title="${u}" onclick="document.getElementById('ocr-url-box-nm').value='${u.replace(/'/g,"\\'")}'">  ${u}</div>`).join('');
    }

    // ─── URL EXTRACTOR TỪ RESPONSE AI ────────────────────────────────────
    function extractURLFromAIText(rawText) {
        if (!rawText) return '';
        const text = rawText.trim().replace(/^```(?:text|url)?\s*|\s*```$/gi, '').trim();
        const exactURL = /^(?:https?:\/\/)?(?:www\.)?[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?:[/?#][^\s]*)?$/i;
        if (!exactURL.test(text)) return '';
        const candidate = cleanURL(text);
        return isValidURL(candidate) ? candidate : '';
    }

    // ─── AI VISION ENGINE ─────────────────────────────────────────────────
    function findTargetImage() {
        return [...document.querySelectorAll(TARGET_SELECTOR)].find(img =>
            img.src && img.src.startsWith('http')
            && (img.naturalWidth === 0 || img.naturalWidth > 10)
        ) || null;
    }

    function fetchBase64(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method:'GET', url, responseType:'blob', timeout:25000,
                onload: res => {
                    if (res.status<200||res.status>=300){reject(new Error('HTTP '+res.status));return;}
                    const reader=new FileReader();
                    reader.onloadend=()=>{ const dataUrl=reader.result; resolve({base64:dataUrl.split(',')[1],mime:(res.response.type||'image/jpeg').split(';')[0]}); };
                    reader.onerror=()=>reject(new Error('FileReader lỗi'));
                    reader.readAsDataURL(res.response);
                },
                onerror:   ()=>reject(new Error('Không tải được ảnh')),
                ontimeout: ()=>reject(new Error('Timeout tải ảnh'))
            });
        });
    }

    async function getVisionModels(setStatus) {
        let dynamicModels=[];
        try {
            setStatus('📋 Fetch model list từ OpenRouter...','#9b59b6');
            dynamicModels = await new Promise((resolve,reject) => {
                GM_xmlhttpRequest({
                    method:'GET', url:'https://openrouter.ai/api/v1/models',
                    headers:{'Authorization':`Bearer ${API_KEY}`,'Content-Type':'application/json'}, timeout:10000,
                    onload: res => {
                        try {
                            const all=JSON.parse(res.responseText).data||[];
                            const models=all.filter(m=>{
                                const isFree=m.id.endsWith(':free')||(m.pricing&&(m.pricing.prompt==='0'||m.pricing.prompt===0)&&(m.pricing.completion==='0'||m.pricing.completion===0));
                                const hasVision=(m.architecture?.input_modalities||[]).includes('image')||(m.architecture?.modality||'').includes('image')||/vision|vl|flash|gemini|pixtral|qwen.*vl|llama.*vision|phi.*vision|phi.*multimodal|kimi-vl|ui-tars/i.test(m.id);
                                return isFree&&hasVision;
                            }).map(m=>m.id);
                            resolve(models);
                        } catch(e){reject(e);}
                    },
                    onerror:()=>reject(new Error('Network error')), ontimeout:()=>reject(new Error('Timeout'))
                });
            });
        } catch(err) { console.warn('[NHAPMA OCR] Không fetch được model list:',err.message); }
        const merged=[...HARDCODED_FREE_VISION_MODELS];
        for (const m of dynamicModels) { if(!merged.includes(m)) merged.push(m); }
        setStatus(`📋 ${merged.length} model sẵn sàng`,'#9b59b6');
        return merged;
    }

    function callAIModel(base64, mime, model) {
        const PROMPT=`Read the website URL or domain that is visibly printed in the image.
    Transcribe exactly what you can see. Do not guess, autocomplete, invent, or use a URL from your training data.
    Return exactly ONE URL/domain and absolutely nothing else: no explanation, no label, no quotes, no markdown, no punctuation.
    Valid examples: ugi.uk.com | https://ugi.uk.com | www.example.com/path
    If no complete URL/domain is clearly visible, return exactly: NONE`;
        return new Promise((resolve,reject) => {
            GM_xmlhttpRequest({
                method:'POST', url:'https://openrouter.ai/api/v1/chat/completions',
                headers:{'Content-Type':'application/json','Authorization':`Bearer ${API_KEY}`,'HTTP-Referer':'https://tampermonkey.net','X-Title':'NHAPMA OCR v1'},
                data:JSON.stringify({model,messages:[{role:'user',content:[{type:'image_url',image_url:{url:`data:${mime};base64,${base64}`,detail:'high'}},{type:'text',text:PROMPT}]}],max_tokens:120,temperature:0,top_p:1}),
                timeout:45000,
                onload: res => {
                    let data; try{data=JSON.parse(res.responseText);}catch(e){reject(new Error('JSON parse lỗi'));return;}
                    if (data.error){const errMsg=typeof data.error==='object'?(data.error.message||JSON.stringify(data.error)):String(data.error);if(errMsg.includes('rate')||errMsg.includes('429')||errMsg.includes('quota')){reject(new Error('RATE_LIMIT: '+errMsg));}else{reject(new Error(errMsg));}return;}
                    if (res.status<200||res.status>=300){reject(new Error('HTTP '+res.status));return;}
                    const text=data?.choices?.[0]?.message?.content?.trim();
                    if (!text||text.toUpperCase()==='NONE'||text.length<2){reject(new Error('Phản hồi rỗng hoặc NONE'));return;}
                    const extracted=extractURLFromAIText(text);
                    const usedModel=data?.model||model;
                    console.log(`[NHAPMA OCR][${model.split('/').pop()}] Raw: "${text}" → Extracted: "${extracted}"`);
                    if (!extracted||extracted.length<4){reject(new Error('Không extract được URL từ: '+text.substring(0,60)));return;}
                    resolve({text:extracted,rawText:text,usedModel});
                },
                onerror:()=>reject(new Error('Mất kết nối')), ontimeout:()=>reject(new Error('Timeout 45s'))
            });
        });
    }

    async function tryAIModels(base64, mime, models, setStatus) {
        const errors=[];
        for (let i=0; i<models.length; i++) {
            const model=models[i], shortName=model.split('/').pop().replace(':free','');
            setStatus(`🤖 [${i+1}/${models.length}] ${shortName}`,'#3498db');
            try {
                const result=await callAIModel(base64,mime,model);
                if (result.text&&result.text.length>3&&!result.text.includes('NONE')) return result;
                errors.push(`${shortName}: kết quả không hợp lệ "${result.text}"`);
            } catch(err) {
                const errMsg=err.message||String(err);
                errors.push(`${shortName}: ${errMsg}`);
                console.warn(`[NHAPMA OCR][SKIP] ${model}: ${errMsg}`);
                const delay=errMsg.includes('RATE_LIMIT')?200:300;
                if (i<models.length-1){setStatus(`⏩ Skip ${shortName}...`,'#f39c12');await sleep(delay);}
            }
        }
        throw new Error(`Đã thử ${models.length} model.\nLỗi cuối: ${errors.slice(-3).join(' | ')}`);
    }

    // ─── XÓA QUẢNG CÁO ───────────────────────────────────────────────────
    function removeAds() {
        try {
            document.querySelectorAll('div.mb-6.text-center').forEach(div => {
                if (div.querySelector('a[href*="muabit.com"]')) div.remove();
            });
            document.querySelectorAll('a[href*="muabit.com"], a[href*="zpi.cx"]').forEach(a => {
                let node=a;
                for (let i=0;i<4;i++){const parent=node.parentElement;if(!parent||parent===document.body)break;if(parent.children.length<=3){node=parent;}else break;}
                node.remove();
            });
            document.querySelectorAll('[class*="ads"],[class*="ad-"],[id*="ads"],[id*="banner"]').forEach(el=>{
                if(el.offsetHeight>0&&el.offsetHeight<200&&!el.querySelector('input,button[type="submit"]'))el.style.display='none';
            });
        } catch(e) { console.warn('[NHAPMA OCR] removeAds lỗi:',e); }
    }

    // ─── MAIN AI SCAN ─────────────────────────────────────────────────────
    async function runAIScan(setStatus, urlBox, autoOpen) {
        if (window._ocrUI) { window._ocrUI.lastScannedImgKey=null; window._ocrUI.lastScannedImgSrc=null; }
        setStatus('🧹 Xóa quảng cáo...','#f1c40f');
        removeAds(); await sleep(400);

        // Link4m chỉ OCR ảnh trong vị trí đã chỉ định; trang cũ vẫn quét meta/DOM.
        if (!isOnLink4m) {
            const metaURLs=scanPageMetaURLs();
            if (metaURLs.length){
                urlBox.value=metaURLs[0];
                setStatus('✅ Meta/OG: '+metaURLs[0],'ok');
                showCandidates(metaURLs);
                if (autoOpen) _triggerAutoOpen(metaURLs[0]);
                return;
            }

            const domURLs=quickScanDOMForURL().filter(u=>!u.includes('nhapma')&&!u.includes('google.com/url'));
            if (domURLs.length){
                const m=fuzzyMatch(domURLs[0]);
                urlBox.value=m.url||domURLs[0];
                setStatus('✅ DOM: '+domURLs.length+' URL tìm thấy','ok');
                showCandidates(domURLs);
                if (autoOpen) _triggerAutoOpen(m.url||domURLs[0]);
                return;
            }
        }

        // 3. Image cache
        const cacheImages = isOnLink4m ? [findTargetImage()].filter(Boolean) : [...document.images];
        for (const img of cacheImages){
            const cached=lookupImgURL(img.src);
            if(cached){
                const m=fuzzyMatch(cached);
                urlBox.value=m.url||cached;
                if(window._ocrUI){window._ocrUI.selectedImgKey=normKey(img.src);window._ocrUI.lastScannedImgKey=normKey(img.src);window._ocrUI.lastScannedImgSrc=img.src;}
                setStatus('✅ Cache hit!','ok');
                if (autoOpen) _triggerAutoOpen(m.url||cached);
                return;
            }
        }

        // 4. Tìm ảnh target
        setStatus('🔍 Tìm ảnh target...','#f1c40f');
        await sleep(1000);
        const img=findTargetImage();
        if (!img){setStatus('❌ Không tìm thấy ảnh target!','#e74c3c');return;}
        const imgSrc=img.src;
        if (window._ocrUI){window._ocrUI.lastScannedImgSrc=imgSrc;window._ocrUI.lastScannedImgKey=normKey(imgSrc);}
        console.log('[NHAPMA OCR] Ảnh target:',imgSrc);

        // 5. Tải ảnh
        setStatus('📥 Tải ảnh...','#f1c40f');
        let imgData;
        try { imgData=await fetchBase64(imgSrc); setStatus(`📥 Ảnh OK (${imgData.mime})`,'#f1c40f'); }
        catch(err){ setStatus('❌ Lỗi tải ảnh: '+err.message,'#e74c3c'); return; }

        // 6. Lấy danh sách model
        let models;
        try { models=await getVisionModels(setStatus); await sleep(200); }
        catch(err){ models=[...HARDCODED_FREE_VISION_MODELS]; setStatus(`⚠️ Dùng ${models.length} model hardcode...`,'#f39c12'); }

        // 7. Gọi AI
        try {
            const {text,rawText,usedModel}=await tryAIModels(imgData.base64,imgData.mime,models,setStatus);
            const isValid=isValidURL(text.startsWith('http')?text:'https://'+text);
            let finalURL=isValid?cleanURL(text):text;
            const matched=fuzzyMatch(finalURL);
            if (matched.matched) finalURL=matched.url;
            urlBox.value=finalURL;
            if (imgSrc){saveImgURL(imgSrc,finalURL,1);if(window._ocrUI)window._ocrUI.selectedImgKey=normKey(imgSrc);}
            const modelShort=usedModel.split('/').pop().replace(':free','');
            const matchInfo=matched.matched?`Matched ${Math.round(matched.score*100)}%`:`Model: ${modelShort}`;
            const validMark=isValid?'✅':'⚠️';
            setStatus(`${validMark} ${matchInfo} → ${finalURL}`,'ok');
            console.log('[NHAPMA OCR] Result:',{finalURL,rawText,usedModel,isValid,matched});
            // [MỚI] Tự động mở URL sau khi AI scan xong
            if (autoOpen && isValid) _triggerAutoOpen(finalURL);
        } catch(err){ setStatus('❌ AI lỗi: '+err.message,'#e74c3c'); console.error('[NHAPMA OCR] Scan thất bại:',err); }
    }

    // ─── [MỚI] AUTO-OPEN SAU KHI SCAN ────────────────────────────────────
    // Đếm ngược 3s rồi tự click OPEN (cho phép người dùng cancel)
    function _triggerAutoOpen(url) {
        if (!url) return;
        const shell = document.getElementById('ocr-shell-nm');
        if (!shell) return;

        // Hủy auto-open cũ nếu đang chạy
        if (window._ocrAutoOpenTimer) {
            clearInterval(window._ocrAutoOpenTimer);
            window._ocrAutoOpenTimer = null;
        }

        let secs = 3;
        const openBtn = shell.querySelector('#ocr-btn-open-nm');
        const origText = openBtn ? openBtn.textContent : 'OPEN';

        const doOpen = () => {
            clearInterval(window._ocrAutoOpenTimer);
            window._ocrAutoOpenTimer = null;
            if (openBtn) openBtn.textContent = origText;
            addURL(url);
            const autoBar = shell.querySelector('#ocr-autobar-nm');
            if (autoBar) {
                autoBar.style.display = 'block';
                autoBar.textContent = 'Đang mở URL đã quét...';
            }
            window.open('https://www.google.com/url?q=' + encodeURIComponent(url), TAB_NAME);
        };

        // Đếm ngược hiện trên nút OPEN
        if (openBtn) openBtn.textContent = `AUTO (${secs}s)`;
        window._ocrAutoOpenTimer = setInterval(() => {
            secs--;
            if (secs <= 0) {
                doOpen();
            } else {
                if (openBtn) openBtn.textContent = `AUTO (${secs}s)`;
            }
        }, 1000);

        // Click vào nút OPEN bất kỳ lúc nào cũng hủy timer và mở luôn
        // (đã được xử lý tự nhiên vì click sẽ gọi doOpen qua btn.click())
    }

    // ─── COUNTDOWN WATCHER ────────────────────────────────────────────────
    function startCountdownWatcher() {
        let overlayEl=null;
        const getOrCreate=()=>{
            if(overlayEl&&document.body.contains(overlayEl))return overlayEl;
            overlayEl=document.createElement('div'); overlayEl.id='nhapma-countdown-v1';
            overlayEl.style.cssText='position:fixed;bottom:16px;right:16px;background:linear-gradient(135deg,#0d0d12,#13131c);border:1px solid rgba(255,102,0,.4);border-radius:12px;padding:10px 20px;font-family:"Orbitron",monospace;font-size:24px;font-weight:900;color:#ff6600;z-index:9999998;box-shadow:0 0 30px rgba(255,102,0,.25),inset 0 1px 0 rgba(255,102,0,.1);text-align:center;min-width:100px;display:none;text-shadow:0 0 15px rgba(255,102,0,.8);letter-spacing:2px;';
            document.body.appendChild(overlayEl); return overlayEl;
        };
        const tick=()=>{
            const endStr=localStorage.getItem(COUNTDOWN_KEY), ov=getOrCreate();
            if(!endStr){ov.style.display='none';setTimeout(tick,500);return;}
            const remaining=Math.ceil((parseInt(endStr)-Date.now())/1000);
            if(remaining<=0){localStorage.removeItem(COUNTDOWN_KEY);ov.style.display='none';setTimeout(tick,500);return;}
            ov.style.display='block';ov.textContent=remaining+'s';setTimeout(tick,300);
        };
        tick();
    }

    // ─── [SỬA] CAPTCHA WATCHER ────────────────────────────────────────────
    function startCaptchaWatcher(setStatus, autoBar) {
        let watching=false, solved=false, solvedTimer=null;
        const log=(msg,type)=>{if(setStatus)setStatus(msg,type||'ok');if(autoBar)autoBar.textContent=msg;};
        const PRESENT_SEL=['iframe[src*="hcaptcha.com"]','.h-captcha','iframe[src*="recaptcha"]','.g-recaptcha','iframe[src*="challenges.cloudflare.com"]','.cf-turnstile'].join(',');

        function isSolved(){
            for(const s of['textarea[id^="h-captcha-response"]','textarea[name="h-captcha-response"]','textarea[id^="g-recaptcha-response"]','textarea[name="g-recaptcha-response"]']){
                const el=document.querySelector(s);if(el&&el.value&&el.value.length>10)return true;
            }
            for(const s of['input[name="cf-turnstile-response"]','input[name="cf_turnstile_response"]']){
                const el=document.querySelector(s);if(el&&el.value&&el.value.length>10)return true;
            }
            return false;
        }

        function findContinueLink(){
            return [...document.querySelectorAll('a.get-link, a[href*="/activate_link/"]')].find(link => {
                if (link.offsetParent === null) return false;
                const text = (link.innerText || link.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
                return text.includes('click vào đây để tiếp tục') || text.includes('click vao day de tiep tuc') || link.classList.contains('get-link');
            }) || null;
        }

        // [SỬA] Tìm nút "Xác Nhận Và Tiếp Tục" không bị disabled
        function findXacNhanBtn() {
            // Tìm chính xác theo text "Xác Nhận Và Tiếp Tục" hoặc "Xác Nhận"
            const allSubmit = [...document.querySelectorAll('button[type="submit"]')].filter(b => {
                if (b.disabled) return false;
                if (b.offsetParent === null) return false;
                return true;
            });
            // Ưu tiên button có text "Xác Nhận Và Tiếp Tục"
            const xacNhanTiepTuc = allSubmit.find(b => {
                const t = (b.innerText || b.textContent || '').trim();
                return t.includes('Xác Nhận Và Tiếp Tục') || t.includes('Xac Nhan Va Tiep Tuc');
            });
            if (xacNhanTiepTuc) return xacNhanTiepTuc;
            // Fallback: text "Xác Nhận"
            const xacNhan = allSubmit.find(b => {
                const t = (b.innerText || b.textContent || '').trim();
                return t.includes('Xác Nhận') || t.includes('xac nhan');
            });
            if (xacNhan) return xacNhan;
            // Fallback cuối: bất kỳ submit visible không disabled
            return allSubmit[0] || null;
        }

        async function onSolved(){
            if(solved)return; solved=true;
            log('✅ Captcha solved! Đang tìm link tiếp tục...');
            const deadline = Date.now() + 20000;
            let continueLink = null;
            while (Date.now() < deadline) {
                continueLink = findContinueLink();
                if (continueLink) break;
                await sleep(300);
            }
            if (continueLink) {
                simClick(continueLink);
                log('✅ Đã click "Click vào đây để tiếp tục"', 'ok');
            } else {
                log('❌ Không thấy link tiếp tục', 'err');
            }
        }

        function startWatching(){
            if(watching)return; watching=true; solved=false;
            log('⏳ Chờ giải captcha...');
            const iv=setInterval(()=>{
                if(isSolved()){
                    clearInterval(iv); watching=false;
                    if(solvedTimer)clearTimeout(solvedTimer);
                    solvedTimer=setTimeout(()=>onSolved(),300);
                }
            },600);
            setTimeout(()=>{clearInterval(iv);watching=false;},300000);
        }

        const obs=new MutationObserver(()=>{
            const has=!!document.querySelector(PRESENT_SEL);
            if(has) startWatching();
            else if(!has&&watching){watching=false;solved=false;if(solvedTimer){clearTimeout(solvedTimer);solvedTimer=null;}}
        });
        obs.observe(document.body,{childList:true,subtree:true,attributes:true});
        if(document.querySelector(PRESENT_SEL)) startWatching();
    }

    // [MỚI] Sau khi click "Xác Nhận Và Tiếp Tục", xử lý bước tiếp theo
    async function _afterXacNhan(log) {
        // Chờ trang chuyển hoặc nút tiếp theo xuất hiện (tối đa 20s)
        const deadline = Date.now() + 20000;
        while (Date.now() < deadline) {
            // Tìm nút #submit-button (nút tiếp tục cũ trong flow)
            const sub = document.querySelector('#submit-button');
            if (sub && sub.offsetParent !== null && !sub.disabled) {
                await sleep(400);
                simClick(sub);
                if (log) log('✅ Hoàn tất!', 'ok');
                const autoBar = document.getElementById && document.querySelector('#ocr-autobar-nm');
                if (autoBar) autoBar.style.display = 'none';
                return;
            }
            // Kiểm tra nếu trang đã chuyển hướng hoặc thành công
            const successEl = document.querySelector('[class*="success"],[class*="complete"],[class*="done"]');
            if (successEl && successEl.offsetParent !== null) {
                if (log) log('✅ Hoàn tất!', 'ok');
                return;
            }
            await sleep(500);
        }
        if (log) log('⏳ Chờ bước tiếp theo...', '');
    }

