    async function scrollSlowlyForWhatOn(seconds, direction) {
        const end = Date.now() + seconds * 1000;
        const startY = window.scrollY;
        const targetY = direction === 'up'
            ? 0
            : Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        localStorage.setItem(COUNTDOWN_KEY, String(end));
        while (Date.now() < end) {
            const progress = Math.min(1, (Date.now() - (end - seconds * 1000)) / (seconds * 1000));
            window.scrollTo({
                top: startY + (targetY - startY) * progress,
                left: 0,
                behavior: 'auto'
            });
            await sleep(100);
        }
        window.scrollTo({top: targetY, left: 0, behavior: 'auto'});
        localStorage.removeItem(COUNTDOWN_KEY);
    }

    function getWhatOnCodeData() {
        const el = document.querySelector('.whatoncode');
        if (!el || el.offsetParent === null) return null;
        const text = (el.textContent || '').replace(/\s+/g, ' ').trim();
        const match = text.match(/Vui lòng chờ\s+(\d+)s/i);
        if (!match) return null;
        return {
            el,
            sec: parseInt(match[1], 10),
            direction: /kéo xuống/i.test(text) ? 'down' : /kéo lên/i.test(text) ? 'up' : null
        };
    }

    async function runWhatOnCodeCountdown(data) {
        const totalMs = data.sec * 1000;
        const startedAt = Date.now();
        const startY = window.scrollY;
        const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        const stepMs = 120;
        let lastShown = data.sec + 1;

        while (Date.now() - startedAt < totalMs) {
            const elapsed = Date.now() - startedAt;
            const progress = Math.min(1, elapsed / totalMs);
            const remaining = Math.max(0, Math.ceil((totalMs - elapsed) / 1000));
            if (remaining !== lastShown) {
                lastShown = remaining;
                showToast(`⏳ ${remaining}s`);
            }

            const current = getWhatOnCodeData();
            const direction = current?.direction || data.direction;
            const targetY = direction === 'up' ? 0 : maxY;
            const nextY = startY + (targetY - startY) * progress;
            window.scrollTo({top: nextY, left: 0, behavior: 'auto'});
            await workerSleep(stepMs);
        }

        window.scrollTo({top: data.direction === 'up' ? 0 : maxY, left: 0, behavior: 'auto'});
        showToast('⏳ 0s');
    }

    function extractCodeFromPage() {
        const ORANGE_RE=/rgb\(255,\s*102,\s*0\)/;
        for(const el of document.querySelectorAll('div,span,button,p')){
            if(el.offsetParent===null)continue;
            const text=(el.textContent||'').trim();
            if(!/^[A-Z0-9]{4,12}$/.test(text))continue;
            const bg=window.getComputedStyle(el).backgroundColor.replace(/\s/g,'');
            if(ORANGE_RE.test(bg))return text;
            const rgb=bg.match(/rgb\((\d+),(\d+),(\d+)\)/);
            if(rgb){const r=parseInt(rgb[1]),g=parseInt(rgb[2]),b=parseInt(rgb[3]);if(r>200&&g>50&&g<150&&b<50)return text;}
        }
        for(const el of document.querySelectorAll('div,span')){
            if(el.offsetParent===null)continue;
            const text=(el.textContent||'').trim();
            if(/^[A-Z0-9]{6,12}$/.test(text)){
                const parent=el.parentElement;
                if(parent&&parent.children.length<=3)return text;
            }
        }
        return null;
    }

