            showToast(`Chờ nút LẤY MÃ... (${i + 1}/60)`);
        }
        if (!button) { showToast('Không tìm thấy nút LẤY MÃ!'); return; }

        simClick(button);
        await workerSleep(1500);

        if (!secondClick) {
            sessionStorage.setItem(TARGET_STATE_KEY, 'clicked');
            let countdownSec = 0;
            let whatOn = null;
            for (let attempt = 0; attempt < 60; attempt++) {
                whatOn = getWhatOnCountdown();
                if (whatOn) { countdownSec = whatOn.seconds; break; }
                const found = getCountdownData();
                if (found) { countdownSec = found.sec; break; }
                await workerSleep(500);
            }
            if (!countdownSec) { showToast('Không đọc được countdown!'); return; }
            showToast(`Đếm ngược: ${countdownSec}s`);
            if (whatOn && whatOn.direction) {
                await scrollSlowlyForWhatOn(countdownSec, whatOn.direction);
            } else {
                await workerSleep(countdownSec * 1000, remMs => showToast(`⏳ ${Math.ceil(remMs / 1000)}s...`));
            }
            location.reload();
            return;
        }

        showToast('Đã click lần 2, đang tìm Mã KM...');
        let code = null;
        for (let attempt = 0; attempt < 40; attempt++) {
            code = extractPromoCode();
            if (code) break;
            await workerSleep(500);
        }
        sessionStorage.removeItem(TARGET_STATE_KEY);
        if (!code) { showToast('Không tìm thấy Mã KM!'); return; }

        sendCodeToMenu(code);
        showToast(`Mã KM: ${code}\nĐã gửi về menu. Đóng tab sau 3s...`);
        await workerSleep(3000);
        window.close();
    }

    // ─── ENTRY POINT ──────────────────────────────────────────────────────
    if(isOnLink4m){
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',createUI);
        else createUI();
    } else if(isTargetPage){
        preventThrottling();
        const runFlow=()=>setTimeout(clickOnTargetSite,3000);
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',runFlow);
        else runFlow();
    }

})();
