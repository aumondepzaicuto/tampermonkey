    header.append(title, logo, headActions);

    // BODY
    const body = make('div', { id: 'dva-body' });

    // Hidden configuration
    const hiddenSettings = make('div', { id: 'dva-hidden-settings' });

    const providerInput = make('select', { id: 'dva-provider' });
    Object.entries(PROVIDERS).forEach(([id, cfg]) => {
        providerInput.appendChild(make('option', { value: id }, cfg.name));
    });

    const keyInput = make('input', { id: 'dva-key', type: 'text' });

    const modelInput = make('select', { id: 'dva-model' });
    modelInput.appendChild(make('option', { value: 'all' }, 'Đối chiếu nhiều model'));

    const promptInput = make('textarea', { id: 'dva-prompt' });

    hiddenSettings.append(providerInput, keyInput, modelInput, promptInput);

    // ACTIONS
    const actions = make('div', { id: 'dva-actions' });
    const startButton = make('button', { id: 'dva-start' }, '▶ BẮT ĐẦU');
    const stopButton = make('button', { id: 'dva-stop' }, '■ DỪNG');
    const copyButton = make('button', { id: 'dva-copy' }, '⧉ COPY');
    actions.append(startButton, stopButton, copyButton);

    // OPTIONS
    const options = make('div', { id: 'dva-options' });

    const autoFillLabel = make('label', { className: 'dva-check' });
    const autofillInput = make('input', { id: 'dva-autofill', type: 'checkbox' });
    autofillInput.checked = settings.autofill !== false;
    const autoFillText = make('span', {}, 'AUTO KẾT QUẢ');
    autoFillLabel.append(autofillInput, autoFillText);

    const autoSubmitLabel = make('label', { className: 'dva-check dva-check-submit' });
    const autosubmitInput = make('input', { id: 'dva-autosubmit', type: 'checkbox' });
    autosubmitInput.checked = settings.autosubmit === true;
    const autoSubmitText = make('span', {}, 'AUTO NỘP');
    autoSubmitLabel.append(autosubmitInput, autoSubmitText);

    options.append(autoFillLabel, autoSubmitLabel);

    // PROGRESS / STATUS / RESULT
    const progress = make('progress', { id: 'dva-progress', max: '100', value: '0' });

    // FIX 1 (tiếp): KHÔNG khai báo lại percent ở đây.
    // setProgress dùng trực tiếp biến percent khai báo phía trên.
    function setProgress(value) {
        value = Math.max(0, Math.min(100, Math.round(value)));
        progress.value = value;
        percent.textContent = `${value}%`;
    }

    const status = make('div', { id: 'dva-status' }, 'SYSTEM READY // Chờ lệnh...');
    const result = make('div', { id: 'dva-result' }, 'Kết quả AI sẽ xuất hiện ở đây.');

    body.append(hiddenSettings, actions, options, progress, status, result);

    panel.append(header, body, percent);
    document.body.appendChild(panel);

    // ========================================================
    // REFERENCES
    // ========================================================
    const hasOption = value => [...modelInput.options].some(option => option.value === value);

    const fillModels = list => {
        modelInput.replaceChildren(
            make('option', { value: 'all' }, `Đối chiếu ${Math.min(MAX_ALL, list.length)} model đầu`),
            ...list.map(id => make('option', { value: id }, id))
        );
    };

    const loadProvider = async preferredModel => {
        const id = providerInput.value;
        const cfg = PROVIDERS[id];
        fillModels(cfg.models);
        modelInput.value = hasOption(preferredModel) ? preferredModel : 'all';
        const list = await listModels(cfg, keyInput.value.trim());
        if (providerInput.value !== id) return;
        const current = modelInput.value;
        fillModels(list);
        modelInput.value = hasOption(current) ? current : 'all';
    };

    // LOAD OLD SETTINGS
    providerInput.value = settings.provider;
    keyInput.value = getKey(settings.provider);
    promptInput.value = settings.prompt;
    loadProvider(settings.model);

    // SETTINGS EVENTS
    providerInput.onchange = () => {
        settings.provider = providerInput.value;
        settings.model = 'all';
        saveSettings();
        keyInput.value = getKey(providerInput.value);
        loadProvider('all');
    };

    keyInput.onchange = () => {
        store.set(`dva-key-${providerInput.value}`, keyInput.value.trim());
        loadProvider(modelInput.value);
    };

    promptInput.onchange = () => {
        settings.prompt = promptInput.value.trim();
        saveSettings();
    };

    modelInput.onchange = () => {
        settings.model = modelInput.value;
        saveSettings();
    };

    autofillInput.onchange = () => {
        settings.autofill = autofillInput.checked;
        saveSettings();
    };

    autosubmitInput.onchange = () => {
        settings.autosubmit = autosubmitInput.checked;
        saveSettings();
    };

    // ========================================================
    // COLLAPSE / EXPAND
    // ========================================================
    let collapseTimer;
    let activeControl = null;
    // FIX 3: cờ phân biệt click thật vs kéo
    let didDrag = false;

    const collapse = () => {
        panel.classList.add('dva-collapsed');
        panel.style.transform = 'none';
        clearTimeout(collapseTimer);
    };

    const expand = () => {
        panel.classList.remove('dva-collapsed');
        // giữ vị trí ổn định sau khi expand (tránh nhảy do CSS translateY)
        panel.style.transform = 'none';
        clearTimeout(collapseTimer);
        collapseTimer = setTimeout(collapse, 15000);
    };

    const resetCollapseTimer = () => {
        if (!panel.classList.contains('dva-collapsed')) {
            clearTimeout(collapseTimer);
            collapseTimer = setTimeout(collapse, 15000);
        }
    };

    panel.classList.add('dva-collapsed');

    // FIX 3: dùng cờ didDrag thay vì so sánh tọa độ sai
    panel.addEventListener('click', event => {
        if (!panel.classList.contains('dva-collapsed')) return;
        if (event.target.closest('button')) return;
        if (didDrag) { didDrag = false; return; }
        expand();
    });

    panel.addEventListener('pointerdown', resetCollapseTimer);
    panel.addEventListener('input', resetCollapseTimer);

    panel.querySelector('#dva-close').onclick = event => {
        event.stopPropagation();
        collapse();
    };

    panel.querySelector('#dva-smaller').onclick = event => {
        event.stopPropagation();
        panel.style.width = `${Math.max(300, panel.offsetWidth - 40)}px`;
        panel.style.height = `${Math.max(180, panel.offsetHeight - 30)}px`;
        resetCollapseTimer();
    };

    panel.querySelector('#dva-larger').onclick = event => {
        event.stopPropagation();
        panel.style.width = `${Math.min(Math.round(window.innerWidth * .8), panel.offsetWidth + 40)}px`;
        panel.style.height = `${Math.min(Math.round(window.innerHeight * .8), panel.offsetHeight + 30)}px`;
        resetCollapseTimer();
    };

    // ========================================================
    // DRAG
    // ========================================================
    let dragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    const dragTarget = panel.querySelector('#dva-head');

    dragTarget.addEventListener('pointerdown', event => {
        if (event.target.closest('button')) return;

        const rect = panel.getBoundingClientRect();

        panel.style.transform = 'none';
        panel.style.left = `${rect.left}px`;
        panel.style.top = `${rect.top}px`;

        dragOffsetX = event.clientX - rect.left;
        dragOffsetY = event.clientY - rect.top;

        dragging = true;
        didDrag = false; // reset cờ, chỉ set true khi move thực sự
        panel.setPointerCapture(event.pointerId);
        event.preventDefault();
    });

    panel.addEventListener('pointermove', event => {
        if (!dragging) return;

        // FIX 3: đánh dấu đã kéo nếu di chuyển quá ngưỡng
        if (!didDrag) {
            const dx = Math.abs(event.movementX || 0);
            const dy = Math.abs(event.movementY || 0);
            if (dx + dy > 0) didDrag = true;
        }

        const width = panel.classList.contains('dva-collapsed') ? 32 : panel.offsetWidth;
        const height = panel.classList.contains('dva-collapsed') ? 40 : panel.offsetHeight;

        const maxX = window.innerWidth - width;
        const maxY = window.innerHeight - height;

        const newX = Math.min(maxX, Math.max(0, event.clientX - dragOffsetX));
        const newY = Math.min(maxY, Math.max(0, event.clientY - dragOffsetY));

        panel.style.left = `${newX}px`;
        panel.style.top = `${newY}px`;

        event.preventDefault();
    });

    panel.addEventListener('pointerup', event => {
        dragging = false;
        try { panel.releasePointerCapture(event.pointerId); } catch (_) {}
        resetCollapseTimer();
    });

    panel.addEventListener('pointercancel', () => {
        dragging = false;
    });

    // ========================================================
    // STOP
    // ========================================================
    stopButton.onclick = event => {
        event.stopPropagation();
        if (!activeControl) return;
        activeControl.stopped = true;
        if (activeControl.request) activeControl.request.abort();
        status.textContent = 'SYSTEM STOPPED // Đã dừng.';
        status.classList.remove('dva-error');
        startButton.disabled = false;
        stopButton.disabled = true;
    };

    // ========================================================
    // START
    // ========================================================
    startButton.onclick = async event => {
        event.stopPropagation();

        const cfg = PROVIDERS[providerInput.value];
        const apiKey = keyInput.value.trim();

        settings.provider = providerInput.value;
        settings.model = modelInput.value;
        settings.prompt = promptInput.value.trim();
        settings.autofill = autofillInput.checked;
        settings.autosubmit = autosubmitInput.checked;
        saveSettings();

        const control = { stopped: false, request: null };
        activeControl = control;

        startButton.disabled = true;
        stopButton.disabled = false;

        // FIX 2: dùng setProgress để sync cả thanh và % text
        setProgress(5);
        status.classList.remove('dva-error');
        status.textContent = 'SCANNING DOM // Đang đọc Google Forms...';
        result.textContent = '';

        try {
            if (!apiKey) throw new Error(`Chưa có API key. ${cfg.hint}`);
            store.set(`dva-key-${providerInput.value}`, apiKey);

            const questions = collectFormQuestions();
            if (!questions.length) throw new Error('Không tìm thấy câu hỏi/lựa chọn trong DOM.');

            const domText = renderQuestionsForPrompt(questions);
            setProgress(35);
            if (control.stopped) return;

            let models = [settings.model];
            if (settings.model === 'all') {
                status.textContent = 'MODEL SCAN // Đang tải model...';
                models = (await listModels(cfg, apiKey)).slice(0, MAX_ALL);
                if (!models.length) throw new Error('Chưa có model nào để gửi.');
            }

            const outputs = [];
            let applied = null;

            for (let index = 0; index < models.length; index += 1) {
                if (control.stopped) return;
                const model = models[index];

                status.textContent = `AI LINK // ${index + 1}/${models.length} // ${model}`;
                setProgress(55 + Math.round((index / models.length) * 40));

                try {
                    const answer = await requestAI(
                        domText,
                        settings.prompt || 'Phân tích các câu hỏi và đưa ra đáp án gợi ý để tôi tự kiểm tra.',
                        model,
                        control,
                        cfg,
                        apiKey
                    );

                    outputs.push(`[${model}]\n${answer}`);

                    if (autofillInput.checked && !applied) {
                        const map = parseAnswers(answer, questions.length);
                        if (map) applied = applyAnswers(questions, map);
                    }
                } catch (error) {
                    if (control.stopped) return;
                    outputs.push(`[${model}] LỖI: ${error.message}`);
                }

                result.textContent = outputs.join('\n\n');
            }

            result.textContent = outputs.join('\n\n');

            if (!control.stopped) {
                setProgress(100);
                let statusMsg = `AI COMPLETE // ${models.length} model`;

                if (applied) {
                    statusMsg += ` // Auto ${applied.applied.length}/${questions.length}`;
                    if (applied.failed.length) {
                        statusMsg += ` // Fail: ${applied.failed.join(', ')}`;
                    }
                } else if (autofillInput.checked) {
                    statusMsg += ' // Không parse được JSON';
                }

                status.textContent = statusMsg;

                // AUTO SUBMIT
                if (
                    autosubmitInput.checked &&
                    applied &&
                    applied.applied.length > 0 &&
                    applied.failed.length === 0
                ) {
                    await new Promise(resolve => setTimeout(resolve, 1000));
                    if (!control.stopped) {
                        await autoSubmitForm(status, control);
                    }
                }
            }
        } catch (error) {
            if (!control.stopped) {
                status.textContent = `SYSTEM ERROR // ${error.message}`;
                status.classList.add('dva-error');
            }
            result.textContent = '';
        } finally {
            if (control.stopped) setProgress(0);
            startButton.disabled = false;
            stopButton.disabled = true;
            activeControl = null;
        }
    };

    // ========================================================
    // COPY
    // ========================================================
    copyButton.onclick = async () => {
        if (!result.textContent || result.textContent === 'Kết quả AI sẽ xuất hiện ở đây.') return;
        try {
            await navigator.clipboard.writeText(result.textContent);
            status.textContent = 'CLIPBOARD // Đã copy kết quả.';
        } catch (_) {
            status.textContent = 'Không thể copy tự động.';
        }
    };

    stopButton.disabled = true;
})();
