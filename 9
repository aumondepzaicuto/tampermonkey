(function () {
    'use strict';

    const STORAGE_KEY = 'dom-vision-assistant-settings-v2';
    const MAX_ALL = 3;

    const PROVIDERS = {
        openrouter: {
            name: 'OpenRouter',
            base: 'https://openrouter.ai/api/v1',
            models: [],
            pick: id => id.endsWith(':free'),
            hint: 'OpenRouter model :free',
            // FIX 4: key mặc định để script chạy được dù UI ẩn
            defaultKey: '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'
        }
    };

    const store = {
        get(key, fallback = '') {
            try {
                return typeof GM_getValue === 'function'
                    ? GM_getValue(key, fallback)
                    : (localStorage.getItem(key) ?? fallback);
            } catch (_) { return fallback; }
        },
        set(key, value) {
            try {
                if (typeof GM_setValue === 'function') GM_setValue(key, value);
                else localStorage.setItem(key, value);
            } catch (_) {}
        }
    };

    const getKey = provider =>
        store.get(`dva-key-${provider}`, PROVIDERS[provider].defaultKey || '');

    function loadSettings() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
        catch (_) { return {}; }
    }

    const settings = Object.assign({
        provider: 'openrouter',
        model: 'all',
       prompt:
    'Bạn là chuyên gia phân tích câu hỏi trắc nghiệm. ' +
    'Đọc kỹ từng câu hỏi và toàn bộ đáp án, suy luận cẩn thận rồi chọn ra đáp án ĐÚNG nhất về mặt kiến thức. ' +
    'Nếu không chắc chắn tuyệt đối, vẫn phải chọn phương án khả thi nhất — không bỏ trống, không từ chối bất kỳ câu nào. ' +
    'Chỉ trả về DUY NHẤT một dòng JSON hợp lệ, đúng nguyên format sau, không sai một ký tự: ' +
    '{"answers":[{"q":1,"choice":"A"},{"q":2,"choice":"C"}]} ' +
    'Tuyệt đối KHÔNG giải thích, không chú thích, không bọc trong code block hay markdown nào khác, không xuống dòng thừa, không ký tự nào ngoài chuỗi JSON.',
        autofill: true,
        autosubmit: false
    }, loadSettings());

    delete settings.apiKey;
    if (!PROVIDERS[settings.provider]) settings.provider = 'openrouter';

    function saveSettings() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    // ============================================================
    // MODEL
    // ============================================================
    function fetchModels(cfg, key) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'GET',
                url: `${cfg.base}/models`,
                headers: key ? { Authorization: `Bearer ${key}` } : {},
                timeout: 20000,
                onload: response => {
                    try {
                        const data = JSON.parse(response.responseText);
                        if (response.status < 200 || response.status >= 300) {
                            throw new Error(`HTTP ${response.status}`);
                        }
                        const ids = (data.data || [])
                            .map(model => String(model.id || '').replace(/^models\//, ''))
                            .filter(cfg.pick);
                        resolve([...new Set(ids)]);
                    } catch (error) { reject(error); }
                },
                onerror: () => reject(new Error('Không tải được danh sách model')),
                ontimeout: () => reject(new Error('Timeout khi tải danh sách model'))
            });
        });
    }

    async function listModels(cfg, key) {
        if (!cfg.pick || (cfg.listNeedsKey && !key)) return cfg.models;
        try {
            return [...new Set([...cfg.models, ...await fetchModels(cfg, key)])];
        } catch (_) { return cfg.models; }
    }

    // ============================================================
    // GOOGLE FORMS DOM
    // ============================================================
    function collectFormQuestions() {
        const items = [...document.querySelectorAll('[role="listitem"]')];
        const questions = [];
        items.forEach(item => {
            const headingEl = item.querySelector('[role="heading"]');
            if (!headingEl) return;
            const heading = headingEl.textContent.replace(/\s+/g, ' ').trim();
            const optionEls = [...item.querySelectorAll('[role="radio"], [role="checkbox"]')];
            if (!optionEls.length) return;
            const options = optionEls.map(el => {
                const label = el.getAttribute('aria-label') || el.getAttribute('data-value') || el.textContent || '';
                return { text: label.replace(/\s+/g, ' ').trim(), element: el };
            }).filter(o => o.text);
            if (!heading || !options.length) return;
            questions.push({ index: questions.length + 1, heading, options });
        });
        return questions;
    }

    function renderQuestionsForPrompt(questions) {
        return questions.map(q => {
            const lines = q.options.map((o, i) => `   ${String.fromCharCode(65 + i)}. ${o.text}`);
            return `${q.index}. ${q.heading}\n${lines.join('\n')}`;
        }).join('\n\n');
    }

    // ============================================================
    // PARSE AI
    // ============================================================
    function parseAnswers(rawText, questionCount) {
        if (!rawText) return null;
        let text = rawText.trim();
        const fence = text.match(/```(?:json)?\s*([\s\S]*?)```/i);
        if (fence) text = fence[1].trim();
        const start = text.indexOf('{');
        const end = text.lastIndexOf('}');
        if (start === -1 || end === -1 || end <= start) return null;
        const candidate = text.slice(start, end + 1);
        let parsed;
        try { parsed = JSON.parse(candidate); }
        catch (_) { return null; }
        const arr = Array.isArray(parsed) ? parsed : parsed.answers;
        if (!Array.isArray(arr)) return null;
        const map = new Map();
        arr.forEach(entry => {
            const q = Number(entry.q ?? entry.question ?? entry.index);
            let choice = entry.choice ?? entry.answer ?? entry.a ?? entry.letter;
            if (typeof choice !== 'string' || !q) return;
            choice = choice.trim().toUpperCase();
            const letter = choice.match(/[A-Z]/);
            if (!letter) return;
            map.set(q, letter[0]);
        });
        let valid = 0;
        map.forEach((_, q) => { if (q >= 1 && q <= questionCount) valid++; });
        return valid ? map : null;
    }

    // ============================================================
    // CLICK OPTION
    // ============================================================
    function clickOption(optionEl) {
        if (!optionEl) return false;
        const label = optionEl.closest('label');
        try {
            if (label) { label.click(); return true; }
            optionEl.click();
            return true;
        } catch (_) { return false; }
    }

    function applyAnswers(questions, answerMap) {
        const applied = [];
        const failed = [];
        questions.forEach(q => {
            const letter = answerMap.get(q.index);
            if (!letter) { failed.push(q.index); return; }
            const idx = letter.charCodeAt(0) - 65;
            const option = q.options[idx];
            if (!option) { failed.push(q.index); return; }
            if (option.element.getAttribute('aria-checked') === 'true') {
                applied.push({ q: q.index, letter, text: option.text, skipped: true });
                return;
            }
            if (clickOption(option.element)) {
                applied.push({ q: q.index, letter, text: option.text });
            } else {
                failed.push(q.index);
            }
        });
        return { applied, failed };
    }

    // ============================================================
    // ERROR
    // ============================================================
    function explainError(status, data, raw, cfg) {
        const err = (Array.isArray(data) ? data[0] : data) || {};
        const detail = (
            err.error?.message ||
            err.message ||
            (typeof err.error === 'string' ? err.error : '') ||
            String(raw || '').slice(0, 160)
        ).trim();
        if (/free tier/i.test(detail)) return 'OpenRouter chặn model free (rate limit). Đổi model hoặc thử lại sau.';
        if (status === 401 || status === 403) return `${cfg.name} từ chối API key (HTTP ${status}). ${detail}`.trim();
        if (status === 402 || /balance|credit|billing|payment/i.test(detail)) return `Tài khoản chưa có credit/billing. ${detail}`;
        if (status === 404) return `Model không tồn tại hoặc không được bật cho key này. ${detail}`;
        if (status === 429) return `Hết hạn mức hoặc gọi quá nhanh (HTTP 429), thử lại sau. ${detail}`;
        return `HTTP ${status}${detail ? `: ${detail}` : ''}`;
    }

    // ============================================================
    // AI REQUEST
    // ============================================================
    function requestAI(domText, prompt, model, control, cfg, apiKey) {
        return new Promise((resolve, reject) => {
            const content = `${prompt}\n\n---\nDANH SÁCH CÂU HỎI:\n${domText}`;
            control.request = GM_xmlhttpRequest({
                method: 'POST',
                url: `${cfg.base}/chat/completions`,
                headers: {
                    Authorization: `Bearer ${apiKey}`,
                    'Content-Type': 'application/json',
                    'HTTP-Referer': location.origin,
                    'X-Title': 'DOM Vision Assistant'
                },
                data: JSON.stringify({
                    model,
                    messages: [{ role: 'user', content }],
                    temperature: 0.1,
                    max_tokens: 4096
                }),
                timeout: 90000,
                onload: response => {
                    let data = null;
                    try { data = JSON.parse(response.responseText); } catch (_) {}
                    if (response.status < 200 || response.status >= 300 || data?.error) {
                        reject(new Error(explainError(response.status, data, response.responseText, cfg)));
                        return;
                    }
                    const message = data?.choices?.[0]?.message;
                    let text = message?.content;
                    if (Array.isArray(text)) text = text.map(part => part?.text || '').join('');
                    text = String(text || '').replace(/<think>[\s\S]*?<\/think>/gi, '').trim();
                    if (!text) { reject(new Error('Model không trả về nội dung')); return; }
                    resolve(text);
                },
                onabort: () => reject(new Error('Đã dừng request')),
                onerror: () => reject(new Error(`Không kết nối được ${new URL(cfg.base).host}`)),
                ontimeout: () => reject(new Error('Timeout (90s)'))
            });
        });
    }

    // ============================================================
    // AUTO SUBMIT
    // ============================================================
    function findSubmitButton() {
        const exact = [...document.querySelectorAll('[role="button"]')].find(el => {
            const label = el.getAttribute('aria-label') || '';
            return label.trim() === 'Gửi' || label.trim() === 'Gửi';
        });
        if (exact) return exact;

        const buttons = [...document.querySelectorAll('[role="button"]')];
        return buttons.find(el => {
            const text = el.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
            return text === 'gửi' || text === 'gửi';
        }) || null;
    }

    async function autoSubmitForm(status, control) {
        if (control.stopped) return false;
        status.textContent = 'Đang tìm nút Gửi...';
        await new Promise(resolve => setTimeout(resolve, 700));
        if (control.stopped) return false;
        const submitButton = findSubmitButton();
        if (!submitButton) {
            status.textContent = 'Không tìm thấy nút Gửi.';
            return false;
        }
        submitButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
        await new Promise(resolve => setTimeout(resolve, 500));
        if (control.stopped) return false;
        status.textContent = 'Đang tự động nộp bài...';
        try {
            submitButton.click();
            await new Promise(resolve => setTimeout(resolve, 1000));
            status.textContent = 'Đã gửi biểu mẫu.';
            return true;
        } catch (error) {
            status.textContent = `Không thể nộp: ${error.message}`;
            return false;
        }
    }

